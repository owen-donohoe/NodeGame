.lb-stage { background-color: rgba(0, 0, 0, 0); }
.lb-stage .lb-page { background-color: rgba(0, 0, 0, 0); }
.lb-stage .lb-topbar, .lb-stage .lb-strip-wrap { background-color: rgba(18, 27, 34, 0.3); }
.lb-stage .lb-tab { position: relative; width: 48px; height: 48px; min-width: 48px; min-height: 48px; }
.lb-badge-dot { position: absolute; right: 3px; top: 3px; width: 9px; height: 9px; border-radius: 5px; background-color: rgb(214, 55, 62); }
