#page-social { flex-grow: 1; min-height: 0; }
#page-social > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-social-scroll { flex-grow: 1; background-color: rgba(235, 225, 205, 0.94); padding: 10px; }
.lb-social-title { font-size: 24px; margin-top: 18px; margin-bottom: 8px; white-space: normal; }
.lb-live-row, .lb-previous-row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.lb-social-player { flex-grow: 1; min-width: 0; padding: 4px; margin-bottom: 8px; }
.lb-live-row > .lb-social-player { flex-basis: 0; }
.lb-social-square > LobbyIcon { width: 22px; height: 22px; }
.lb-player-open { min-height: 80px; padding: 10px; align-items: flex-start; }
.lb-player-open Label { font-size: 13px; white-space: normal; }
.lb-presence { width: 10px; height: 10px; border-radius: 5px; margin-bottom: 4px; }
.lb-presence--online { background-color: rgb(62, 145, 90); }
.lb-presence--battle { background-color: rgb(200, 48, 48); }
.lb-presence--offline { background-color: rgb(125, 125, 125); }
.lb-social-red { background-color: rgb(185, 45, 45); color: white; min-height: 40px; }
.lb-social-square { width: 36px; height: 36px; min-width: 36px; align-items: center; justify-content: center; margin-left: 4px; margin-right: 4px; }
.lb-previous-row Label, .lb-previous-row Button { white-space: normal; }
.lb-public-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-public-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); }
.lb-public-safe { position: absolute; left: 8px; right: 8px; top: 16px; bottom: 16px; background-color: rgb(235, 225, 205); border-radius: 16px; padding: 12px; }
.lb-public-scroll { flex-grow: 1; min-height: 0; }
.lb-public-header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.lb-public-handle { flex-grow: 1; flex-shrink: 1; font-size: 24px; white-space: normal; }
.lb-public-stats { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lb-public-stat { width: 31%; margin: 1%; padding: 6px; background-color: rgba(80, 70, 55, 0.1); }
.lb-public-stat Label { white-space: normal; -unity-text-align: middle-center; }
.lb-public-chips { flex-direction: row; flex-wrap: wrap; }
.lb-public-chip { border-radius: 12px; padding: 8px; margin: 3px; background-color: rgba(80, 100, 120, 0.2); white-space: normal; }
.lb-public-recent { margin-bottom: 12px; padding: 8px; background-color: rgba(80, 70, 55, 0.08); }
.lb-public-recent Label { white-space: normal; }
