#page-social { flex-grow: 1; min-height: 0; }
#page-social > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-social-scroll { flex-grow: 1; background-color: var(--paper-dark); padding: 10px; }
.lb-social-title { font-size: 24px; margin-top: 12px; margin-bottom: 6px; white-space: normal; }
.lb-live-row, .lb-previous-row { flex-direction: row; align-items: center; margin-bottom: 8px; padding: 6px; --paper-card-fill: var(--paper-light); }
.lb-social-player { flex-grow: 1; min-width: 0; padding: 2px; margin-bottom: 6px; }
.lb-live-row > .lb-social-player { flex-basis: 0; }
.lb-social-square > LobbyIcon { width: 22px; height: 22px; }
.lb-player-open { min-height: 64px; padding: 8px 10px; align-items: flex-start; --paper-card-fill: var(--paper-light); }
.lb-player-open Label { font-size: 13px; white-space: normal; }
.lb-presence { width: 10px; height: 10px; border-radius: 5px; margin-bottom: 4px; }
.lb-presence--online { background-color: var(--confirm); }
.lb-presence--battle { background-color: var(--paper-urgent); }
.lb-presence--offline { background-color: var(--paper-dark); }
.lb-social-red { color: var(--ink-white); min-height: 48px; min-width: 48px; margin: 0 4px; padding: 0 12px; }
.lb-social-square { width: 36px; height: 36px; min-width: 36px; align-items: center; justify-content: center; margin-left: 4px; margin-right: 4px; }
.lb-previous-row Label, .lb-previous-row PaperButton { white-space: normal; }
.lb-public-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-public-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--scrim); }
.lb-public-safe { position: absolute; left: 8px; right: 8px; top: 16px; bottom: 16px; background-color: var(--paper-light); border-radius: 16px; padding: 12px; }
.lb-public-scroll { flex-grow: 1; min-height: 0; }
.lb-public-header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.lb-public-handle { flex-grow: 1; flex-shrink: 1; font-size: 24px; white-space: normal; }
.lb-public-stats { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lb-public-stat { width: 31%; margin: 1%; padding: 6px; background-color: var(--paper-dark); }
.lb-public-stat Label { white-space: normal; -unity-text-align: middle-center; }
.lb-public-chips { flex-direction: row; flex-wrap: wrap; }
.lb-public-chip { border-radius: 12px; padding: 8px; margin: 3px; background-color: var(--paper-dark); white-space: normal; }
.lb-public-recent { margin-bottom: 12px; padding: 8px; background-color: var(--paper-dark); }
.lb-public-recent Label { white-space: normal; }
