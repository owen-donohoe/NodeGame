<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
 <ui:Style src="HomePage.uss" />
 <ui:VisualElement name="home-page" class="g2-home" picking-mode="Ignore">
  <ui:VisualElement class="g2-home-toast-dock" picking-mode="Ignore"><ui:Label name="home-toast" class="ui-toast g2-home-toast" picking-mode="Ignore" /></ui:VisualElement>
  <ui:VisualElement class="g2-home-bottom" picking-mode="Ignore">
   <ui:VisualElement class="g2-crates" picking-mode="Ignore">
    <ui:Button name="home-crate-medium" class="ui-reset-button mk-crate" tooltip="Open Big crate">
     <lobby:LobbyIcon kind="CrateMedium" context="Home" class="g2-crate-icon" picking-mode="Ignore" />
     <ui:Label text="BIG" class="mk-caption g2-crate-label" picking-mode="Ignore" />
     <ui:Label name="home-crate-medium-count" text="0" class="mk-cbadge" style="display: none;" picking-mode="Ignore" />
    </ui:Button>
    <ui:Button name="home-crate-small" class="ui-reset-button mk-crate" tooltip="Open Small crate">
     <lobby:LobbyIcon kind="CrateSmall" context="Home" class="g2-crate-icon" picking-mode="Ignore" />
     <ui:Label text="SMALL" class="mk-caption g2-crate-label" picking-mode="Ignore" />
     <ui:Label name="home-crate-small-count" text="0" class="mk-cbadge" style="display: none;" picking-mode="Ignore" />
    </ui:Button>
   </ui:VisualElement>
   <ui:VisualElement class="g2-home-actions" picking-mode="Ignore">

    <ui:Button name="home-invite-teammate" class="ui-reset-button mk-btn g2-home-invite" style="display: none;">
     <lobby:LobbyIcon kind="Invite" context="Home" class="g2-mode-icon" picking-mode="Ignore" />
     <ui:Label text="Invite teammate" picking-mode="Ignore" />
    </ui:Button>
    <ui:Button name="home-mode" class="ui-reset-button mk-chip g2-home-mode">
     <ui:Label name="home-private-flag" text="PRIVATE" class="g2-private-flag" picking-mode="Ignore" />
     <ui:VisualElement name="home-mode-dot" class="g2-mode-dot" picking-mode="Ignore" />
     <lobby:LobbyIcon name="home-mode-icon" context="Home" class="g2-mode-icon" picking-mode="Ignore" />
     <ui:Label name="home-mode-name" picking-mode="Ignore" />
     <ui:VisualElement class="g2-swap-badge" picking-mode="Ignore">
      <lobby:LobbyIcon kind="Swap" context="Home" class="g2-swap" picking-mode="Ignore" />
     </ui:VisualElement>
    </ui:Button>
    <ui:Button name="home-battle" class="ui-reset-button mk-battle g2-battle">
    <ui:VisualElement class="g2-battle-progress" picking-mode="Ignore">
      <ui:VisualElement name="home-boxmeter" class="g2-battle-meter" picking-mode="Ignore">
       <ui:VisualElement name="home-boxmeter-fill" picking-mode="Ignore" />
      </ui:VisualElement>
      <lobby:LobbyIcon name="home-next-crate-icon" context="Home" class="g2-next-icon" picking-mode="Ignore" />
    </ui:VisualElement>
     <ui:Label text="BATTLE" class="g2-battle-label" picking-mode="Ignore" />
    </ui:Button>
   </ui:VisualElement>
  </ui:VisualElement>
 </ui:VisualElement>
</ui:UXML>
