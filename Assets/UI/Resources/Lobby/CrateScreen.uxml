<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="CrateScreen.uss" />
    <ui:Label name="crate-prompt" class="lb-crate-prompt" />
    <ui:VisualElement name="crate-content" class="lb-crate-content">
        <ui:VisualElement name="crate-box" class="lb-crate-box"><ui:Label text="Crate" /></ui:VisualElement>
        <ui:VisualElement name="crate-reward" class="lb-crate-reward">
            <ui:Label name="crate-reward-label" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:ScrollView name="crate-summary" class="lb-crate-summary" />
    <ui:Button name="crate-accept" text="Accept" class="lb-crate-accept" />
</ui:UXML>
