<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
    <ui:Style src="ModePicker.uss" />
    <ui:VisualElement class="lb-mode-picker">
        <ui:Label text="Choose a mode" class="lb-mode-heading" />
        <ui:ScrollView class="lb-mode-scroll">
            <ui:VisualElement name="mode-grid" class="lb-mode-grid" />
            <ui:VisualElement name="mode-local" class="lb-mode-local" />
        </ui:ScrollView>
        <ui:Toggle name="mode-private" text="Private (1v1)" class="lb-mode-private" />
    </ui:VisualElement>
<ui:Style src="PaperLobby.uss" /></ui:UXML>
