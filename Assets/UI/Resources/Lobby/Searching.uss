.g2-search { position: absolute; top: 0; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; }
.ui-root .g2-search-card { width: 260px; }
.ui-root .g2-search-card > Label { white-space: normal; -unity-text-align: middle-center; margin-bottom: 8px; }
.ui-root .g2-search-card > Button { margin-top: 8px; }
