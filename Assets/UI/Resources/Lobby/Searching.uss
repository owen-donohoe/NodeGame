.g2-search { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.ui-root .g2-search-content { position: absolute; top: 180px; bottom: 24px; left: 12px; right: 12px; align-items: center; }
.ui-root .g2-search-mode { align-self: stretch; height: 44px; min-height: 44px; flex-shrink: 0; margin: 0; white-space: nowrap; }
.ui-root .g2-search-board { align-self: stretch; flex-grow: 0; flex-shrink: 1; min-height: 0; }
.ui-root .g2-search-footer { width: 100%; max-width: 340px; flex-shrink: 0; align-items: stretch; }
.ui-root .g2-search-subtitle { font-size: 22px; -unity-font-definition: var(--font-display); color: var(--mk-ink); -unity-text-align: middle-center; min-height: 27px; white-space: nowrap; margin: 16px 0 0; }
.ui-root .g2-search-time { font-size: 14px; color: var(--mk-muted); -unity-text-align: middle-center; min-height: 20px; margin: 8px 0 0; }
.ui-root .g2-search-stats { flex-direction: row; justify-content: center; margin: 16px 0 0; }
.ui-root .g2-search-stat { min-width: 120px; min-height: 56px; padding: 4px 12px; margin: 0 6px; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px; background-color: var(--mk-card); }
.ui-root .g2-search-stat-label { font-size: 22px; -unity-font-definition: var(--font-display); color: var(--mk-ink); -unity-text-align: middle-center; flex-grow: 1; margin: 0; }
.ui-root .g2-search-message { font-size: 14px; color: var(--mk-ink); -unity-text-align: middle-center; white-space: normal; max-height: 40px; overflow: hidden; margin: 0 0 8px; }
.ui-root .g2-search-actions { position: relative; height: 56px; min-height: 56px; flex-shrink: 0; flex-direction: row; justify-content: center; margin: 24px 0 8px; }
.ui-root .g2-search-actions > .mk-btn { position: absolute; top: 0; bottom: 0; min-width: 0; min-height: 56px; margin: 0; overflow: hidden; background-color: var(--mk-tap); color: var(--mk-sheet); border-color: var(--line-inner); }
.ui-root #searching-cancel { min-height: 48px; height: 48px; flex-shrink: 0; margin: 0; }

.ui-root .g2-search-stat-caption { font-size: 12px; color: var(--mk-muted); -unity-text-align: middle-center; margin: 0; }
.ui-root .g2-search-stat .g2-search-era { font-size: 18px; }
.ui-root .g2-search-subtitle--error { color: var(--mk-urgent); }
.ui-root #searching-invite { left: 0; }
.ui-root #searching-offer { right: 0; }
