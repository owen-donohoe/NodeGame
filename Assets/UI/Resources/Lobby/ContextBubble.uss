.lb-context-bubble-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ui-root .lb-context-bubble { position: absolute; padding: 12px; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px; background-color: var(--mk-sheet); }
.ui-root .lb-context-bubble .mk-btn { min-height: 44px; margin: 4px 0; }
.ui-root .lb-context-bubble-tip { position: absolute; top: -10px; width: 16px; height: 16px; rotate: 45deg; background-color: var(--mk-sheet); border-top-width: 2px; border-left-width: 2px; border-color: var(--line-outer); }
.ui-root .lb-context-bubble-tip--below { top: auto; bottom: -10px; rotate: 225deg; }
