#lobby-chrome { flex-shrink: 0; }
.mk-trophy Label { color: var(--mk-trophy); }
.mk-namelink Label { color: var(--mk-ink); }
.ui-root .mk-cap { margin-top: 4px; }

.mk-profile-caret { width: 12px; height: 12px; background-image: url("Icons/Phosphor/caret-right-bold.svg"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mk-ink); }
.lb-root .mk-namelink { justify-content: flex-start; }
.lb-root .mk-namelink #name-text { flex-grow: 0; flex-basis: auto; font-size: var(--type-number); -unity-font-definition: var(--font-display); -unity-text-align: middle-left; margin: 0; padding: 0; }
.lb-root #trophy-strip .mk-trophy { margin-right: 0; }
.lb-root #trophy-strip .mk-trophy Label { -unity-font-definition: var(--font-display); font-size: var(--type-number); color: var(--mk-trophy); padding: 0; margin: 0; -unity-text-align: middle-right; }
.mk-purse__dot--coin { background-image: url("Icons/Phosphor/coins-bold.svg"); }
.mk-purse__dot--leaf { background-image: url("Icons/Phosphor/leaf-bold.svg"); }
.mk-purse__dot--coin, .mk-purse__dot--leaf { width: 20px; height: 20px; border-width: 0; background-color: var(--clear); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mk-sheet); }
