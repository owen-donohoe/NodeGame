<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
    <ui:Style src="PartyWait.uss" />
    <ui:VisualElement name="party-safe-area" class="lb-party-safe">
        <lobby:PaperCard class="lb-party-body" name="paper-lb-party-body-0">
            <ui:Label text="Waiting for your party" class="lb-party-title" />
            <ui:VisualElement class="lb-party-presence-row">
                <ui:VisualElement class="lb-party-presence" />
                <ui:Label name="party-invitee" enable-rich-text="false" />
            </ui:VisualElement>
            <ui:Label text="Guild online: —" />
            <ui:VisualElement name="party-slots" class="lb-party-slots" />
            <lobby:PaperButton name="party-invite" text="Invite" />
            <lobby:PaperButton name="party-random" text="Queue randomly" />
            <lobby:PaperButton name="party-cancel" text="Cancel" />
        </lobby:PaperCard>
    </ui:VisualElement>
<ui:Style src="PaperLobby.uss" /></ui:UXML>
