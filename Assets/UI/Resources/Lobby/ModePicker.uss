.g2-mode-grid { flex-direction: row; flex-wrap: wrap; margin-right: -8px; }
.ui-root .g2-mode-card { width: 46%; flex-shrink: 0; margin: 0 8px 8px 0; padding: 12px; min-height: 92px; align-items: center; overflow: hidden; }
.g2-mode-card > LobbyIcon { width: 28px; height: 28px; margin: 4px 0; }
.g2-mode-colour { position: absolute; top: 0; left: 0; right: 0; height: 6px; }
.ui-root .g2-mode-card--on { background-color: var(--mk-pressed); border-color: var(--mk-tap); }
.g2-private { min-height: 44px; flex-shrink: 0; margin-top: 8px; padding: 8px; background-color: var(--mk-sheet); border-top-width: 2px; border-top-color: var(--mk-ink); }
