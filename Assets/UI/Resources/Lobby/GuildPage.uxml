<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
    <ui:Style src="Guild.uss" />
    <ui:VisualElement name="guild-state" class="lb-guild-state" />
    <ui:VisualElement name="guild-visitor" class="lb-guild-visitor">
        <ui:VisualElement name="guild-search-anchor" class="lb-guild-search-anchor">
            <ui:Label text="GUILDS" class="mk-page-title lb-guild-title" />
            <ui:VisualElement class="lb-guild-search">
                <ui:VisualElement class="lb-guild-query-wrap">
                    <ui:TextField name="guild-query" class="lb-guild-query" tooltip="Press Enter to search" />
                    <lobby:LobbyIcon kind="Search" class="lb-guild-query-icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="guild-filter" class="mk-btn lb-guild-filterbtn" tooltip="Filter guilds" />
            </ui:VisualElement>
            <ui:Button name="guild-browse-toggle" class="ui-reset-button lb-guild-browse-toggle" tooltip="Browse public guilds">
                <ui:VisualElement class="lb-guild-expand-ink" style="translate: -1px 0;" picking-mode="Ignore" />
                <ui:VisualElement class="lb-guild-expand-ink" style="translate: 1px 0;" picking-mode="Ignore" />
                <ui:VisualElement class="lb-guild-expand-ink" style="translate: 0 -1px;" picking-mode="Ignore" />
                <ui:VisualElement class="lb-guild-expand-ink" style="translate: 0 1px;" picking-mode="Ignore" />
                <ui:VisualElement class="lb-guild-expand-face" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView name="guild-results-scroll" class="lb-guild-results" mode="Vertical" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="guild-search-results" class="mk-card mk-ledger lb-guild-card"><ui:Label text="Search results" class="mk-ledger__header" /></ui:VisualElement>
            <ui:VisualElement name="guild-browse-card" class="mk-card mk-ledger lb-guild-card">
                <ui:VisualElement class="mk-ledger__header lb-guild-line">
                    <ui:Label text="Public guilds" class="mk-eyebrow lb-guild-row-text" />
                    <ui:Button name="guild-refresh" class="mk-btn mk-btn--sm" text="Refresh" />
                </ui:VisualElement>
                <ui:VisualElement name="guild-browse-results" />
            </ui:VisualElement>
            <ui:VisualElement class="ui-lobby-list-end" picking-mode="Ignore" />
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="guild-home" class="lb-guild-home">
        <ui:VisualElement name="guild-home-header" />
        <ui:ScrollView name="guild-home-scroll" class="lb-guild-home-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" />
    </ui:VisualElement>
    <ui:Button name="guild-chat-button" text="Chat" class="mk-btn mk-btn--gold lb-guild-chat-button" />
</ui:UXML>
