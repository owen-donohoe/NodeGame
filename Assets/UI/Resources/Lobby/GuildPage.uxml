<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
    <ui:Style src="Guild.uss" />
    <lobby:PaperCard class="lb-page-paper" name="paper-GuildPage" rotate-paper="false"><ui:ScrollView class="lb-guild-scroll" mode="Vertical" vertical-scroller-visibility="Hidden">
        <ui:Label text="Guild" class="lb-guild-title" />
        <ui:VisualElement name="guild-state" />
    </ui:ScrollView></lobby:PaperCard>
    <ui:VisualElement name="guild-visitor">
        <ui:VisualElement class="lb-guild-search">
            <ui:TextField name="guild-query" tooltip="Guild name" />
            <lobby:PaperButton name="guild-search" class="lb-guild-searchbtn" tooltip="Search guilds" />
            <lobby:PaperButton name="guild-filter" class="lb-guild-filterbtn" tooltip="Filter guilds"><ui:Label text="Filter" /></lobby:PaperButton>
        </ui:VisualElement>
        <ui:VisualElement name="guild-search-results" />
        <ui:Foldout name="guild-browse" text="Browse public guilds" value="false">
            <lobby:PaperButton name="guild-refresh" text="Refresh" />
            <ui:VisualElement name="guild-browse-results" />
        </ui:Foldout>
    </ui:VisualElement>
<ui:Style src="PaperLobby.uss" /></ui:UXML>
