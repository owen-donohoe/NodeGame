.ui-root .lan-room-page { flex-shrink: 1; min-height: 0; }
.ui-root #lan-room-sheet .private-arena { flex-basis: 264px; flex-shrink: 1; min-height: 224px; margin-top: 16px; }
.ui-root #lan-room-sheet .mk-btn { min-height: 44px; margin-top: 8px; }
.ui-root #lan-room-sheet .private-face, .ui-root #lan-room-sheet .private-more { margin-top: 0; }
.ui-root .lan-address { font-size: 16px; min-height: 48px; margin: 8px 0; }
.ui-root #lan-room-sheet .mk-muted { min-height: 24px; margin-top: 8px; white-space: normal; }

.ui-root #lan-room-sheet .lan-choice { padding: 8px 0 12px; }
.ui-root #lan-room-sheet .lan-choice > .mk-btn { height: 56px; min-height: 56px; margin-top: 0; }
.ui-root #lan-room-sheet .lan-choice > .mk-btn:last-child { margin-top: 12px; }
.ui-root #lan-room-sheet .lan-address { height: 48px; min-height: 48px; }
.ui-root .lan-join-status { min-height: 24px; font-size: 13px; color: var(--mk-muted); margin: 8px 0 12px; }
.ui-root .lan-actions { flex-direction: row; margin: 0 -4px; flex-shrink: 0; }
.ui-root #lan-room-sheet .lan-actions > .mk-btn { flex-grow: 1; flex-basis: 0; margin: 0 4px; min-width: 0; height: 48px; }

.ui-root .lan-join { padding: 12px 0 16px; }
