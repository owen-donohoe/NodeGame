<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lobby="NodeWar.Lobby">
    <ui:Style src="Guild.uss" />
    <lobby:PaperCard name="guild-chat-safe" class="lb-guild-chat-safe">
        <lobby:PaperButton name="guild-chat-close" text="Back" />
        <ui:VisualElement name="guild-chat-header" />
        <ui:ScrollView name="guild-chat-list" class="lb-guild-chat-list" mode="Vertical" vertical-scroller-visibility="Hidden" />
        <ui:Label name="guild-chat-error" />
        <ui:VisualElement class="lb-guild-compose">
            <ui:TextField name="guild-chat-input" tooltip="Plain text and emoji, up to 200 characters" />
            <lobby:PaperButton name="guild-chat-send" text="Send" />
        </ui:VisualElement>
    </lobby:PaperCard>
<ui:Style src="PaperLobby.uss" /></ui:UXML>
