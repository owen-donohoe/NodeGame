.g2-home { flex-grow: 1; position: relative; }
.g2-home-bottom { position: absolute; bottom: 90px; left: 10px; right: 10px; flex-direction: row; justify-content: flex-end; align-items: flex-end; }
.g2-crates { flex-direction: row; margin-right: 8px; margin-bottom: 26px; }
.g2-crates > .mk-crate { margin-right: 8px; }
.g2-crates > #home-crate-small { margin-right: 0; }
.g2-crate-icon { width: 46px; height: 46px; }
.ui-root .g2-crate-label { position: absolute; bottom: 3px; font-size: 10px; letter-spacing: 0.6px; color: var(--mk-muted); }
.g2-home-actions { width: 200px; flex-shrink: 0; align-items: stretch; }
.ui-root .g2-home-mode { flex-direction: row; align-items: center; justify-content: center; background-color: var(--mk-sheet); margin-bottom: 8px; padding: 4px 8px; }
.ui-root .g2-home-mode Label { font-size: 12px; margin-right: 5px; }
.g2-mode-icon { width: 20px; height: 20px; margin-right: 5px; }
.g2-mode-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 5px; background-color: var(--mk-action); }
.g2-swap { width: 16px; height: 16px; }
.ui-root .g2-fill-tag { background-color: var(--mk-sheet); margin-bottom: 6px; }
.g2-next-crate { flex-direction: row; align-items: center; height: 26px; }
.g2-next-crate > .mk-meter { flex-grow: 1; background-color: var(--mk-ink); }
.g2-next-crate #home-boxmeter-fill { background-color: var(--ink-white); }
.g2-next-icon { width: 24px; height: 24px; margin-left: 6px; }
