.g2-home { flex-grow: 1; position: relative; }
.g2-home-bottom { position: absolute; bottom: 90px; left: 12px; right: 12px; flex-direction: row; justify-content: flex-end; align-items: flex-end; }
.g2-crates { flex-direction: row; margin-right: 8px; margin-bottom: 24px; }
.g2-crates > .mk-crate { margin-right: 8px; }
.g2-crates > #home-crate-small { margin-right: 0; }
.g2-crate-icon { position: absolute; top: 4px; width: 40px; height: 40px; }
.ui-root .g2-crate-label { position: absolute; bottom: 4px; letter-spacing: 0.6px; color: var(--mk-muted); }
.g2-home-actions { width: 200px; flex-shrink: 1; min-width: 0; align-items: stretch; }
.ui-root .g2-home-mode { position: relative; width: 85%; height: 44px; min-height: 44px; flex-shrink: 0; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-outer); border-radius: 12px; align-self: flex-end; flex-direction: row; align-items: center; justify-content: center; background-color: var(--mk-sheet); margin-bottom: 8px; padding: 4px 8px; }
.ui-root .g2-home-mode Label { flex-grow: 1; flex-basis: 0; min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-right: 4px; }
.g2-mode-icon { width: 16px; height: 16px; margin-right: 4px; }
.g2-mode-dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 4px; background-color: var(--mk-action); }
.g2-swap-badge { position: absolute; top: -6px; right: -6px; width: 24px; height: 24px; border-radius: 12px; border-width: 2px; border-color: var(--line-outer); background-color: var(--mk-urgent); align-items: center; justify-content: center; }
.ui-root .g2-home-mode .g2-swap { width: 14px; height: 14px; -unity-background-image-tint-color: white; }
.ui-root .ui-toast.g2-home-toast { position: absolute; left: 0; right: 0; bottom: 100%; margin: 0 0 12px 0; max-width: none; padding: 8px 12px; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-outer); border-radius: 12px; background-color: var(--mk-sheet); color: var(--mk-ink); -unity-font-definition: var(--font-display); font-size: 16px; }
.ui-root .mk-battle.g2-battle { padding: 8px 12px 20px 12px; }
.g2-battle-progress { position: absolute; left: 12px; right: 12px; bottom: 6px; height: 16px; flex-direction: row; align-items: center; }
.g2-battle-meter { flex-grow: 1; height: 6px; border-radius: 3px; overflow: hidden; background-color: rgba(45, 35, 25, 0.28); }
.g2-battle-meter > * { height: 100%; border-radius: 3px; background-color: var(--mk-ink); }
.ui-root .g2-battle-progress .g2-next-icon { width: 16px; height: 16px; margin-left: 8px; -unity-background-image-tint-color: var(--mk-ink); }
