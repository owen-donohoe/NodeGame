.lb-market-page { flex-grow: 1; }
.lb-market-page > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-market-scroll { flex-grow: 1; background-color: rgba(38, 70, 78, 0.8); }
.lb-market-land { position: absolute; left: 0; top: 0; bottom: 0; width: 52px; background-color: rgb(120, 135, 90); }
.lb-market-stall { min-height: 340px; padding: 20px; padding-left: 64px; border-bottom-width: 2px; border-bottom-color: rgba(230, 220, 180, 0.4); }
.lb-marketeer { position: absolute; left: 8px; top: 28px; width: 34px; height: 50px; border-radius: 16px; background-color: rgb(160, 120, 72); color: white; -unity-text-align: middle-center; }
.lb-market-title { font-size: 24px; color: white; white-space: normal; }
.lb-market-countdown { color: rgb(220, 220, 195); margin-bottom: 16px; }
.lb-market-offers { flex-direction: row; flex-wrap: wrap; transform-origin: 50% 50%; }
.lb-market-tile { width: 31%; min-width: 0; min-height: 132px; margin: 1%; padding: 6px; align-items: center; justify-content: center; background-color: rgb(225, 210, 174); border-radius: 12px; }
.lb-market-tile Label { font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.lb-market-icon { width: 40px; height: 40px; margin-bottom: 8px; }
