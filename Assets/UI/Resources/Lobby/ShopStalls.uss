.lb-market-page { flex-grow: 1; background-color: var(--clear); overflow: hidden; }
.lb-market-page > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-market-projections { flex-grow: 1; }
.lb-market-stall { position: absolute; width: 190px; transform-origin: 0 0; }
.lb-market-title { font-size: 22px; color: var(--ink); white-space: normal; }
.lb-market-countdown { color: var(--ink-mute); margin-bottom: 12px; font-size: 12px; }
.lb-market-offers { flex-direction: row; flex-wrap: wrap; }
.lb-market-tile { width: 30%; min-width: 0; min-height: 98px; margin: 1%; padding: 4px; align-items: center; justify-content: center; background-color: var(--surface-raised); border-radius: var(--corner-md); }
.lb-market-tile Label { font-size: 11px; white-space: normal; -unity-text-align: middle-center; }
.lb-market-icon { width: 46px; height: 46px; margin-bottom: 4px; }
