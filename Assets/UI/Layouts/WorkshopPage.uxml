<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        Workshop - the loadout picker. Replaces GroupSelectionPanel.

        Fixed top, scrolling bottom: the loadout card and the tabs stay put
        while the list of available items scrolls under them, so the slots a
        player is filling never leave the screen.

        Only the frame is here. Slots are built in C# from LoadoutData.SuitSlots
        and NodeSlots, and rows from the definition assets, because neither
        count is knowable at authoring time.

        Two ScrollViews rather than one shared list: each tab then keeps its own
        scroll offset for free. GroupSelectionPanel does that by hand, saving
        verticalNormalizedPosition per tab and restoring it a frame later.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Workshop.uss" />

    <engine:VisualElement name="workshop-page" class="workshop">

        <engine:VisualElement name="workshop-loadout" class="card workshop__loadout">

            <!--
                Suits every player is granted regardless of loadout, shown
                outside the slots because they cost none. Driven by
                SuitDefinition.isGlobal; hidden entirely when no suit sets it.
            -->
            <engine:VisualElement name="workshop-granted" class="workshop__granted">
                <engine:VisualElement name="workshop-granted-tiles" class="workshop__granted-tiles" />
                <engine:VisualElement class="workshop__granted-text">
                    <engine:Label name="workshop-granted-names" class="body" text="Warrior" />
                    <engine:Label class="caption"
                                  text="Always granted - costs no slot" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="workshop-suits-group" class="workshop__group">
                <engine:Label name="workshop-suits-label" class="caption" text="Suits" />
                <engine:VisualElement name="workshop-suit-slots" class="workshop__slots" />
            </engine:VisualElement>

            <engine:VisualElement name="workshop-nodes-group" class="workshop__group">
                <engine:Label name="workshop-nodes-label" class="caption" text="Districts" />
                <engine:VisualElement name="workshop-node-slots" class="workshop__slots" />
            </engine:VisualElement>

        </engine:VisualElement>

        <engine:VisualElement name="workshop-tabs" class="workshop__tabs">
            <engine:Button name="workshop-tab-suits" class="btn btn--ghost workshop__tab" text="Suits" />
            <engine:Button name="workshop-tab-nodes" class="btn btn--ghost workshop__tab" text="Districts" />
        </engine:VisualElement>

        <!--
            Shown only when every slot on the active tab is taken. Without it a
            tap on a row would do nothing and say nothing, which is what
            GroupSelectionPanel does today.
        -->
        <engine:Label name="workshop-hint" class="caption workshop__hint"
                      text="Slots full - tap a slot above to free one" />

        <engine:ScrollView name="workshop-list-suits" class="workshop__list" />
        <engine:ScrollView name="workshop-list-nodes" class="workshop__list" />

    </engine:VisualElement>

</engine:UXML>
