<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xmlns:lobby="NodeWar.Lobby"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        Workshop, after lobby-prototype.html, with server inventory choices.

        Top to bottom:
          - a segmented pill: Districts | Suits
          - the loadout slots for the chosen side, and "Ready" once they are full
          - inspected item details, era chips and optional skin chips
          - a three-across grid of cards, scrolling under everything above it
          - a floating round button bottom-right that unfurls the same choice
            upward, drawn over the cards with a veil behind

        Two switchers, one state. WorkshopPage.SetTab owns which side is shown;
        both controls call it and it re-syncs both, so they cannot drift.

        Slots and cards are built in code: the slot counts come from
        LoadoutData, and the cards from the definition assets.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Workshop.uss" />
    <engine:Style src="project://database/Assets/UI/Styles/SuitTree.uss" />

    <engine:VisualElement name="workshop-page" class="lb-workshop" picking-mode="Ignore">

        <engine:VisualElement class="lb-wsbar" picking-mode="Ignore">
            <engine:VisualElement class="lb-wsseg" picking-mode="Ignore">
                <engine:Button name="workshop-seg-districts" class="ui-reset-button lb-wsseg__btn">
                    <lobby:LobbyIcon kind="District" class="lb-icon" picking-mode="Ignore" />
                    <engine:Label class="lb-wsseg__text ui-w600" text="Districts" picking-mode="Ignore" />
                </engine:Button>
                <engine:Button name="workshop-seg-suits" class="ui-reset-button lb-wsseg__btn lb-wsseg__btn--last">
                    <lobby:LobbyIcon kind="Suit" class="lb-icon" picking-mode="Ignore" />
                    <engine:Label class="lb-wsseg__text ui-w600" text="Suits" picking-mode="Ignore" />
                </engine:Button>
            </engine:VisualElement>
            <!-- Suits side only: opens the suit tree overlay below. WorkshopPage shows and hides it. -->
            <engine:Button name="workshop-tree-open" class="ui-reset-button st-open ui-w600" text="Suit tree: variants and unlocks" />
        </engine:VisualElement>

        <engine:VisualElement name="workshop-slotwrap" class="lb-slotwrap" picking-mode="Ignore">
            <engine:VisualElement name="workshop-slots" class="lb-slots" picking-mode="Ignore" />
            <engine:Label class="lb-readytag ui-w600" text="Ready" picking-mode="Ignore" />
        </engine:VisualElement>

        <engine:VisualElement class="lb-workshop-details" picking-mode="Ignore">
            <engine:Label name="workshop-details" class="lb-workshop-details__text" picking-mode="Ignore" />
            <engine:ScrollView name="workshop-era-row" class="lb-era-row" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
            <engine:ScrollView name="workshop-skin-row" class="lb-era-row" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
            <engine:Label name="workshop-era-message" class="lb-era-message" picking-mode="Ignore" />
        </engine:VisualElement>

        <engine:ScrollView name="workshop-grid" class="lb-grid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />

        <engine:VisualElement name="workshop-veil" class="lb-pickveil" />

        <engine:VisualElement name="workshop-picker" class="lb-picker" picking-mode="Ignore">
            <engine:VisualElement class="lb-pickbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="ui-lip__block lb-pick-lip" picking-mode="Ignore" />
                <engine:Button name="workshop-pickbtn" class="ui-reset-button lb-pickbtn">
                    <lobby:LobbyIcon name="workshop-pick-icon" kind="District" class="lb-icon" picking-mode="Ignore" />
                    <engine:Label name="workshop-pick-label" class="lb-pickbtn__label ui-w600" text="DIST" picking-mode="Ignore" />
                </engine:Button>
            </engine:VisualElement>
            <engine:VisualElement name="workshop-pickopts" class="lb-pickopts" picking-mode="Ignore">
                <engine:VisualElement class="lb-pickopt-wrap" picking-mode="Ignore">
                    <engine:VisualElement class="ui-lip__block lb-pick-lip" picking-mode="Ignore" />
                    <engine:Button name="workshop-pick-districts" class="ui-reset-button lb-pickopt">
                        <lobby:LobbyIcon kind="District" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label class="lb-pickopt__text ui-w600" text="Districts" picking-mode="Ignore" />
                    </engine:Button>
                </engine:VisualElement>
                <engine:VisualElement class="lb-pickopt-wrap" picking-mode="Ignore">
                    <engine:VisualElement class="ui-lip__block lb-pick-lip" picking-mode="Ignore" />
                    <engine:Button name="workshop-pick-suits" class="ui-reset-button lb-pickopt">
                        <lobby:LobbyIcon kind="Suit" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label class="lb-pickopt__text ui-w600" text="Suits" picking-mode="Ignore" />
                    </engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!--
            The suit tree (docs/suit-tree-spec.md section 6): a full overlay on the
            Workshop, opened from #workshop-tree-open. SuitTreeView builds the tabs,
            strip and tree into the empty hosts. #suittree-info is the info panel's
            content; WorkshopPage lifts it into the lobby's bottom sheet, the same
            way ShopPage lifts #shop-item.
        -->
        <engine:VisualElement name="suittree-page" class="st-page" picking-mode="Position">
            <engine:VisualElement class="st-header" picking-mode="Ignore">
                <engine:Button name="suittree-back" class="ui-reset-button lb-back">
                    <lobby:LobbyIcon kind="Back" class="lb-icon" picking-mode="Ignore" />
                </engine:Button>
                <engine:Label class="st-title ui-w600" text="Suit tree" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:ScrollView name="suittree-tabs" class="st-row st-tabs" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
            <engine:ScrollView name="suittree-strip" class="st-row st-strip" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
            <engine:ScrollView name="suittree-scroll" class="st-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <engine:VisualElement name="suittree-canvas" class="st-canvas" picking-mode="Ignore" />
            </engine:ScrollView>
        </engine:VisualElement>

        <engine:VisualElement name="suittree-info" picking-mode="Ignore">
            <engine:Label name="suittree-info-title" class="ui-sheet__title st-info__title ui-w600" text="" />
            <engine:Label name="suittree-info-role" class="ui-sheet__note st-info__role ui-w500" text="" />
            <engine:VisualElement name="suittree-info-stats" class="st-stats" picking-mode="Ignore" />
            <engine:Label name="suittree-info-fits" class="st-fact ui-w500" text="" />
            <engine:Label name="suittree-info-how" class="st-fact ui-w500" text="" />
            <engine:VisualElement class="ui-lip ui-button-wrap" picking-mode="Ignore">
                <engine:VisualElement class="ui-lip__block ui-lip__block--green" picking-mode="Ignore" />
                <engine:Button name="suittree-info-primary" class="ui-reset-button ui-button ui-button--green ui-w700" text="Equip" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>

</engine:UXML>
