<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements">
    <engine:Style src="project://database/Assets/UI/Styles/Workshop.uss" />
    <!-- LobbyChrome owns the username and trophies outside this page. -->
    <engine:VisualElement name="workshop-page" class="lb-workshop" picking-mode="Ignore">
        <engine:Label text="Districts" class="ws-heading ui-w600" picking-mode="Ignore" />
        <engine:VisualElement name="workshop-district-slots" class="ws-slots" picking-mode="Ignore" />
        <engine:Label text="Suits" class="ws-heading ui-w600" picking-mode="Ignore" />
        <engine:VisualElement name="workshop-suit-slots" class="ws-slots" picking-mode="Ignore" />
        <engine:VisualElement name="workshop-lower-frame" class="ws-lower" picking-mode="Ignore">
            <engine:VisualElement name="workshop-info" class="ws-info" picking-mode="Ignore">
                <engine:ScrollView class="ws-info-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <engine:VisualElement name="workshop-info-preview" class="ws-preview" picking-mode="Ignore" />
                    <engine:Label name="workshop-info-title" class="ws-title ui-w600" picking-mode="Ignore" />
                    <engine:VisualElement name="workshop-info-stats" picking-mode="Ignore" />
                    <engine:Label name="workshop-info-description" class="ws-fact" picking-mode="Ignore" />
                    <engine:Label name="workshop-info-unlock" class="ws-fact" picking-mode="Ignore" />
                    <engine:Label name="workshop-era-message" class="ws-fact" picking-mode="Ignore" />
                </engine:ScrollView>
                <engine:Button name="workshop-info-use" text="Use" class="ui-reset-button ws-primary ui-w600" />
                <engine:VisualElement class="ws-actions" picking-mode="Ignore">
                    <engine:Button name="workshop-open-variants" text="Variants" class="ui-reset-button ws-secondary" />
                    <engine:Button name="workshop-open-skins" text="Skins" class="ui-reset-button ws-secondary" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement class="ws-browser" picking-mode="Ignore">
                <engine:VisualElement class="ws-tabs" picking-mode="Ignore">
                    <engine:Button name="workshop-tab-districts" text="Districts" class="ui-reset-button ws-tab" />
                    <engine:Button name="workshop-tab-suits" text="Suits" class="ui-reset-button ws-tab" />
                </engine:VisualElement>
                <engine:ScrollView name="workshop-grid" class="ws-grid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <engine:Label text="Unlocked" class="ws-heading ui-w600" picking-mode="Ignore" />
                    <engine:VisualElement name="workshop-unlocked" class="ws-cards" picking-mode="Ignore" />
                    <engine:Label text="Not unlocked" class="ws-heading ui-w600" picking-mode="Ignore" />
                    <engine:VisualElement name="workshop-not-unlocked" class="ws-cards" picking-mode="Ignore" />
                </engine:ScrollView>
            </engine:VisualElement>
            <engine:VisualElement name="workshop-panel-host" class="ws-panel-host" picking-mode="Ignore" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
