<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" xmlns:lobby="NodeWar.Lobby" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        The lobby shell, after lobby-prototype.html.

        Draw order is hierarchy order, so the layers are listed back to front:

          #lobby-root
            #backdrop        stand-in scenery (the prototype fakes it too)
            #safe-area       SafeAreaBinder writes padding here
              #top-bar         purses, match history, gear   PERSISTENT
              #strip-wrap      name, trophies, bar           PERSISTENT
              #page-host       the page track - slides between tabs
              #tabbar-dock     floating capsule              PERSISTENT
            #overlay-host    Profile (expands from the strip), then the push
                             pages (Settings, Match history) - filled in code
            #sheet-layer     one shared bottom sheet; pages hand it content
            #menu-layer      the long-press context menu
            #toast-dock      above everything, so a toast reads over a sheet

        The chrome is a sibling of #page-host, never a child of a page. That is
        why it does not move when the track slides, and why the trophy bar is
        one element bound once.

        Five tabs. Profile is reached from the player name, not a tab.

        Tokens and shared components arrive through the panel theme
        (UnityDefaultRuntimeTheme.tss); only the lobby's own sheet is imported here.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Lobby.uss" />

    <engine:VisualElement name="lobby-root" class="ui-root lb-root">

        <lobby:LobbyBackdrop name="backdrop" class="lb-backdrop" picking-mode="Ignore">
            <engine:VisualElement class="lb-ground-edge" picking-mode="Ignore" />
            <engine:VisualElement name="prop-a" class="lb-prop" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <engine:VisualElement class="lb-prop__body" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:VisualElement name="prop-b" class="lb-prop" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <engine:VisualElement class="lb-prop__body" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:VisualElement name="prop-c" class="lb-prop" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <engine:VisualElement class="lb-prop__body" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:VisualElement name="prop-d" class="lb-prop" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <engine:VisualElement class="lb-prop__body" picking-mode="Ignore" />
            </engine:VisualElement>
        </lobby:LobbyBackdrop>

        <engine:VisualElement name="safe-area" class="lb-safe-area" picking-mode="Ignore">


    <engine:VisualElement name="top-bar" class="mk-topbar" picking-mode="Ignore">
        <engine:Button name="purse-coin" class="ui-reset-button mk-purse" tooltip="Buy Coins">
            <engine:VisualElement class="mk-purse__dot--coin" picking-mode="Ignore" />
            <engine:Label name="purse-coin-value" text="—" picking-mode="Ignore" />
            <engine:Label text="+" picking-mode="Ignore" />
        </engine:Button>
        <engine:Button name="purse-leaf" class="ui-reset-button mk-purse" tooltip="Buy Laurels">
            <engine:VisualElement class="mk-purse__dot--leaf" picking-mode="Ignore" />
            <engine:Label name="purse-premium-name" style="display: none;" picking-mode="Ignore" />
            <engine:Label name="purse-leaf-value" text="—" picking-mode="Ignore" />
            <engine:Label text="+" picking-mode="Ignore" />
        </engine:Button>
        <engine:VisualElement style="flex-grow: 1; margin-right: 0;" picking-mode="Ignore" />
        <engine:Button name="gear" class="ui-reset-button mk-rbtn" tooltip="Menu">
            <lobby:LobbyIcon kind="Gear" context="TopBar" picking-mode="Ignore" />
        </engine:Button>
        <engine:Button name="history" class="ui-reset-button mk-rbtn" tooltip="Notifications" style="margin-right: 0;">
            <lobby:LobbyIcon kind="Bell" context="TopBar" picking-mode="Ignore" />
        </engine:Button>
    </engine:VisualElement>
    <engine:VisualElement name="strip-wrap" class="mk-strip">
        <engine:VisualElement name="trophy-strip" picking-mode="Ignore">
            <engine:VisualElement class="mk-row" picking-mode="Ignore">
                <engine:Button name="name-button" class="ui-reset-button mk-namelink" tooltip="Profile">
                    <engine:Label name="name-text" text="player" enable-rich-text="false" picking-mode="Ignore" />
                    <engine:Label text="›" picking-mode="Ignore" />
                </engine:Button>
                <engine:VisualElement class="mk-trophy" picking-mode="Ignore">
                    <engine:Label name="trophy-count" text="—" picking-mode="Ignore" />
                    <engine:Label name="trophy-max" picking-mode="Ignore" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement class="mk-meter" picking-mode="Ignore">
                <engine:VisualElement name="trophy-fill" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:Label name="arena-text" text="Era —" class="mk-cap" picking-mode="Ignore" />
        </engine:VisualElement>
    </engine:VisualElement>


            <engine:VisualElement name="page-host" class="lb-page-host" picking-mode="Ignore" />

            <engine:VisualElement name="tabbar-dock" class="lb-tabbar-dock" picking-mode="Ignore">
                <engine:VisualElement name="tabbar" class="mk-tabs">
                    <engine:Button name="nav-shop" class="ui-reset-button mk-tab" tooltip="Shop">
                        <lobby:LobbyIcon context="NavBar" kind="NavBarShop" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label text="SHOP" class="mk-tab-label" picking-mode="Ignore" />
                    </engine:Button>
                    <engine:Button name="nav-workshop" class="ui-reset-button mk-tab" tooltip="Loadout">
                        <lobby:LobbyIcon context="NavBar" kind="Tools" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label text="LOADOUT" class="mk-tab-label" picking-mode="Ignore" />
                    </engine:Button>
                    <engine:Button name="nav-home" class="ui-reset-button mk-tab" tooltip="Home">
                        <lobby:LobbyIcon context="NavBar" kind="NavBarHome" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label text="HOME" class="mk-tab-label" picking-mode="Ignore" />
                    </engine:Button>
                    <engine:Button name="nav-social" class="ui-reset-button mk-tab" tooltip="Social">
                        <lobby:LobbyIcon context="NavBar" kind="NavBarSocial" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label text="SOCIAL" class="mk-tab-label" picking-mode="Ignore" />
                    </engine:Button>
                    <engine:Button name="nav-guild" class="ui-reset-button mk-tab mk-tab--last" tooltip="Guild">
                        <lobby:LobbyIcon context="NavBar" kind="Guild" class="lb-icon" picking-mode="Ignore" />
                        <engine:Label text="GUILD" class="mk-tab-label" picking-mode="Ignore" />
                    </engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="overlay-host" class="lb-sheet-layer" picking-mode="Ignore" />

        <engine:VisualElement name="sheet-layer" class="lb-sheet-layer" picking-mode="Ignore" />
        <engine:VisualElement name="menu-layer" class="lb-menu-layer" picking-mode="Ignore" />

        <engine:VisualElement name="toast-dock" class="lb-toast-dock" picking-mode="Ignore">
            <engine:Label name="toast" class="ui-toast ui-w500" text="" picking-mode="Ignore" />
        </engine:VisualElement>

    </engine:VisualElement></engine:UXML>
