<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        The in-match HUD, after ingame-prototype.html - an estimate of the
        look, corrected wherever it disagreed with the game.

        WHAT IS ALWAYS VISIBLE, AND WHY. Settled 2026-09-02: both breach walls
        and the three resources never hide, and the villager count collapses
        behind a tap. Breach is the win condition - a player who cannot see how
        close either side is to losing cannot play - so it is at the top, it is
        first, and it has no collapsed state.

        PICKING MODE IS LOAD-BEARING. Every container here is picking-mode
        Ignore. A runtime panel that picks over its whole area swallows every
        tap before the board sees it, and the board is the game. The units
        toggle is the only thing on this surface you can press; the node sheet,
        added by the controller, is the only other control.

        YOUR SIDE IS ON THE LEFT. The left wall is the controlled player's,
        tagged YOU, and the right is the opponent's. Each carries its player
        mark, so which player is which never rides on position or colour.

        READ-ONLY. This surface reads SimulationState and writes nothing.

        Tokens and shared components arrive through the panel theme; only the
        HUD's own sheet is imported here.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/HUD.uss" />

    <engine:VisualElement name="hud-root" class="ui-root hud" picking-mode="Ignore">
        <engine:VisualElement name="hud-safe-area" class="hud__safe" picking-mode="Ignore">

            <!-- Breach walls either side of the match clock. -->
            <engine:VisualElement class="hud__topbar" picking-mode="Ignore">

                <engine:VisualElement name="hud-side-you" class="hud__side hud__side--you" picking-mode="Ignore">
                    <engine:VisualElement class="hud__side-row" picking-mode="Ignore">
                        <engine:VisualElement name="hud-mark-you" class="ui-mark ui-mark--p0" picking-mode="Ignore">
                            <engine:Label name="hud-mark-you-label" class="ui-mark__label" text="1" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label class="hud__you ui-w700" text="YOU" picking-mode="Ignore" />
                        <engine:Label name="hud-breach-count-you" class="hud__breach-count ui-w600" text="0/3" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement class="hud__wall" picking-mode="Ignore">
                        <engine:VisualElement name="hud-ghost-you" class="hud__wall-ghost" picking-mode="Ignore" />
                        <engine:VisualElement name="hud-fill-you" class="hud__wall-fill" picking-mode="Ignore" />
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement class="hud__clock" picking-mode="Ignore">
                    <engine:Label name="hud-clock" class="hud__clock-time ui-w600" text="0:00" picking-mode="Ignore" />
                    <engine:Label class="hud__clock-label ui-w600" text="MATCH" picking-mode="Ignore" />
                </engine:VisualElement>

                <engine:VisualElement name="hud-side-them" class="hud__side hud__side--them" picking-mode="Ignore">
                    <engine:VisualElement class="hud__side-row" picking-mode="Ignore">
                        <engine:VisualElement name="hud-mark-them" class="ui-mark ui-mark--p1" picking-mode="Ignore">
                            <engine:Label name="hud-mark-them-label" class="ui-mark__label" text="2" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label name="hud-breach-count-them" class="hud__breach-count ui-w600" text="0/3" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement class="hud__wall" picking-mode="Ignore">
                        <engine:VisualElement name="hud-ghost-them" class="hud__wall-ghost" picking-mode="Ignore" />
                        <engine:VisualElement name="hud-fill-them" class="hud__wall-fill" picking-mode="Ignore" />
                    </engine:VisualElement>
                </engine:VisualElement>

            </engine:VisualElement>

            <!--
                Resources. The prototype's locked readout: five past samples
                and the current value, which is wider. The bars are built in
                code; the number beside each label is the non-colour channel.
            -->
            <engine:VisualElement class="hud__resources" picking-mode="Ignore">
                <engine:VisualElement name="hud-res-food" class="hud__res" picking-mode="Ignore">
                    <engine:VisualElement class="hud__res-head" picking-mode="Ignore">
                        <engine:Label class="hud__res-label ui-w600" text="FOOD" picking-mode="Ignore" />
                        <engine:Label name="hud-food" class="hud__res-value ui-w600" text="0" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement name="hud-hist-food" class="hud__hist" picking-mode="Ignore" />
                </engine:VisualElement>
                <engine:VisualElement name="hud-res-materials" class="hud__res" picking-mode="Ignore">
                    <engine:VisualElement class="hud__res-head" picking-mode="Ignore">
                        <engine:Label class="hud__res-label ui-w600" text="MAT" picking-mode="Ignore" />
                        <engine:Label name="hud-materials" class="hud__res-value ui-w600" text="0" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement name="hud-hist-materials" class="hud__hist" picking-mode="Ignore" />
                </engine:VisualElement>
                <engine:VisualElement name="hud-res-metal" class="hud__res hud__res--last" picking-mode="Ignore">
                    <engine:VisualElement class="hud__res-head" picking-mode="Ignore">
                        <engine:Label class="hud__res-label ui-w600" text="METAL" picking-mode="Ignore" />
                        <engine:Label name="hud-metal" class="hud__res-value ui-w600" text="0" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement name="hud-hist-metal" class="hud__hist" picking-mode="Ignore" />
                </engine:VisualElement>
            </engine:VisualElement>

            <!--
                Units. Collapsed, the button's label IS your count - a tap
                reveals both sides, it does not hide the one number worth
                having. "Units", not "alive": the count includes the dead,
                who come back, and excludes the consumed, who do not.
            -->
            <engine:VisualElement class="hud__units-row" picking-mode="Ignore">
                <engine:Button name="hud-villager-toggle" class="ui-reset-button hud__units" text="3 units" />
                <engine:VisualElement name="hud-villagers" class="hud__units-card" picking-mode="Ignore">
                    <engine:VisualElement class="hud__units-line" picking-mode="Ignore">
                        <engine:VisualElement class="ui-mark ui-mark--p0" picking-mode="Ignore">
                            <engine:Label class="ui-mark__label" text="1" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label name="hud-villagers-p0" class="hud__units-count ui-w600" text="0 / 25" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement class="hud__units-line" picking-mode="Ignore">
                        <engine:VisualElement class="ui-mark ui-mark--p1" picking-mode="Ignore">
                            <engine:Label class="ui-mark__label" text="2" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label name="hud-villagers-p1" class="hud__units-count ui-w600" text="0 / 25" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:Label class="hud__units-note" text="A villager that breaches is spent for good." picking-mode="Ignore" />
                </engine:VisualElement>
            </engine:VisualElement>

            <!-- Everything below here is board. Nothing may cover it. -->
            <engine:VisualElement class="hud__board-space" picking-mode="Ignore" />

        </engine:VisualElement>

        <!--
            With villagers selected, the next node tap is a move order. The
            chip says that mode is armed. Not a control: the order is given on
            the board, never from a panel.
        -->
        <engine:VisualElement name="hud-selection" class="hud__selection-dock" picking-mode="Ignore">
            <engine:VisualElement class="ui-chip ui-chip--action hud__selection" picking-mode="Ignore">
                <engine:Label name="hud-selection-text" class="ui-chip__text ui-w600" text="Tap a node to move · 0" picking-mode="Ignore" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!--
            Zoom readout. Feedback, not a control: it answers "am I in zoom
            mode" while a pinch or a handle drag is running and then leaves.
            Never picks, so it cannot swallow a tap meant for the board.
        -->
        <engine:VisualElement name="hud-zoom" class="hud__zoom" picking-mode="Ignore">
            <engine:Label name="hud-zoom-value" class="hud__zoom-value ui-w600" text="1.0x" picking-mode="Ignore" />
            <engine:VisualElement name="hud-zoom-track" class="hud__zoom-track" picking-mode="Ignore">
                <engine:VisualElement name="hud-zoom-fill" class="hud__zoom-fill" picking-mode="Ignore" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!--
            The zoom handle: the only camera control on the surface, and the
            only place the HUD takes a touch besides the villager toggle.
            Click recentres on your core; a vertical drag zooms, up for in.

            Permanent. A control that appears only once you have moved is
            missing exactly when you want to look around at the start of a
            match, and a circle carries the two inputs without costing the
            board a strip of pannable area.
        -->
        <engine:VisualElement name="hud-recentre-dock" class="hud__recentre-dock" picking-mode="Ignore">
            <!--
                A plain element, deliberately NOT a Button. Button carries a
                Clickable manipulator that captures the pointer on press and
                releases it again as soon as the finger leaves the element's
                bounds - which a zoom drag does within a few pixels, since the
                throw is far longer than the 46px circle. That release ends the
                gesture almost as soon as it starts. Owning the pointer
                ourselves is the only way one control can hold both meanings.
            -->
            <engine:VisualElement name="hud-recentre" class="hud__recentre">
                <engine:Label class="hud__recentre-glyph" text="◎" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:Label name="hud-recentre-label" class="hud__recentre-label ui-w600" text="CORE" picking-mode="Ignore" />
        </engine:VisualElement>

        <!-- A breach flashes the screen. Never picks. -->
        <engine:VisualElement name="hud-flash" class="hud__flash" picking-mode="Ignore" />

        <!--
            The countdown before the tick loop starts. It may block input: the
            board is not live yet, and there is nothing to press.
        -->
        <engine:VisualElement name="hud-countdown" class="hud__countdown">
            <engine:Label name="hud-countdown-step" class="hud__countdown-step ui-w700" text="3" picking-mode="Ignore" />
        </engine:VisualElement>

        <!--
            The end of the match, from the viewer's side: Victory or Defeat,
            never "PLAYER 0 WINS". The tally is the whole scoreboard, so both
            players' breach counts are shown with their marks. Translucent, so
            the board collapsing behind it stays visible.
        -->
        <engine:VisualElement name="hud-end" class="hud__end">
            <engine:VisualElement class="hud__end-card">
                <engine:Label name="hud-end-title" class="hud__end-title ui-w700" text="Victory" picking-mode="Ignore" />
                <engine:Label name="hud-end-sub" class="hud__end-sub" text="" picking-mode="Ignore" />

                <engine:VisualElement name="hud-end-tally" class="hud__end-tally" picking-mode="Ignore">
                    <engine:VisualElement class="hud__end-row" picking-mode="Ignore">
                        <engine:VisualElement name="hud-end-mark-a" class="ui-mark ui-mark--p0" picking-mode="Ignore">
                            <engine:Label name="hud-end-mark-a-label" class="ui-mark__label" text="1" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label name="hud-end-name-a" class="hud__end-name" text="You" picking-mode="Ignore" />
                        <engine:Label name="hud-end-count-a" class="hud__end-count ui-w600" text="0/3" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:VisualElement class="hud__end-row" picking-mode="Ignore">
                        <engine:VisualElement name="hud-end-mark-b" class="ui-mark ui-mark--p1" picking-mode="Ignore">
                            <engine:Label name="hud-end-mark-b-label" class="ui-mark__label" text="2" picking-mode="Ignore" />
                        </engine:VisualElement>
                        <engine:Label name="hud-end-name-b" class="hud__end-name" text="Opponent" picking-mode="Ignore" />
                        <engine:Label name="hud-end-count-b" class="hud__end-count ui-w600" text="0/3" picking-mode="Ignore" />
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:Button name="hud-end-return" class="ui-button ui-button--gold ui-w600 hud__end-button" text="Return to Lobby" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>

</engine:UXML>
