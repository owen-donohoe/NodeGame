<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xmlns:lobby="NodeWar.Lobby"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        Profile, after the prototype's stats and arena view. It is not a tab:
        it expands in place from the trophy strip when the player name is
        pressed, and covers the whole lobby, chrome included.

        Header: back, the name carried over from the strip, Rename.
        Body:   the record down the left, one stat per row (label above, the
                panel holds only the value); the arena road on the right,
                opened scrolled to the bottom so you travel upward, with a rail
                that fills to your position.

        Layout first, then the system, then the layout revised. So:
          - the record is em-dashes - no match result is written anywhere;
          - the four eras are the prototype's placeholder tiers, held in one
            table in ProfilePage.cs. No arena system exists;
          - the username and trophy count are real, and Rename really saves.

        Match history is not here. It has its own page, from the TV button
        beside the gear.

        #profile-rename is not shown in place. ProfilePage lifts it out and
        hands it to the lobby's shared sheet.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Profile.uss" />

    <engine:VisualElement name="profile-arena" class="lb-arena">
        <engine:VisualElement name="push-safe-area" class="lb-arena__inner" picking-mode="Ignore">

            <engine:VisualElement class="lb-arena__head">
                <engine:Button name="profile-back" class="lb-reset-button lb-back">
                    <lobby:LobbyIcon kind="Back" class="lb-icon" picking-mode="Ignore" />
                </engine:Button>
                <engine:VisualElement class="lb-arena__name" picking-mode="Ignore">
                    <engine:Label name="profile-username" class="lb-arena__name-text lb-w600" text="player" />
                    <engine:Label name="profile-subtitle" class="lb-arena__name-sub lb-w500" text="Arena — · 0 trophies" />
                </engine:VisualElement>
                <engine:VisualElement class="lb-lip lb-rename-wrap" picking-mode="Ignore">
                    <engine:VisualElement class="lb-lip__block lb-rename-lip" picking-mode="Ignore" />
                    <engine:Button name="profile-rename" class="lb-reset-button lb-rename lb-w600" text="Rename" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement class="lb-arena__body" picking-mode="Ignore">
                <engine:ScrollView name="profile-record" class="lb-record" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />

                <engine:ScrollView name="profile-road" class="lb-road" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <engine:VisualElement name="profile-road-inner" class="lb-road__inner" picking-mode="Ignore">
                        <engine:VisualElement name="profile-rail" class="lb-rail" picking-mode="Ignore">
                            <engine:VisualElement name="profile-rail-fill" class="lb-rail__fill" picking-mode="Ignore" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:ScrollView>
            </engine:VisualElement>

        </engine:VisualElement>
    </engine:VisualElement>

    <engine:VisualElement name="profile-rename" picking-mode="Ignore">
        <engine:Label class="lb-sheet__title lb-w600" text="Change your name" />
        <engine:TextField name="profile-name-field" class="lb-field lb-field--left" max-length="16" />
        <engine:Label name="profile-name-note" class="lb-sheet__note lb-w500" text="Up to 16 characters. Visible to opponents." />
        <engine:VisualElement class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
            <engine:VisualElement class="lb-lip__block lb-lip__block--gold" picking-mode="Ignore" />
            <engine:Button name="profile-name-save" class="lb-reset-button lb-bigbtn lb-bigbtn--gold lb-w700" text="Save" />
        </engine:VisualElement>
        <engine:VisualElement class="lb-bigbtn-wrap" picking-mode="Ignore">
            <engine:Button name="profile-name-cancel" class="lb-reset-button lb-bigbtn lb-bigbtn--quiet lb-w700" text="Cancel" />
        </engine:VisualElement>
    </engine:VisualElement>

</engine:UXML>
