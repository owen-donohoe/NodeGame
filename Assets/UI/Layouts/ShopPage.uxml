<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xmlns:lobby="NodeWar.Lobby"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        Shop, after lobby-prototype.html. The stall on the left with three wares
        stacked beside it; scroll past for the quiet list.

        The wares and the list rows are built by ShopPage from one placeholder
        catalogue, so this file is only the frame. Cosmetics and boxes only -
        nothing sold here changes a match. There is no economy, so buying says
        so instead of doing anything.

        #shop-item is the purchase sheet's content; ShopPage lifts it out and
        hands it to the lobby's shared sheet.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Shop.uss" />

    <engine:ScrollView name="shop-scroll" class="lb-shop" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">

        <engine:VisualElement class="lb-stallzone" picking-mode="Ignore">
            <engine:VisualElement class="lb-stall" picking-mode="Ignore">
                <engine:VisualElement class="lb-stall__awning-wrap lb-sticker" picking-mode="Ignore">
                    <engine:VisualElement class="lb-sticker__shadow" picking-mode="Ignore" />
                    <engine:VisualElement class="lb-stall__awning" picking-mode="Ignore">
                        <engine:VisualElement class="lb-stripe lb-stripe--red" picking-mode="Ignore" />
                        <engine:VisualElement class="lb-stripe lb-stripe--cream" picking-mode="Ignore" />
                        <engine:VisualElement class="lb-stripe lb-stripe--red" picking-mode="Ignore" />
                        <engine:VisualElement class="lb-stripe lb-stripe--cream" picking-mode="Ignore" />
                        <engine:VisualElement class="lb-stripe lb-stripe--red" picking-mode="Ignore" />
                        <engine:VisualElement class="lb-stripe lb-stripe--cream" picking-mode="Ignore" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement class="lb-stall__post lb-stall__post--left" picking-mode="Ignore" />
                <engine:VisualElement class="lb-stall__post lb-stall__post--right" picking-mode="Ignore" />
                <engine:VisualElement class="lb-stall__keeper" picking-mode="Ignore" />
                <engine:VisualElement class="lb-stall__counter-wrap lb-sticker" picking-mode="Ignore">
                    <engine:VisualElement class="lb-sticker__shadow" picking-mode="Ignore" />
                    <engine:VisualElement class="lb-stall__counter" picking-mode="Ignore" />
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="shop-wares" class="lb-wares" picking-mode="Ignore" />
        </engine:VisualElement>

        <engine:VisualElement name="shop-tail" class="lb-shop-tail" picking-mode="Ignore" />

    </engine:ScrollView>

    <engine:VisualElement name="shop-item" picking-mode="Ignore">
        <engine:Label name="shop-item-title" class="lb-sheet__title lb-w600" text="" />
        <engine:VisualElement class="lb-shop-item__row" picking-mode="Ignore">
            <engine:VisualElement class="lb-rowthumb lb-rowthumb--large" picking-mode="Ignore">
                <lobby:LobbyIcon name="shop-item-icon" kind="Flag" class="lb-icon" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:Label class="lb-sheet__note lb-shop-item__note lb-w500" text="Appearance only. No effect on a match." />
        </engine:VisualElement>
        <engine:VisualElement class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
            <engine:VisualElement class="lb-lip__block lb-lip__block--green" picking-mode="Ignore" />
            <engine:Button name="shop-item-buy" class="lb-reset-button lb-bigbtn lb-bigbtn--green lb-w700" text="Buy" />
        </engine:VisualElement>
    </engine:VisualElement>

</engine:UXML>
