<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:engine="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        The battle sheet's content, after lobby-prototype.html. The sheet itself
        (scrim, slide, handle, detents) is the lobby's shared LobbySheet in
        LobbyRoot.uxml; this file is only what goes inside it.

        Three views, one at a time:
          #play-find     mode row, loadout note, then the action for that mode
          #play-join     enter a code (or an address, on Local network)
          #play-status   waiting with the code, connecting, or why it failed

        Differences from the prototype, on purpose:
          - Local network is kept. The prototype is relay-only, but direct-IP
            play works today, so a small Online / Local network row appears
            under 1 vs 1 rather than dropping a working transport.
          - Bot and Testing start immediately from one button. Host and Join
            mean nothing without an opponent.
          - The sheet grows with its content instead of a fixed 46%, because
            the transport row and a failure message need room.

        Styles live in Lobby.uss.
    -->

    <engine:VisualElement name="play-content" picking-mode="Ignore">

        <!-- Find a match -->
        <engine:VisualElement name="play-find" picking-mode="Ignore">
            <engine:Label class="lb-sheet__title lb-w600" text="Find a match" />

            <engine:VisualElement class="lb-seg" picking-mode="Ignore">
                <engine:Button name="play-mode-1v1" class="lb-reset-button lb-seg__btn lb-w600" text="1 vs 1" />
                <engine:Button name="play-mode-bot" class="lb-reset-button lb-seg__btn lb-w600" text="Bot" />
                <engine:Button name="play-mode-testing" class="lb-reset-button lb-seg__btn lb-w600" text="Testing" />
                <engine:Button name="play-mode-locked" class="lb-reset-button lb-seg__btn lb-seg__btn--off lb-seg__btn--last lb-w600" text="Locked" />
            </engine:VisualElement>

            <engine:VisualElement name="play-transport" class="lb-seg" picking-mode="Ignore">
                <engine:Button name="play-transport-relay" class="lb-reset-button lb-seg__btn lb-w600" text="Online" />
                <engine:Button name="play-transport-lan" class="lb-reset-button lb-seg__btn lb-seg__btn--last lb-w600" text="Local network" />
            </engine:VisualElement>

            <!-- Loadout counts, each side its own label so only a short side turns orange. -->
            <engine:VisualElement name="play-loadout" class="lb-loadout-line" picking-mode="Ignore">
                <engine:Label class="lb-loadout-line__part lb-w500" text="Loadout:" />
                <engine:Label name="play-loadout-nodes" class="lb-loadout-line__part lb-w500" text="" />
                <engine:Label class="lb-loadout-line__part lb-w500" text="·" />
                <engine:Label name="play-loadout-suits" class="lb-loadout-line__part lb-w500" text="" />
            </engine:VisualElement>

            <engine:Label name="play-note" class="lb-sheet__note lb-w500" text="" />

            <engine:VisualElement name="play-host-wrap" class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--gold" picking-mode="Ignore" />
                <engine:Button name="play-host" class="lb-reset-button lb-bigbtn lb-bigbtn--gold lb-w700" text="Host" />
            </engine:VisualElement>
            <engine:VisualElement name="play-join-wrap" class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--green" picking-mode="Ignore" />
                <engine:Button name="play-join-open" class="lb-reset-button lb-bigbtn lb-bigbtn--green lb-w700" text="Join with a code" />
            </engine:VisualElement>
            <engine:VisualElement name="play-start-wrap" class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--gold" picking-mode="Ignore" />
                <engine:Button name="play-start" class="lb-reset-button lb-bigbtn lb-bigbtn--gold lb-w700" text="Play" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Enter the code -->
        <engine:VisualElement name="play-join" picking-mode="Ignore">
            <engine:Label name="play-join-title" class="lb-sheet__title lb-w600" text="Enter the code" />
            <engine:TextField name="play-code" class="lb-field" max-length="32" />
            <engine:Label name="play-join-hint" class="lb-sheet__note lb-w500" text="Four letters from your opponent" />
            <engine:VisualElement class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--gold" picking-mode="Ignore" />
                <engine:Button name="play-join-go" class="lb-reset-button lb-bigbtn lb-bigbtn--gold lb-w700" text="Join" />
            </engine:VisualElement>
            <engine:VisualElement class="lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:Button name="play-join-back" class="lb-reset-button lb-bigbtn lb-bigbtn--quiet lb-w700" text="Back" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Waiting / connecting / failed -->
        <engine:VisualElement name="play-status" picking-mode="Ignore">
            <engine:Label name="play-status-text" class="lb-sheet__title lb-w600" text="" />

            <engine:VisualElement name="play-code-display" class="lb-codebox" picking-mode="Ignore">
                <engine:Label class="lb-codebox__label lb-w500" text="Share this code" />
                <engine:Label name="play-code-value" class="lb-codebox__code lb-w700" text="" />
            </engine:VisualElement>

            <engine:Label name="play-failure-recovery" class="lb-sheet__note lb-w500" text="" />

            <engine:VisualElement name="play-copy-wrap" class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--green" picking-mode="Ignore" />
                <engine:Button name="play-copy" class="lb-reset-button lb-bigbtn lb-bigbtn--green lb-w700" text="Copy code" />
            </engine:VisualElement>
            <engine:VisualElement name="play-retry-wrap" class="lb-lip lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:VisualElement class="lb-lip__block lb-lip__block--gold" picking-mode="Ignore" />
                <engine:Button name="play-retry" class="lb-reset-button lb-bigbtn lb-bigbtn--gold lb-w700" text="Try again" />
            </engine:VisualElement>
            <engine:VisualElement class="lb-bigbtn-wrap" picking-mode="Ignore">
                <engine:Button name="play-cancel" class="lb-reset-button lb-bigbtn lb-bigbtn--quiet lb-w700" text="Cancel" />
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>

</engine:UXML>
