<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" xmlns:lobby="NodeWar.Lobby" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        Settings, after lobby-prototype.html: a full page pushed in from the
        right. Every row the prototype has, in its groups and order, with its
        default values.

        Preference rows read and write PlayerProfile, through the save path it
        already owned rather than a second one. What a saved value then drives
        is a separate question and mostly still open - the footnote below names
        what is stored but not yet acted on, and narrows as each system lands.
        A control that looks live and does nothing is the thing this lobby does
        not allow, so that footnote stays until there is nothing left to admit.

        The values below are duplicated in GameSettingsData.CreateDefault, so a
        profile that does not exist yet and a page that has not loaded show the
        same thing. If either side moves, move both.

        Rows that hold a switch are Buttons, so the whole row is the target.
        Account status and actions are rendered from BackendServices.Account.
    -->

    <engine:Style src="project://database/Assets/UI/Styles/Settings.uss" />

    <engine:VisualElement name="push-safe-area" class="lb-push__safe" picking-mode="Ignore">
        <engine:ScrollView name="settings-scroll" class="lb-push__scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">

            <engine:VisualElement class="lb-push__header" picking-mode="Ignore">
                <lobby:PaperButton name="push-back" class="ui-reset-button lb-back">
                    <lobby:LobbyIcon context="PageHeader" kind="Back" class="lb-icon" picking-mode="Ignore" />
                </lobby:PaperButton>
                <engine:Label class="lb-push__title ui-w600" text="Settings" />
            </engine:VisualElement>

            <engine:Label class="lb-group-label lb-group-label--first ui-w600" text="Account" />
            <engine:VisualElement name="settings-account" class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-0">
                    <engine:Label name="settings-account-status" class="lb-account-status ui-w500" />
                    <lobby:PaperButton name="settings-account-link" class="ui-reset-button lb-grow lb-account-action ui-w500" text="Link account" />
                    <lobby:PaperButton name="settings-account-sign-in" class="ui-reset-button lb-grow lb-grow--last lb-account-action ui-w500" text="Sign in" />
                    <lobby:PaperButton name="settings-account-sign-out" class="ui-reset-button lb-grow lb-grow--last lb-account-action ui-w500" text="Sign out" />
                    <lobby:PaperButton name="settings-account-guest" class="ui-reset-button lb-grow lb-grow--last lb-account-action ui-w500" text="Continue as guest" />
                    <engine:Label name="settings-account-message" class="lb-account-message ui-w500" />
                </lobby:PaperCard>
            </engine:VisualElement>

            <engine:Label class="lb-group-label ui-w600" text="Audio" />
            <engine:VisualElement class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-1">
                    <engine:VisualElement class="lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Master" />
                        <engine:Slider name="settings-master" class="lb-slider" low-value="0" high-value="1" value="0.64" />
                    </engine:VisualElement>
                    <engine:VisualElement class="lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Music" />
                        <engine:Slider name="settings-music" class="lb-slider" low-value="0" high-value="1" value="0.40" />
                    </engine:VisualElement>
                    <engine:VisualElement class="lb-grow lb-grow--last">
                        <engine:Label class="lb-grow__label ui-w500" text="Effects" />
                        <engine:Slider name="settings-effects" class="lb-slider" low-value="0" high-value="1" value="0.78" />
                    </engine:VisualElement>
                </lobby:PaperCard>
            </engine:VisualElement>

            <engine:Label class="lb-group-label ui-w600" text="Accessibility" />
            <engine:VisualElement class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-2">
                    <lobby:PaperButton name="settings-row-colourblind" class="ui-reset-button lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Colourblind marks" picking-mode="Ignore" />
                        <lobby:LobbyToggle name="settings-colourblind" value="true" />
                    </lobby:PaperButton>
                    <lobby:PaperButton name="settings-row-motion" class="ui-reset-button lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Reduced motion" picking-mode="Ignore" />
                        <lobby:LobbyToggle name="settings-motion" value="false" />
                    </lobby:PaperButton>
                    <lobby:PaperButton name="settings-row-size" class="ui-reset-button lb-grow lb-grow--last">
                        <engine:Label class="lb-grow__label ui-w500" text="Interface size" picking-mode="Ignore" />
                        <engine:Label name="settings-size" class="lb-grow__value ui-w500" text="Default" picking-mode="Ignore" />
                    </lobby:PaperButton>
                </lobby:PaperCard>
            </engine:VisualElement>

            <engine:Label class="lb-group-label ui-w600" text="Gameplay" />
            <engine:VisualElement class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-3">
                    <engine:VisualElement class="lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Camera speed" />
                        <engine:Slider name="settings-camera" class="lb-slider" low-value="0" high-value="1" value="0.52" />
                    </engine:VisualElement>
                    <lobby:PaperButton name="settings-row-confirm" class="ui-reset-button lb-grow lb-grow--last">
                        <engine:Label class="lb-grow__label ui-w500" text="Confirm each command" picking-mode="Ignore" />
                        <lobby:LobbyToggle name="settings-confirm" value="false" />
                    </lobby:PaperButton>
                </lobby:PaperCard>
            </engine:VisualElement>

            <!--
                Controls. One button opens "Configure controls", an overlay built by
                ControlsPanel (the overlay skeleton is the last child of this page).
            -->
            <engine:Label class="lb-group-label ui-w600" text="Controls" />
            <engine:VisualElement class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-4">
                    <lobby:PaperButton name="settings-row-controls" class="ui-reset-button lb-grow lb-grow--last">
                        <engine:Label class="lb-grow__label ui-w500" text="Configure controls" picking-mode="Ignore" />
                        <engine:Label class="lb-grow__value ui-w500" text="›" picking-mode="Ignore" />
                    </lobby:PaperButton>
                </lobby:PaperCard>
            </engine:VisualElement>

            <engine:Label class="lb-group-label ui-w600" text="Mobile" />
            <engine:VisualElement class="lb-group-wrap ui-sticker" picking-mode="Ignore">
                <engine:VisualElement class="ui-sticker__shadow" picking-mode="Ignore" />
                <lobby:PaperCard class="lb-group" name="paper-lb-group-5">
                    <lobby:PaperButton name="settings-row-haptics" class="ui-reset-button lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Haptics" picking-mode="Ignore" />
                        <lobby:LobbyToggle name="settings-haptics" value="true" />
                    </lobby:PaperButton>
                    <lobby:PaperButton name="settings-row-framecap" class="ui-reset-button lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Frame rate cap" picking-mode="Ignore" />
                        <engine:Label name="settings-framecap" class="lb-grow__value ui-w500" text="60" picking-mode="Ignore" />
                    </lobby:PaperButton>
                    <lobby:PaperButton name="settings-row-graphics" class="ui-reset-button lb-grow">
                        <engine:Label class="lb-grow__label ui-w500" text="Graphics" picking-mode="Ignore" />
                        <engine:Label name="settings-graphics" class="lb-grow__value ui-w500" text="High" picking-mode="Ignore" />
                    </lobby:PaperButton>
                    <engine:VisualElement name="graphics-details" picking-mode="Ignore" style="display: none;">
                        <lobby:PaperButton name="settings-row-waves" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Waves" picking-mode="Ignore" />
                            <engine:Label name="settings-waves" class="lb-grow__value ui-w500" text="4" picking-mode="Ignore" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-transparency" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Transparent shallows" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-transparency" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-surface-foam-distortion" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Foam ripple" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-surface-foam-distortion" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-horizon-fresnel" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Horizon sheen" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-horizon-fresnel" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-specular" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Sun glints" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-specular" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-crest-colour" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Wave crests" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-crest-colour" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-dither" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Smooth gradients" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-dither" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-shadows" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Shadows on water" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-shadows" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-detail-normals" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Detail ripples" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-detail-normals" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-macro-normals" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Large swells" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-macro-normals" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-reflections" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Reflections" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-reflections" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-lapping-lines" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Lapping lines" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-lapping-lines" value="false" />
                        </lobby:PaperButton>
                        <lobby:PaperButton name="settings-row-second-foam-layer" class="ui-reset-button lb-grow">
                            <engine:Label class="lb-grow__label ui-w500" text="Double foam" picking-mode="Ignore" />
                            <lobby:LobbyToggle name="settings-second-foam-layer" value="false" />
                        </lobby:PaperButton>
                    </engine:VisualElement>
                    <lobby:PaperButton name="settings-row-battery" class="ui-reset-button lb-grow lb-grow--last">
                        <engine:Label class="lb-grow__label ui-w500" text="Battery saver" picking-mode="Ignore" />
                        <lobby:LobbyToggle name="settings-battery" value="false" />
                    </lobby:PaperButton>
                </lobby:PaperCard>
            </engine:VisualElement>

            <!-- TODO(settings): narrow as each system lands; delete the label when none are left. -->
            <engine:Label class="lb-settings-footnote ui-w500" text="Saved, but only Reduced motion and Frame rate cap change anything so far." />

        </engine:ScrollView>

        <!--
            Configure controls: a full-height overlay over this page, opened from
            #settings-row-controls. ControlsPanel builds the grouped rows into the
            scroll. The scrim and popup hold the action list while one is open.
        -->
        <engine:VisualElement name="controls-panel" class="cp-page" picking-mode="Position">
            <engine:VisualElement class="cp-header-bar" picking-mode="Ignore">
                <lobby:PaperButton name="controls-back" class="ui-reset-button lb-back">
                    <lobby:LobbyIcon context="InlineText" kind="Back" class="lb-icon" picking-mode="Ignore" />
                </lobby:PaperButton>
                <engine:Label class="cp-title ui-w600" text="Configure controls" picking-mode="Ignore" />
            </engine:VisualElement>
            <engine:ScrollView name="controls-scroll" class="cp-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
            <engine:VisualElement name="controls-popup-scrim" class="cp-scrim" picking-mode="Position">
                <lobby:PaperCard name="controls-popup" class="cp-popup" picking-mode="Position" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>

<engine:Style src="../Resources/Lobby/PaperLobby.uss" /></engine:UXML>
