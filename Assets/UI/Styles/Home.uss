/*
    Home - the lobby's landing page, after lobby-prototype.html.

    Tokens, shell and shared components (sticker shadows, lips, sheets) are
    in Lobby.uss, which LobbyRoot.uxml imports ahead of every page.

    Label rules that set margin or padding are written .lb-root .lb-x, so they
    outrank the label reset in Lobby.uss. Follow that in any new rule.
*/

/* ===================================================================
   HOME
   =================================================================== */

.lb-home-page {
    flex-grow: 1;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ---- boxes ---- */

.lb-boxcol {
    position: absolute;
    left: var(--lb-sp4);
    top: 24px;
    width: 130px;
}

.lb-box {
    align-items: center;
    justify-content: center;
    background-color: var(--lb-paper-hi);
    border-left-width: var(--lb-bw);
    border-right-width: var(--lb-bw);
    border-top-width: var(--lb-bw);
    border-bottom-width: var(--lb-bw);
    border-left-color: var(--lb-edge);
    border-right-color: var(--lb-edge);
    border-top-color: var(--lb-edge);
    border-bottom-color: var(--lb-edge);
    border-top-left-radius: var(--lb-r-md);
    border-top-right-radius: var(--lb-r-md);
    border-bottom-left-radius: var(--lb-r-md);
    border-bottom-right-radius: var(--lb-r-md);
    transition-property: scale, translate;
    transition-duration: var(--lb-t-press);
    transition-timing-function: ease-in;
}

.lb-box:active {
    scale: 0.96 0.96;
    translate: 0 2px;
}

.lb-box-wrap--big {
    height: 130px;
    margin-bottom: var(--lb-sp3);
}

.lb-box-wrap--small {
    height: 78px;
}

.lb-box-wrap > .lb-box {
    flex-grow: 1;
}

.lb-box .lb-icon {
    width: 38px;
    height: 38px;
    -unity-background-image-tint-color: var(--lb-ink-mute);
}

.lb-box-wrap--small .lb-icon {
    width: 26px;
    height: 26px;
}

.lb-root .lb-box__label {
    font-size: 14px;
    color: var(--lb-ink-mute);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.lb-root .lb-badge {
    position: absolute;
    top: -11px;
    right: -11px;
    min-width: 30px;
    height: 30px;
    padding-left: 6px;
    padding-right: 6px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: var(--lb-badge);
    border-left-width: var(--lb-bw);
    border-right-width: var(--lb-bw);
    border-top-width: var(--lb-bw);
    border-bottom-width: var(--lb-bw);
    border-left-color: var(--lb-badge-edge);
    border-right-color: var(--lb-badge-edge);
    border-top-color: var(--lb-badge-edge);
    border-bottom-color: var(--lb-badge-edge);
    color: var(--lb-white);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.lb-root .lb-badge--zero {
    background-color: var(--lb-off);
    border-left-color: var(--lb-off-edge);
    border-right-color: var(--lb-off-edge);
    border-top-color: var(--lb-off-edge);
    border-bottom-color: var(--lb-off-edge);
}

/* ---- loadout preview: deliberately quiet - no border, no shadow ---- */

.lb-loadcol {
    position: absolute;
    right: var(--lb-sp4);
    top: 28px;
    align-items: center;
    opacity: 0.62;
    transition-property: opacity;
    transition-duration: var(--lb-t-rel);
}

.lb-loadcol:hover {
    opacity: 1;
}

.lb-lpi {
    width: 40px;
    height: 40px;
    margin-bottom: 6px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    background-color: var(--lb-chip-bg);
    align-items: center;
    justify-content: center;
}

.lb-lpi--gap {
    margin-top: 9px;
}

/* A filled slot: faded navy, with the item's letter. */
.lb-lpi--filled {
    background-color: var(--lb-loadout-ok-bg);
}

/* An empty slot the player could fill: faded orange. The same orange marks
   the short side in the battle sheet's loadout line. */
.lb-lpi--short {
    background-color: var(--lb-loadout-short-bg);
}

.lb-root .lb-lpi__letter {
    font-size: 19px;
    color: var(--lb-ink-mute);
    -unity-text-align: middle-center;
}

.lb-root .lb-lpi--filled > .lb-lpi__letter {
    color: var(--lb-loadout-ok-ink);
}

.lb-root .lb-lpcap {
    font-size: 11px;
    color: var(--lb-ink-mute);
    letter-spacing: 0.7px;
    margin-top: 3px;
    -unity-text-align: middle-center;
}

/* ---- villager ---- */

.lb-villager-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30%;
    align-items: center;
}

.lb-root .lb-tapedit {
    font-size: 15px;
    color: var(--lb-ink-mute);
    margin-bottom: 14px;
}

.lb-villager {
    align-items: center;
    transition-property: translate;
    transition-duration: var(--lb-t-bob);
    transition-timing-function: ease-in-out;
}

.lb-villager--up {
    translate: 0 -6px;
}

.lb-villager__body {
    width: 56px;
    height: 78px;
    background-color: var(--lb-paper-hi);
    border-left-width: var(--lb-bw);
    border-right-width: var(--lb-bw);
    border-top-width: var(--lb-bw);
    border-bottom-width: var(--lb-bw);
    border-left-color: var(--lb-edge);
    border-right-color: var(--lb-edge);
    border-top-color: var(--lb-edge);
    border-bottom-color: var(--lb-edge);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    align-items: center;
}

.lb-villager > .lb-sticker__shadow {
    top: 5px;
    bottom: -5px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.lb-villager__hat {
    position: absolute;
    top: -11px;
    width: 52px;
    height: 14px;
    background-color: var(--lb-hat);
    border-left-width: var(--lb-bw);
    border-right-width: var(--lb-bw);
    border-top-width: var(--lb-bw);
    border-bottom-width: var(--lb-bw);
    border-left-color: var(--lb-edge);
    border-right-color: var(--lb-edge);
    border-top-color: var(--lb-edge);
    border-bottom-color: var(--lb-edge);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.lb-villager__face {
    position: absolute;
    top: 17px;
    width: 26px;
    height: 26px;
    -unity-background-image-tint-color: var(--lb-edge);
}

/* ---- call to action ---- */

.lb-cta {
    position: absolute;
    left: var(--lb-sp4);
    right: var(--lb-sp4);
    bottom: 100px;
}

.lb-battle {
    height: 74px;
    background-color: var(--lb-gold);
    border-left-width: var(--lb-bw);
    border-right-width: var(--lb-bw);
    border-top-width: var(--lb-bw);
    border-bottom-width: var(--lb-bw);
    border-left-color: var(--lb-gold-edge);
    border-right-color: var(--lb-gold-edge);
    border-top-color: var(--lb-gold-edge);
    border-bottom-color: var(--lb-gold-edge);
    border-top-left-radius: var(--lb-r-lg);
    border-top-right-radius: var(--lb-r-lg);
    border-bottom-left-radius: var(--lb-r-lg);
    border-bottom-right-radius: var(--lb-r-lg);
    font-size: 30px;
    letter-spacing: 0.5px;
    color: var(--lb-gold-text);
    transition-property: translate;
    transition-duration: var(--lb-t-press);
    transition-timing-function: ease-in;
}

.lb-battle:active {
    translate: 0 4px;
}

.lb-battle-lip {
    background-color: var(--lb-gold-edge);
    border-top-left-radius: var(--lb-r-lg);
    border-top-right-radius: var(--lb-r-lg);
    border-bottom-left-radius: var(--lb-r-lg);
    border-bottom-right-radius: var(--lb-r-lg);
}

.lb-boxmeter {
    margin-top: var(--lb-sp3);
    flex-direction: row;
    align-items: center;
    background-color: var(--lb-meter-bg);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
}

.lb-root .lb-boxmeter__label {
    font-size: 15px;
    color: var(--lb-ink-inv);
    margin-right: var(--lb-sp3);
    flex-shrink: 0;
}

.lb-boxmeter__track {
    flex-grow: 1;
    height: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--lb-meter-track);
    overflow: hidden;
}

.lb-boxmeter__fill {
    height: 100%;
    width: 0;
    background-color: var(--lb-green);
}

