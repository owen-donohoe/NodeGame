.transition-shield {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.transition-sheet {
    height: 100%;
    align-items: center;
    justify-content: center;
    /* Square edges make the covered frame opaque all the way to the corners. */
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    /* DOTween owns translate; do not ease each of its samples again in USS. */
    transition-duration: 0s;
}

.transition-title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-bottom: var(--space-2);
}

.transition-note {
    font-size: var(--type-caption);
    color: var(--ink-mute);
}
