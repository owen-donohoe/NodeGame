/*
    In-match HUD, after ingame-prototype.html.

    Tokens and the shared pieces (player marks, chips) come from the panel
    theme. Readouts over the board use the --hud-* dark glass and light ink,
    because they sit on a lit 3D scene rather than on paper.

    Two things here are not taste:

    1. NOTHING PAINTS A FULL-SCREEN BACKGROUND. This surface floats over a 3D
       board. .hud and every container are transparent; only the readouts
       have a fill, and they are as small as they can be.

    2. THE BOTTOM OF THE SCREEN IS LEFT TO THE BOARD. .hud__board-space takes
       all the slack, so every readout is pinned to the top. The node sheet is
       the only element allowed to reach the bottom edge.

    No text is set below --type-min.
*/

.hud {
    background-color: var(--clear);
}

/* SafeAreaBinder writes the padding here; nothing else should. */
.hud__safe {
    flex-grow: 1;
    flex-direction: column;
}

.hud__board-space {
    flex-grow: 1;
}

/* ===================================================================
   Breach walls and the clock
   =================================================================== */

.hud__topbar {
    flex-direction: row;
    align-items: center;
    padding-top: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    flex-shrink: 0;
}

.hud__side {
    flex-grow: 1;
    flex-basis: 0;
    transition-property: scale;
    transition-duration: 180ms;
    transition-timing-function: ease-out-back;
}

.hud__side--hit {
    scale: 1.05 1.05;
}

.hud__side-row {
    flex-direction: row;
    align-items: center;
}

.hud__side--them > .hud__side-row {
    flex-direction: row-reverse;
}

.ui-root .hud__you {
    font-size: var(--type-min);
    color: var(--action);
    margin-left: 6px;
    letter-spacing: 1px;
}

.ui-root .hud__breach-count {
    font-size: 14px;
    color: var(--hud-ink);
    margin-left: 6px;
}

.hud__side--them .hud__breach-count {
    margin-left: 0;
    margin-right: 6px;
}

/*
    A wall, not a damage bar: full is no breaches, empty is defeat. Your wall
    drains toward the clock from the left, theirs from the right. The ghost is
    the wall as it stood before the last breach, left behind for a beat so the
    loss is seen rather than inferred.
*/
.hud__wall {
    height: 14px;
    margin-top: 5px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: var(--hud-glass);
    overflow: hidden;
}

.hud__wall-ghost,
.hud__wall-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
}

.hud__side--you .hud__wall-ghost,
.hud__side--you .hud__wall-fill {
    right: 0;
}

.hud__side--them .hud__wall-ghost,
.hud__side--them .hud__wall-fill {
    left: 0;
}

.hud__wall-ghost {
    background-color: var(--hud-ghost);
    transition-property: width;
    transition-duration: 850ms;
    transition-delay: 180ms;
}

.hud__wall-fill {
    transition-property: width;
    transition-duration: 80ms;
}

.hud__wall-fill--p0 { background-color: var(--p0); }
.hud__wall-fill--p1 { background-color: var(--p1); }

/* A viewer switch redraws the walls without replaying a breach. */
.hud--snap .hud__wall-ghost,
.hud--snap .hud__wall-fill {
    transition-duration: 0s;
    transition-delay: 0s;
}

.hud__clock {
    width: 58px;
    height: 58px;
    margin-left: var(--space-2);
    margin-right: var(--space-2);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-left-radius: 29px;
    border-bottom-right-radius: 29px;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    background-color: var(--hud-glass);
}

.ui-root .hud__clock-time {
    font-size: 16px;
    color: var(--hud-ink);
    -unity-text-align: middle-center;
}

.ui-root .hud__clock-label {
    font-size: var(--type-min);
    color: var(--hud-ink-mute);
    -unity-text-align: middle-center;
}

/* ===================================================================
   Resources

   Each card is a rounded dark-glass rectangle holding three concentric
   segmented rings (ResourceRing, drawn in code) with the live count
   centred inside and the label above. Ring colour follows the value -
   see ResourceRingMath - so the card itself and the label stay neutral.

   POP ON CHANGE. hud__res-ring-host--up/--down are added by code and
   removed a beat later via schedule.Execute(...).StartingIn(...), the
   same idiom as .hud__side--hit: an increase scales the rings and number
   up and back, a decrease scales them down and tints the card's border
   red for the same beat. Neither fires on a viewer switch or the first
   render.
   =================================================================== */

.hud__resources {
    flex-direction: row;
    margin-top: var(--space-4);
    margin-left: var(--space-3);
    margin-right: var(--space-3);
    flex-shrink: 0;
}

.hud__res-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 11px;
    align-items: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    background-color: var(--hud-glass);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    transition-property: border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 150ms;
}

.hud__res-card--last {
    margin-right: 0;
}

.ui-root .hud__res-label {
    font-size: var(--type-min);
    letter-spacing: 1px;
    color: var(--hud-ink-mute);
    margin-bottom: 4px;
}

.hud__res-ring-host {
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out-back;
}

/*
    The ring reads these through CustomStyleResolvedEvent. Declared again
    here, on the class the ring element itself carries, rather than left to
    inherit from Tokens.uss's :root alone -- custom properties only resolve
    reliably where a selector matches the element or an ancestor.
*/
.hud__res-ring {
    --resource-ring-critical: var(--resource-ring-critical);
    --resource-ring-low: var(--resource-ring-low);
    --resource-ring-warn: var(--resource-ring-warn);
    --resource-ring-ok: var(--resource-ring-ok);
    --resource-ring-good: var(--resource-ring-good);
    --resource-ring-rich: var(--resource-ring-rich);
    --resource-ring-track: var(--resource-ring-track);
}

.hud__res-ring-host--up {
    scale: 1.12 1.12;
}

.hud__res-ring-host--down {
    scale: 0.9 0.9;
}

.ui-root .hud__res-value {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    font-size: var(--type-heading);
    color: var(--hud-ink);
    -unity-text-align: middle-center;
}

/* The decrease pop's card-border tint. */
.hud__res-card--down {
    border-left-color: var(--badge);
    border-right-color: var(--badge);
    border-top-color: var(--badge);
    border-bottom-color: var(--badge);
}

/* ===================================================================
   Units
   =================================================================== */

.hud__units-row {
    flex-direction: column;
    align-items: flex-end;
    margin-top: var(--space-3);
    margin-right: var(--space-3);
    flex-shrink: 0;
}

/* 44 tall for the thumb, so the radius is exactly half. */
.hud__units {
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    background-color: var(--hud-glass);
    color: var(--hud-ink);
    font-size: 15px;
    -unity-font-definition: var(--font-semibold);
    transition-property: scale;
    transition-duration: var(--motion-press);
}

.hud__units:active {
    scale: 0.95 0.95;
}

.hud__units--open {
    background-color: var(--hud-glass-strong);
}

.hud__units-card {
    display: none;
    margin-top: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    max-width: 190px;
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    background-color: var(--hud-glass-strong);
}

.hud__units-card--open {
    display: flex;
}

.hud__units-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.ui-root .hud__units-count {
    font-size: 15px;
    color: var(--hud-ink);
    margin-left: var(--space-2);
}

.ui-root .hud__units-note {
    font-size: var(--type-min);
    color: var(--hud-ink-mute);
    white-space: normal;
}

/* ===================================================================
   Selection
   =================================================================== */

.hud__selection-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 48px;
    align-items: center;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 160ms;
}

.hud__selection-dock--on {
    opacity: 1;
    translate: 0 0;
}

.ui-root .hud__selection > .ui-chip__text {
    font-size: 15px;
}

/* ===================================================================
   Zoom readout

   Transient feedback, never a control. It exists so the player can tell
   they are in zoom mode and how far they have gone -- a pinch or a handle
   drag is otherwise a mode with nothing on screen to confirm it.
   =================================================================== */

.hud__zoom {
    position: absolute;
    left: 0;
    right: 0;
    top: 44%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale;
    transition-duration: 140ms, 180ms;
}

.hud__zoom--on {
    opacity: 1;
    scale: 1 1;
}

.hud__zoom-value {
    font-size: 17px;
    color: var(--hud-ink);
    background-color: var(--hud-glass-strong);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    border-radius: 99px;
    padding-left: 15px;
    padding-right: 11px;
    padding-top: 5px;
    padding-bottom: 5px;
    -unity-text-align: middle-center;
}

.hud__zoom-track {
    width: 74px;
    height: 4px;
    border-radius: 99px;
    background-color: var(--hud-bar-past);
    margin-left: -9px;
    overflow: hidden;
}

.hud__zoom-fill {
    height: 100%;
    width: 50%;
    border-radius: 99px;
    background-color: var(--action);
}

/* ===================================================================
   Zoom handle

   One circle carrying two inputs: a click recentres on your core, a
   vertical drag zooms. Permanent, because a control that appears only
   once you have moved is missing exactly when you want to zoom out to
   look around at the start of a match.

   The dock ignores picking; only the button itself takes a touch.
   =================================================================== */

.hud__recentre-dock {
    position: absolute;
    right: 12px;
    bottom: 290px;
    align-items: center;
}

.hud__recentre {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    background-color: var(--hud-glass-strong);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    color: var(--hud-ink);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.hud__recentre-glyph {
    font-size: 17px;
    color: var(--hud-ink);
    -unity-text-align: middle-center;
}

/* Driven from code, not :active -- the handle owns the pointer for the
   whole drag, and :active would drop the moment the finger left the circle. */
.hud__recentre--held {
    background-color: var(--hud-glass);
    scale: 0.94 0.94;
}

.hud__recentre-label {
    font-size: 8px;
    letter-spacing: 0.7px;
    color: var(--hud-ink-mute);
    margin-top: 3px;
}

/* ===================================================================
   Breach flash
   =================================================================== */

.hud__flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--hud-flash);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.hud__flash--on {
    opacity: 0.5;
    transition-duration: 0s;
}

/* ===================================================================
   Countdown. Each step is punched in from larger, the way the uGUI
   overlay does it; the class is toggled from code and USS transitions
   the rest.
   =================================================================== */

.hud__countdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 300ms;
}

.hud__countdown--on {
    display: flex;
}

.hud__countdown--out {
    opacity: 0;
}

.ui-root .hud__countdown-step {
    font-size: 96px;
    color: var(--action);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
    scale: 1.5 1.5;
    transition-property: scale;
    transition-duration: 210ms;
    transition-timing-function: ease-out-back;
}

.ui-root .hud__countdown-step--in {
    scale: 1 1;
}

/* ===================================================================
   End of match
   =================================================================== */

.hud__end {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    background-color: var(--hud-dim);
    display: none;
}

.hud__end--on {
    display: flex;
}

.hud__end-card {
    width: 100%;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    background-color: var(--surface);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-lg);
    border-top-right-radius: var(--corner-lg);
    border-bottom-left-radius: var(--corner-lg);
    border-bottom-right-radius: var(--corner-lg);
}

/*
    Victory is green; defeat and a disconnect are plain ink. Red is not used
    here: on this surface red means player 2, so a red title would read as an
    ownership cue rather than a result.
*/
.ui-root .hud__end-title {
    font-size: 36px;
    color: var(--ink);
    margin-bottom: 5px;
}

.ui-root .hud__end-title--won {
    color: var(--confirm-edge);
}

.ui-root .hud__end-sub {
    font-size: 13px;
    color: var(--ink-mute);
    margin-bottom: var(--space-5);
    white-space: normal;
}

.hud__end-tally {
    margin-bottom: var(--space-5);
}

.hud__end-row {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
}

.ui-root .hud__end-name {
    flex-grow: 1;
    font-size: 15px;
    color: var(--ink);
    margin-left: var(--space-2);
}

.ui-root .hud__end-count {
    font-size: 15px;
    color: var(--ink);
}

.ui-root .hud__end-button {
    width: 100%;
    height: 54px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* ===================================================================
   In-match settings

   A corner card, not a page. The match is live behind it, so it covers
   the smallest area that still fits its rows, and it sits in the
   bottom-right where a thumb already is.

   The scrim is the one element on this surface allowed to pick, and only
   while the panel is open - display:none the rest of the time. That is
   what lets a tap outside close the panel without the HUD swallowing
   board taps for the whole match.
   =================================================================== */

.hud__settings-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
}

.hud__settings-scrim--on {
    display: flex;
}

/* The gear: bottom-right corner, same circle as the zoom handle above it. */
.hud__settings-dock {
    position: absolute;
    right: 12px;
    bottom: 12px;
    align-items: center;
}

.hud__gear {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    background-color: var(--hud-glass-strong);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    color: var(--hud-ink);
    font-size: 19px;
    -unity-text-align: middle-center;
}

.hud__gear:active {
    background-color: var(--hud-glass);
    scale: 0.94 0.94;
}

/* Rises out of the gear. Width is fixed rather than a percentage so it
   stays a card on a tablet instead of growing into a page. */
.hud__settings {
    position: absolute;
    right: 12px;
    bottom: 70px;
    width: 264px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
    background-color: var(--surface);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--ink);
    border-right-color: var(--ink);
    border-top-color: var(--ink);
    border-bottom-color: var(--ink);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    display: none;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 140ms;
}

.hud__settings--shown {
    display: flex;
}

.hud__settings--on {
    opacity: 1;
    translate: 0 0;
}

.hud__settings-title {
    font-size: 15px;
    color: var(--ink);
    margin-bottom: var(--space-3);
}

.hud__settings-row {
    flex-direction: column;
    margin-bottom: var(--space-3);
}

/* A switch row is one line, label and control facing each other. */
.hud__settings-row--switch {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud__settings-label {
    font-size: 13px;
    color: var(--ink);
    margin-bottom: 4px;
}

.hud__settings-row--switch > .hud__settings-label {
    margin-bottom: 0;
}

.hud__settings-slider {
    height: 20px;
}

.hud__settings-note {
    font-size: 10px;
    color: var(--ink-mute);
    white-space: normal;
    margin-top: 2px;
}

/* ===================================================================
   In-match indicators

   IndicatorLayer positions each .ind by translate every frame; the
   element itself sits at the layer's top-left and is pulled back by
   half its box so the translate lands on its centre.

   Motion is here, not in code. .ind--in pops the icon in with
   ease-out-back, which is the overshoot; removing it falls back to
   .ind, whose ease-in tapers it out. The transition in force is the
   target style's, so the same scale property does both - and the
   taper can never overshoot below zero into a mirrored icon.

   Colour says what kind of news it is; size says how loud (tier).
   Nothing here picks but a visible edge icon, and that is set from
   code, not USS.
   =================================================================== */

.ind-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ind {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
    align-items: center;
    justify-content: center;
    scale: 0 0;
    transition-property: scale;
    transition-duration: 160ms;
    transition-timing-function: ease-in;

    --ind-colour: var(--hud-ink);
}

.ind--in {
    scale: 1 1;
    transition-duration: 260ms;
    transition-timing-function: ease-out-back;
}

/* The in-view form: the same icon, smaller, because the player is
   already looking at it. */
.ind--in.ind--small {
    scale: 0.55 0.55;
}

.ind-layer--calm .ind--in {
    transition-timing-function: ease-out;
}

.ind__bubble {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
    background-color: var(--hud-glass-strong);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--ind-colour);
    border-right-color: var(--ind-colour);
    border-top-color: var(--ind-colour);
    border-bottom-color: var(--ind-colour);
    transition-property: scale, background-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out-back;
}

.ind__icon {
    width: 60%;
    height: 60%;
    -unity-background-image-tint-color: var(--ind-colour);
}

/* ---- tier: how loud ---- */

.ind--high > .ind__bubble {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
}

.ind--low > .ind__bubble {
    width: 26px;
    height: 26px;
    border-radius: 13px;
}

/* ---- kind: what the news is ---- */

.ind--battle,
.ind--attack,
.ind--threat {
    --ind-colour: var(--badge);
}

.ind--contested,
.ind--incursion {
    --ind-colour: var(--status-short);
}

.ind--idle {
    --ind-colour: var(--hud-ink-mute);
}

.ind--respawn {
    --ind-colour: var(--confirm);
}

.ind--effect {
    --ind-colour: var(--action);
}

/* A node of yours has just fallen: the bubble fills and swells. */
.ind--lost > .ind__bubble {
    scale: 1.15 1.15;
    background-color: var(--badge);
}

.ind--lost .ind__icon {
    -unity-background-image-tint-color: var(--hud-ink);
}

/* ---- the edge arrow ---- */

/* Spans the box and is rotated about its centre, so the triangle at
   its right edge swings round the bubble to face the subject. */
.ind__pointer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
}

.ind--pointing > .ind__pointer {
    display: flex;
}

.ind__pointer-icon {
    position: absolute;
    left: 36px;
    top: 16px;
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: var(--ind-colour);
}

.ind--high .ind__pointer-icon {
    left: 38px;
}

/* ---- merged: how many share this spot ---- */

.ind__count {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 18px;
    height: 18px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 9px;
    background-color: var(--ind-colour);
    color: var(--ink);
    font-size: var(--type-min);
    -unity-text-align: middle-center;
    display: none;
}

.ind--grouped > .ind__count {
    display: flex;
}

/* Emotes share the indicator pop, with opposite travel at the two anchors.
   Only the live opponent bubble picks; the layer and empty slots never do. */
.hud__emotes {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud__emote-dock {
    position: absolute;
    left: 12px;
    bottom: 12px;
    align-items: center;
}

/* Out of the node sheet's way while it is open; see EmotePanel.SetNodeSheetOpen. */
.hud__emotes--sheet .hud__emote-dock {
    display: none;
}

.hud__emote-sheet {
    left: 12px;
    right: auto;
    width: 228px;
    flex-direction: column;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud__emote-options {
    flex-direction: row;
}

.hud__emote-mute {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    padding-left: 10px;
}

.hud__emote-mute-label {
    color: var(--ink);
    font-size: 13px;
    margin-left: 8px;
}

.hud__speaker {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    -unity-background-image-tint-color: white;
}

.hud__settings-emotes-icon {
    margin-right: 6px;
}

.hud__emote-mute > .hud__speaker,
.hud__settings-emotes-icon {
    background-color: var(--hud-glass-strong);
    border-radius: 13px;
}

.hud__speaker--muted,
.hud__emotes--muted .hud__speaker {
    -unity-background-image-tint-color: var(--badge);
}

.hud__emote-option {
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 3px;
}

.hud__emote-icon {
    width: 28px;
    height: 28px;
    -unity-background-image-tint-color: var(--hud-ink);
}

.hud__emote-icon--flag {
    -unity-background-image-tint-color: white;
}

.hud__emote-option--disabled {
    opacity: 0.35;
}

.hud__emote-you {
    position: absolute;
    left: 12px;
    bottom: 76px;
    width: 46px;
    height: 46px;
}

/* Positioned in code at the top-right of the board space, below every
   readout, so the safe area and the units card are respected. */
.hud__emote-them {
    position: absolute;
    width: 46px;
    height: 46px;
}

.hud__emote-side {
    display: none;
}

.hud__emote-bubble {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    background-color: var(--hud-glass-strong);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--hud-edge);
    border-right-color: var(--hud-edge);
    border-top-color: var(--hud-edge);
    border-bottom-color: var(--hud-edge);
    scale: 0 0;
    translate: 0 64px;
    transition-property: scale, translate;
    transition-duration: 160ms;
    transition-timing-function: ease-in;
}

.hud__emote-them > .hud__emote-bubble {
    translate: 0 -31px;
}

.hud__emote-bubble--in,
.hud__emote-them > .hud__emote-bubble--in {
    scale: 1 1;
    translate: 0 0;
    transition-duration: 260ms;
    transition-timing-function: ease-out-back;
}

.hud__emotes--calm .hud__emote-bubble--in {
    transition-timing-function: ease-out;
}
