.lb-root .mk-sheet, .lb-root .mk-bigsheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 80%; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px 14px 0 0; background-color: var(--mk-card); color: var(--mk-ink); padding: 16px 12px; }
