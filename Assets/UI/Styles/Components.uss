/*
    Node War - shared components.

    The pieces both scenes draw the same way: type, buttons, the bottom
    sheet, bars, chips, the toast, player marks and monogram tiles. Loaded
    through UnityDefaultRuntimeTheme.tss after Tokens.uss, so every panel has
    them and a page stylesheet only adds what is particular to it.

    Classes are prefixed ui-. Page stylesheets keep their own prefixes (lb-
    in the lobby shell, hud__ in the match), so a shared rule and a page rule
    never share a name.

    Rules here read meaning tokens only, never --pal-*.

    PRECEDENCE. These rules arrive through the panel theme, and a theme rule
    loses to ANY rule in a stylesheet a layout imports, whatever the
    specificity (measured in 6000.5.9f1). So a page overrides a component with
    a plain single-class rule - and the .ui-root Label reset below yields to
    any page rule that sets a label's margin or padding. Set those only where
    the spacing is meant.

    Measured against 6000.5.9f1, where the prototypes use CSS that USS lacks:
      box-shadow, drop-shadow        -> a sibling element behind (.ui-sticker__shadow)
      gradients                      -> flat fill, or vertex colours from C#
      gap, :last-child, :nth-child   -> margins on each child, a --last class
      @keyframes                     -> class ping-pong from C#
      picking-mode                   -> not USS; set it in UXML or C#
*/

/* ===================================================================
   Root and type
   =================================================================== */

/* On the root of every document. Transparent: the match draws over a
   board, and the lobby gives its own root a surface. */
.ui-root {
    flex-grow: 1;
    -unity-font-definition: var(--font-medium);
    color: var(--ink);
    font-size: var(--type-body);
}

.ui-root Label {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.ui-w500 { -unity-font-definition: var(--font-medium); -unity-font-style: normal; }
.ui-w600 { -unity-font-definition: var(--font-semibold); -unity-font-style: normal; }
.ui-w700 { -unity-font-definition: var(--font-bold); -unity-font-style: normal; }

/* A Button with every runtime-theme default removed, so its class alone
   decides how it looks. */
.ui-reset-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: var(--clear);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ===================================================================
   Shadows. A shadow is an absolutely placed sibling drawn first.
   =================================================================== */

.ui-sticker {
    position: relative;
}

.ui-sticker__shadow {
    position: absolute;
    left: 3px;
    top: 4px;
    right: -3px;
    bottom: -4px;
    background-color: var(--shadow);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-soft-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: -8px;
    background-color: var(--shadow-deep);
    filter: blur(11px);
}

/* ===================================================================
   Buttons. The big button sits on a solid lip - the prototype's
   0 5px 0 box-shadow - which is a block behind it, not a border.
   =================================================================== */

.ui-lip {
    position: relative;
}

.ui-lip__block {
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    bottom: -5px;
}

.ui-lip__block--gold { background-color: var(--action-edge); }
.ui-lip__block--green { background-color: var(--confirm-edge); }

.ui-button-wrap {
    margin-bottom: var(--space-3);
}

.ui-button-wrap > .ui-lip__block {
    top: 4px;
    bottom: -4px;
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-button {
    height: 60px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    font-size: 21px;
    transition-property: translate;
    transition-duration: var(--motion-press);
}

.ui-button:active {
    translate: 0 3px;
}

.ui-button--gold {
    background-color: var(--action);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
    color: var(--action-ink);
}

.ui-button--green {
    background-color: var(--confirm);
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    color: var(--confirm-ink);
}

.ui-button--quiet {
    background-color: var(--surface-sunk);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    color: var(--ink);
}

/* Disabled is dimmed, never recoloured grey: the label carries the reason,
   and the button must stay readable enough to say it. */
.ui-button:disabled {
    opacity: 0.55;
    translate: 0 0;
}

/* ===================================================================
   Bottom sheet. Pinned to the bottom edge by construction, so it cannot
   render off-screen. Never positioned with top: and a computed value.
   The scrim is the lobby's; the match sheet has none (settled 2026-09-02).
   =================================================================== */

.ui-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-sheet);
}

.ui-scrim--on {
    opacity: 1;
}

.ui-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: 0;
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-top-left-radius: var(--corner-sheet);
    border-top-right-radius: var(--corner-sheet);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    translate: 0 100%;
    transition-property: translate;
    transition-duration: var(--motion-sheet);
    transition-timing-function: ease-out;
}

.ui-sheet--open {
    translate: 0 0;
}

.ui-handle-hit {
    height: 33px;
    align-items: center;
}

.ui-handle {
    width: 44px;
    height: 5px;
    margin-top: var(--space-3);
    border-top-left-radius: 2.5px;
    border-top-right-radius: 2.5px;
    border-bottom-left-radius: 2.5px;
    border-bottom-right-radius: 2.5px;
    background-color: var(--ink-mute);
}

.ui-root .ui-sheet__title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-bottom: var(--space-4);
    white-space: normal;
}

.ui-root .ui-sheet__note {
    font-size: var(--type-body);
    color: var(--ink-mute);
    margin-bottom: 18px;
    white-space: normal;
}

.ui-root .ui-sheet__note--error {
    color: var(--badge);
}

/* ===================================================================
   Bar. A track and a fill; the fill's width is set from C#.
   =================================================================== */

.ui-bar {
    height: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    overflow: hidden;
}

.ui-bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
}

/* ===================================================================
   Chip. A small dark-glass pill for a readout over scenery or the board.
   Height 38, so the radius is exactly half.
   =================================================================== */

.ui-chip {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    background-color: var(--glass);
    color: var(--ink-inverse);
}

.ui-root .ui-chip__text {
    color: var(--ink-inverse);
    font-size: var(--type-body);
}

/* The chip that is also the main action of the moment. */
.ui-chip--action {
    background-color: var(--action);
    color: var(--action-ink);
}

.ui-root .ui-chip--action > .ui-chip__text {
    color: var(--action-ink);
}

/* ===================================================================
   Toast
   =================================================================== */

.ui-root .ui-toast {
    max-width: 300px;
    background-color: var(--glass-toast);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    color: var(--ink-inverse);
    font-size: var(--type-body);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 200ms;
}

.ui-root .ui-toast--on {
    opacity: 1;
    translate: 0 0;
}

/* ===================================================================
   Player mark - colour PLUS shape, always. Player 0 is a blue square
   marked 1, player 1 a red circle marked 2, nobody a grey square with a
   dash. Distinguishable in greyscale by shape alone.
   =================================================================== */

.ui-mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
}

.ui-root .ui-mark__label {
    font-size: var(--type-min);
    color: var(--mark-ink);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
}

.ui-mark--p0 {
    background-color: var(--p0);
    border-left-color: var(--p0-edge);
    border-right-color: var(--p0-edge);
    border-top-color: var(--p0-edge);
    border-bottom-color: var(--p0-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--p1 {
    background-color: var(--p1);
    border-left-color: var(--p1-edge);
    border-right-color: var(--p1-edge);
    border-top-color: var(--p1-edge);
    border-bottom-color: var(--p1-edge);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.ui-mark--unowned {
    background-color: var(--unowned);
    border-left-color: var(--unowned-edge);
    border-right-color: var(--unowned-edge);
    border-top-color: var(--unowned-edge);
    border-bottom-color: var(--unowned-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--small {
    width: 15px;
    height: 15px;
}

/* ===================================================================
   Monogram tile - the stand-in for art that does not exist. The letter
   carries the identity; the tint, hashed from the item's ID by ItemTint,
   only reinforces it. Sized by whatever contains it.
   =================================================================== */

.ui-tile {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--shadow-deep);
    border-right-color: var(--shadow-deep);
    border-top-color: var(--shadow-deep);
    border-bottom-color: var(--shadow-deep);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.ui-root .ui-tile__monogram {
    color: var(--ink-white);
    -unity-font-definition: var(--font-semibold);
    -unity-text-align: middle-center;
}

.ui-tile-tint--0 { background-color: var(--tile-tint-0); }
.ui-tile-tint--1 { background-color: var(--tile-tint-1); }
.ui-tile-tint--2 { background-color: var(--tile-tint-2); }
.ui-tile-tint--3 { background-color: var(--tile-tint-3); }
.ui-tile-tint--4 { background-color: var(--tile-tint-4); }
.ui-tile-tint--5 { background-color: var(--tile-tint-5); }
.ui-tile-tint--6 { background-color: var(--tile-tint-6); }
.ui-tile-tint--7 { background-color: var(--tile-tint-7); }

/* Shared by lobby and in-match settings. */
.lb-switch {
    width: 52px;
    height: 31px;
    flex-shrink: 0;
    border-top-left-radius: 15.5px;
    border-top-right-radius: 15.5px;
    border-bottom-left-radius: 15.5px;
    border-bottom-right-radius: 15.5px;
    background-color: var(--off);
    transition-property: background-color;
    transition-duration: var(--motion-release);
}

.lb-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 25px;
    height: 25px;
    border-top-left-radius: 12.5px;
    border-top-right-radius: 12.5px;
    border-bottom-left-radius: 12.5px;
    border-bottom-right-radius: 12.5px;
    background-color: var(--ink-white);
    transition-property: translate;
    transition-duration: var(--motion-release);
}

.lb-switch--on {
    background-color: var(--confirm);
}

.lb-switch--on > .lb-switch__knob {
    translate: 21px 0;
}


/* Paper geometry is retained by PaperCard; native fills must not cover its edge. */
.ui-root {
    --paper-card-fill: var(--paper-light);
    --paper-card-ink: var(--paper-ink);
    --paper-card-width: var(--paper-ink-width);
    --paper-card-shadow: var(--paper-shadow);
    --paper-card-shadow-x: var(--paper-shadow-x);
    --paper-card-shadow-y: var(--paper-shadow-y);
    --paper-card-wobble: var(--paper-wobble);
    --paper-card-grain: var(--paper-grain-opacity);
}
.ui-paper {
    background-color: var(--clear);
    border-color: var(--clear);
    border-radius: var(--corner-md);
}
.ui-paper--gold { --paper-card-fill: var(--paper-gold); }
.ui-paper--chip { --paper-card-fill: var(--paper-dark); border-radius: var(--corner-sm); }
.ui-paper--button:active { translate: 0 3px; --paper-card-shadow-y: 0px; }
.ui-paper-button { min-width: var(--target-min); min-height: var(--target-min); color: var(--ink); }
.ui-paper__underlay { position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; }
.ui-paper-button--gold > .ui-paper { --paper-card-fill: var(--paper-gold); }
.ui-paper-button--urgent > .ui-paper { --paper-card-fill: var(--paper-urgent); }
.ui-paper-button__caption { -unity-text-align: middle-center; white-space: normal; flex-shrink: 1; }
.ui-paper-button:active { translate: 0 3px; }
.ui-paper__swatch {
    position: absolute; width: 0; height: 0; visibility: hidden;
    background-color: var(--paper-card-fill); color: var(--paper-card-ink);
    border-left-color: var(--paper-card-shadow);
    border-left-width: var(--paper-card-width); border-right-width: var(--paper-card-shadow-x);
    border-bottom-width: var(--paper-card-shadow-y); border-top-width: var(--paper-card-wobble);
    opacity: var(--paper-card-grain);
}
/* Mockup base components. Flex child margins reproduce CSS gaps in USS. */
.mk-card, .mk-strip, .mk-tile, .mk-crate, .mk-skin { border-width: 2px; border-color: var(--mk-ink); background-color: var(--mk-card); color: var(--mk-ink); }
.mk-card { border-radius: 12px; padding: 12px; }
.mk-eyebrow { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: var(--mk-muted); }
.mk-h2 { font-size: 25.3px; -unity-font-style: bold; margin-bottom: 4px; }
.mk-h3 { font-size: 18.4px; -unity-font-style: bold; }
.mk-muted { color: var(--mk-muted); }
.mk-row, .mk-spread { flex-direction: row; align-items: center; }
.mk-row > *, .mk-spread > * { margin-right: 8px; }
.mk-spread { justify-content: space-between; }
.mk-btn { border-width: 2px; border-color: var(--mk-ink); background-color: var(--mk-sheet); color: var(--mk-ink); border-radius: 10px; padding: 9px 14px; min-height: 44px; min-width: 44px; font-size: 14px; -unity-font-style: bold; }
.mk-btn--primary, .mk-btn--gold { background-color: var(--mk-action); color: var(--mk-ink); }
.mk-btn--big { font-size: 25.3px; padding: 16px; width: 100%; letter-spacing: 0.88px; }
.mk-btn--sm { padding: 5px 10px; font-size: 12px; border-radius: 8px; }
.mk-btn:disabled, .mk-btn--disabled { opacity: 0.45; }
.mk-btn:active { background-color: var(--mk-pressed); }
.mk-chip { border-width: 2px; border-color: var(--mk-disabled); background-color: var(--clear); color: var(--mk-ink); border-radius: 22px; padding: 4px 11px; min-height: 44px; min-width: 44px; font-size: 12px; -unity-font-style: bold; }
.mk-chip--on { background-color: var(--mk-ink); color: var(--mk-sheet); border-color: var(--mk-ink); }
.mk-chip--tap { border-color: var(--mk-tap); color: var(--mk-tap); }
.mk-chip--tap.mk-chip--on { background-color: var(--mk-tap); color: var(--mk-sheet); }
.mk-seg2 { flex-direction: row; border-width: 2px; border-color: var(--mk-ink); border-radius: 26px; overflow: hidden; margin-bottom: 10px; padding: 3px; background-color: var(--mk-card); }
.mk-seg2__btn { flex-grow: 1; flex-basis: 0; border-width: 0; border-radius: 22px; background-color: var(--mk-card); padding: 9px; min-height: 44px; font-size: 18.4px; -unity-font-style: bold; }
.mk-seg2__btn--on { background-color: var(--mk-tap); color: var(--mk-sheet); }
.mk-grid { flex-direction: row; flex-wrap: wrap; margin-right: -8px; margin-bottom: -8px; }
.mk-grid > .mk-tile { width: 30%; flex-grow: 1; margin-right: 8px; margin-bottom: 8px; }
.mk-tile { position: relative; border-radius: 10px; background-color: var(--mk-sheet); padding: 6px 4px 5px; align-items: center; font-size: 12px; -unity-text-align: middle-center; }
.mk-tile > * { margin-bottom: 1px; }
.mk-tile .mk-art { width: 72%; }
.mk-tile--locked { background-color: var(--clear); }
.mk-tile--locked .mk-art { opacity: 0.4; }
.mk-mark { position: absolute; top: -6px; right: -6px; background-color: var(--mk-ink); color: var(--mk-sheet); font-size: 9px; -unity-font-style: bold; letter-spacing: 0.45px; padding: 1px 6px; border-radius: 10px; }
.mk-mark--era { background-color: var(--era-3); }
.mk-banner { border-width: 2px; border-color: var(--mk-tap); background-color: var(--mk-tap-soft); border-radius: 12px; padding: 10px 12px; margin-top: 12px; }
.mk-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 14px 0 6px; }
.mk-toolbar > *, .mk-roles > * { margin-right: 6px; }
.mk-roles { flex-direction: row; padding: 2px 0 8px; }
.mk-roles > * { flex-shrink: 0; }
.mk-sheet, .mk-bigsheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 80%; background-color: var(--mk-sheet); color: var(--mk-ink); border-top-width: 3px; border-top-color: var(--mk-ink); border-top-left-radius: 18px; border-top-right-radius: 18px; padding: 16px 14px 18px; }
.mk-bigsheet { height: 78%; max-height: 78%; border-top-left-radius: 20px; border-top-right-radius: 20px; padding: 14px 14px 12px; }
.mk-bigsheet > * { margin-bottom: 10px; }
.mk-bigsheet .mk-h2 { font-size: 27.6px; -unity-text-align: middle-center; }
.mk-handle { width: 40px; height: 5px; background-color: var(--mk-disabled); border-radius: 3px; align-self: center; margin-top: 8px; }
.mk-handle-hit { height: 44px; flex-shrink: 0; margin-top: -16px; }
.mk-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--mk-scrim); }
.mk-arr { position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 56px; border-width: 0; background-color: var(--clear); color: var(--mk-ink); padding: 0; font-size: 30px; }
.mk-arr:disabled, .mk-arr--disabled { opacity: 0.18; }
.mk-dots { flex-direction: row; justify-content: center; }
.mk-dots > * { margin-right: 10px; }
.mk-dot2 { width: 14px; height: 14px; border-radius: 7px; border-width: 2px; border-color: var(--mk-ink); background-color: var(--clear); padding: 0; }
.mk-dot2--on, .mk-dot2--f { background-color: var(--mk-ink); }
.mk-dot2--locked { border-color: var(--mk-disabled); }
.mk-dot2--cur { scale: 1.3; }
.mk-skins { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.mk-skins > * { margin-right: 10px; }
.mk-skin { width: 82px; border-radius: 10px; padding: 3px 4px; align-items: center; font-size: 10px; -unity-font-style: bold; letter-spacing: 0.4px; }
.mk-skin .mk-art { width: 40px; }
.mk-skin--on { border-color: var(--mk-tap); border-width: 5px; }
.mk-skin--locked { opacity: 0.5; }
.mk-hist { flex-shrink: 0; }
.mk-hist > * { margin-bottom: 8px; }
.mk-hrow { flex-direction: row; align-items: center; font-size: 12px; -unity-font-style: bold; letter-spacing: 0.6px; }
.mk-hrow > Label { width: 52px; margin-right: 8px; }
.mk-hrow > .mk-value { width: 56px; -unity-text-align: middle-right; }
.mk-cells { flex-direction: row; flex-grow: 1; margin-right: 8px; }
.mk-cell { flex-grow: 1; flex-basis: 0; height: 12px; margin-right: 3px; border-width: 1.5px; border-color: var(--mk-ink); border-radius: 2px; background-color: var(--clear); font-size: 9px; color: var(--mk-disabled); -unity-text-align: middle-center; }
.mk-cell--f { background-color: var(--mk-ink); }
.mk-cell--g { background-color: var(--mk-tap); border-color: var(--mk-tap); }
.mk-cell--t { background-color: var(--mk-urgent); border-color: var(--mk-urgent); }
.mk-crate { width: 76px; height: 76px; border-radius: 14px; padding: 6px 6px 14px; align-items: center; justify-content: center; }
.mk-cbadge { position: absolute; top: -9px; right: -9px; min-width: 26px; height: 26px; padding: 0 5px; border-radius: 13px; background-color: var(--mk-urgent); color: var(--mk-sheet); border-width: 2px; border-color: var(--mk-ink); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.mk-battle { width: 100%; border-width: 2px; border-bottom-width: 8px; border-color: var(--mk-ink); border-radius: 16px; background-color: var(--mk-action); color: var(--mk-ink); font-size: 34.5px; -unity-font-style: bold; letter-spacing: 3px; padding: 14px; min-height: 44px; }
.mk-battle--off { opacity: 0.5; }
.mk-battle:active { translate: 0 4px; border-bottom-width: 4px; }
.mk-friend { flex-direction: row; align-items: center; padding: 8px 0; border-bottom-width: 1.5px; border-bottom-color: var(--mk-disabled); min-height: 44px; }
.mk-friend > * { margin-right: 10px; }
.mk-friend__avatar { width: 34px; height: 34px; border-radius: 8px; border-width: 2px; border-color: var(--mk-ink); background-color: var(--p0); font-size: 17.25px; -unity-font-style: bold; -unity-text-align: middle-center; }
.mk-friend__body { flex-grow: 1; min-width: 0; }
.mk-friend__name { font-size: 17.25px; -unity-font-style: bold; }
.mk-friend__status { flex-direction: row; align-items: center; color: var(--mk-muted); font-size: 12px; }
.mk-friend__dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--mk-tap); margin-right: 5px; }
.mk-friend__trailing { flex-direction: row; align-items: center; }
.mk-topbar { flex-direction: row; align-items: center; padding: 10px 12px 8px; flex-shrink: 0; min-height: 52px; }
.mk-topbar > * { margin-right: 8px; }
.mk-purse { flex-direction: row; align-items: center; padding: 7px 14px; border-width: 0; border-radius: 22px; min-height: 44px; min-width: 44px; background-color: var(--mk-dark); color: var(--mk-sheet); font-size: 14px; -unity-font-style: bold; }
.mk-purse > * { margin-right: 7px; color: var(--mk-sheet); }
.mk-purse__dot--coin, .mk-purse__dot--leaf { width: 14px; height: 14px; border-radius: 7px; border-width: 2px; border-color: var(--mk-sheet); background-color: var(--mk-coin); }
.mk-purse__dot--leaf { width: 16px; height: 16px; border-radius: 2px 14px 2px 14px; rotate: -12deg; background-color: var(--mk-leaf); }
.mk-rbtn { width: 44px; height: 44px; min-width: 44px; flex-shrink: 0; border-radius: 22px; border-width: 0; background-color: var(--mk-dark); color: var(--mk-sheet); padding: 0; align-items: center; justify-content: center; font-size: 29.9px; }
.mk-rbtn .lb-icon { width: 24px; height: 24px; -unity-background-image-tint-color: var(--mk-sheet); }
.mk-strip { margin: 0 10px 8px; padding: 8px 12px 9px; border-bottom-width: 5px; border-radius: 12px; flex-shrink: 0; }
.mk-namelink { flex-direction: row; flex-grow: 1; align-items: center; background-color: var(--clear); border-width: 0; padding: 0; min-height: 44px; font-size: 19.55px; -unity-font-style: bold; color: var(--mk-ink); }
.mk-namelink > * { margin-right: 6px; }
.mk-trophy { flex-direction: row; color: var(--mk-trophy); font-size: 19.55px; -unity-font-style: bold; }
.mk-meter { height: 6px; border-width: 2px; border-color: var(--mk-ink); border-radius: 4px; overflow: hidden; background-color: var(--mk-track); }
.mk-meter > * { height: 100%; background-color: var(--mk-ink); }
.mk-meter--thin { height: 8px; margin: 5px 0 3px; }
.mk-cap { font-size: 12px; color: var(--mk-muted); }
.mk-tabs { flex-direction: row; margin: 6px 12px 10px; border-width: 2px; border-color: var(--mk-ink); border-radius: 32px; padding: 4px; background-color: var(--mk-card); }
.mk-tab { position: relative; flex-grow: 1; flex-basis: 0; min-width: 44px; min-height: 44px; border-width: 0; border-radius: 26px; padding: 6px 2px 5px; margin-right: 4px; align-items: center; background-color: var(--clear); color: var(--mk-muted); font-size: 11px; -unity-font-style: bold; letter-spacing: 0.33px; }
.mk-tab .lb-icon { width: 22px; height: 22px; margin-bottom: 3px; -unity-background-image-tint-color: var(--mk-muted); }
.mk-tab--on { background-color: var(--mk-tap); color: var(--mk-sheet); }
.mk-tab--on .lb-icon { -unity-background-image-tint-color: var(--mk-sheet); }
.mk-tab__badge { position: absolute; top: 5px; right: 10px; width: 11px; height: 11px; border-radius: 6px; background-color: var(--mk-urgent); border-width: 2px; border-color: var(--mk-card); }
