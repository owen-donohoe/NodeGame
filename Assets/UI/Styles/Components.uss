/*
    Node War - shared components.

    The pieces both scenes draw the same way: type, buttons, the bottom
    sheet, bars, chips, the toast, player marks and monogram tiles. Loaded
    through UnityDefaultRuntimeTheme.tss after Tokens.uss, so every panel has
    them and a page stylesheet only adds what is particular to it.

    Classes are prefixed ui-. Page stylesheets keep their own prefixes (lb-
    in the lobby shell, hud__ in the match), so a shared rule and a page rule
    never share a name.

    Rules here read meaning tokens only, never --pal-*.

    PRECEDENCE. These rules arrive through the panel theme, and a theme rule
    loses to ANY rule in a stylesheet a layout imports, whatever the
    specificity (measured in 6000.5.9f1). So a page overrides a component with
    a plain single-class rule - and the .ui-root Label reset below yields to
    any page rule that sets a label's margin or padding. Set those only where
    the spacing is meant.

    Measured against 6000.5.9f1, where the prototypes use CSS that USS lacks:
      box-shadow, drop-shadow        -> a sibling element behind (.ui-sticker__shadow)
      gradients                      -> flat fill, or vertex colours from C#
      gap, :last-child, :nth-child   -> margins on each child, a --last class
      @keyframes                     -> class ping-pong from C#
      picking-mode                   -> not USS; set it in UXML or C#
*/

/* ===================================================================
   Root and type
   =================================================================== */

/* On the root of every document. Transparent: the match draws over a
   board, and the lobby gives its own root a surface. */
.ui-root {
    flex-grow: 1;
    -unity-font-definition: var(--font-medium);
    color: var(--ink);
    font-size: var(--type-body);
}

.ui-root Label {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.ui-w500 { -unity-font-definition: var(--font-medium); -unity-font-style: normal; }
.ui-w600 { -unity-font-definition: var(--font-semibold); -unity-font-style: normal; }
.ui-w700 { -unity-font-definition: var(--font-bold); -unity-font-style: normal; }

/* A Button with every runtime-theme default removed, so its class alone
   decides how it looks. */
.ui-reset-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: var(--clear);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ===================================================================
   Shadows. A shadow is an absolutely placed sibling drawn first.
   =================================================================== */

.ui-sticker {
    position: relative;
}

.ui-sticker__shadow {
    position: absolute;
    left: 3px;
    top: 4px;
    right: -3px;
    bottom: -4px;
    background-color: var(--shadow);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-soft-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: -8px;
    background-color: var(--shadow-deep);
    filter: blur(11px);
}

/* ===================================================================
   Buttons. The big button sits on a solid lip - the prototype's
   0 5px 0 box-shadow - which is a block behind it, not a border.
   =================================================================== */

.ui-lip {
    position: relative;
}

.ui-lip__block {
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    bottom: -5px;
}

.ui-lip__block--gold { background-color: var(--action-edge); }
.ui-lip__block--green { background-color: var(--confirm-edge); }

.ui-button-wrap {
    margin-bottom: var(--space-3);
}

.ui-button-wrap > .ui-lip__block {
    top: 4px;
    bottom: -4px;
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-button {
    height: 60px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    font-size: 21px;
    transition-property: translate;
    transition-duration: var(--motion-press);
}

.ui-button:active {
    translate: 0 3px;
}

.ui-button--gold {
    background-color: var(--action);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
    color: var(--action-ink);
}

.ui-button--green {
    background-color: var(--confirm);
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    color: var(--confirm-ink);
}

.ui-button--quiet {
    background-color: var(--surface-sunk);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    color: var(--ink);
}

/* Disabled is dimmed, never recoloured grey: the label carries the reason,
   and the button must stay readable enough to say it. */
.ui-button:disabled {
    opacity: 0.55;
    translate: 0 0;
}

/* ===================================================================
   Bottom sheet. Pinned to the bottom edge by construction, so it cannot
   render off-screen. Never positioned with top: and a computed value.
   The scrim is the lobby's; the match sheet has none (settled 2026-09-02).
   =================================================================== */

.ui-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-sheet);
}

.ui-scrim--on {
    opacity: 1;
}

.ui-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: 0;
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-top-left-radius: var(--corner-sheet);
    border-top-right-radius: var(--corner-sheet);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    translate: 0 100%;
    transition-property: translate;
    transition-duration: var(--motion-sheet);
    transition-timing-function: ease-out;
}

.ui-sheet--open {
    translate: 0 0;
}

.ui-handle-hit {
    height: 33px;
    align-items: center;
}

.ui-handle {
    width: 44px;
    height: 5px;
    margin-top: var(--space-3);
    border-top-left-radius: 2.5px;
    border-top-right-radius: 2.5px;
    border-bottom-left-radius: 2.5px;
    border-bottom-right-radius: 2.5px;
    background-color: var(--ink-mute);
}

.ui-root .ui-sheet__title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-bottom: var(--space-4);
    white-space: normal;
}

.ui-root .ui-sheet__note {
    font-size: var(--type-body);
    color: var(--ink-mute);
    margin-bottom: 18px;
    white-space: normal;
}

.ui-root .ui-sheet__note--error {
    color: var(--badge);
}

/* ===================================================================
   Bar. A track and a fill; the fill's width is set from C#.
   =================================================================== */

.ui-bar {
    height: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    overflow: hidden;
}

.ui-bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
}

/* ===================================================================
   Chip. A small dark-glass pill for a readout over scenery or the board.
   Height 38, so the radius is exactly half.
   =================================================================== */

.ui-chip {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    background-color: var(--glass);
    color: var(--ink-inverse);
}

.ui-root .ui-chip__text {
    color: var(--ink-inverse);
    font-size: var(--type-body);
}

/* The chip that is also the main action of the moment. */
.ui-chip--action {
    background-color: var(--action);
    color: var(--action-ink);
}

.ui-root .ui-chip--action > .ui-chip__text {
    color: var(--action-ink);
}

/* ===================================================================
   Toast
   =================================================================== */

.ui-root .ui-toast {
    max-width: 300px;
    background-color: var(--glass-toast);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    color: var(--ink-inverse);
    font-size: var(--type-body);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 200ms;
}

.ui-root .ui-toast--on {
    opacity: 1;
    translate: 0 0;
}

/* ===================================================================
   Player mark - colour PLUS shape, always. Player 0 is a blue square
   marked 1, player 1 a red circle marked 2, nobody a grey square with a
   dash. Distinguishable in greyscale by shape alone.
   =================================================================== */

.ui-mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
}

.ui-root .ui-mark__label {
    font-size: var(--type-min);
    color: var(--mark-ink);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
}

.ui-mark--p0 {
    background-color: var(--p0);
    border-left-color: var(--p0-edge);
    border-right-color: var(--p0-edge);
    border-top-color: var(--p0-edge);
    border-bottom-color: var(--p0-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--p1 {
    background-color: var(--p1);
    border-left-color: var(--p1-edge);
    border-right-color: var(--p1-edge);
    border-top-color: var(--p1-edge);
    border-bottom-color: var(--p1-edge);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.ui-mark--unowned {
    background-color: var(--unowned);
    border-left-color: var(--unowned-edge);
    border-right-color: var(--unowned-edge);
    border-top-color: var(--unowned-edge);
    border-bottom-color: var(--unowned-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--small {
    width: 15px;
    height: 15px;
}

/* ===================================================================
   Monogram tile - the stand-in for art that does not exist. The letter
   carries the identity; the tint, hashed from the item's ID by ItemTint,
   only reinforces it. Sized by whatever contains it.
   =================================================================== */

.ui-tile {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--shadow-deep);
    border-right-color: var(--shadow-deep);
    border-top-color: var(--shadow-deep);
    border-bottom-color: var(--shadow-deep);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.ui-root .ui-tile__monogram {
    color: var(--ink-white);
    -unity-font-definition: var(--font-semibold);
    -unity-text-align: middle-center;
}

.ui-tile-tint--0 { background-color: var(--tile-tint-0); }
.ui-tile-tint--1 { background-color: var(--tile-tint-1); }
.ui-tile-tint--2 { background-color: var(--tile-tint-2); }
.ui-tile-tint--3 { background-color: var(--tile-tint-3); }
.ui-tile-tint--4 { background-color: var(--tile-tint-4); }
.ui-tile-tint--5 { background-color: var(--tile-tint-5); }
.ui-tile-tint--6 { background-color: var(--tile-tint-6); }
.ui-tile-tint--7 { background-color: var(--tile-tint-7); }

/* Shared by lobby and in-match settings. */
.lb-switch {
    width: 52px;
    height: 31px;
    flex-shrink: 0;
    border-top-left-radius: 15.5px;
    border-top-right-radius: 15.5px;
    border-bottom-left-radius: 15.5px;
    border-bottom-right-radius: 15.5px;
    background-color: var(--off);
    transition-property: background-color;
    transition-duration: var(--motion-release);
}

.lb-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 25px;
    height: 25px;
    border-top-left-radius: 12.5px;
    border-top-right-radius: 12.5px;
    border-bottom-left-radius: 12.5px;
    border-bottom-right-radius: 12.5px;
    background-color: var(--ink-white);
    transition-property: translate;
    transition-duration: var(--motion-release);
}

.lb-switch--on {
    background-color: var(--confirm);
}

.lb-switch--on > .lb-switch__knob {
    translate: 21px 0;
}


/* Paper geometry is retained by PaperCard; native fills must not cover its edge. */
.ui-root {
    --paper-card-fill: var(--paper-light);
    --paper-card-ink: var(--paper-ink);
    --paper-card-width: var(--paper-ink-width);
    --paper-card-shadow: var(--paper-shadow);
    --paper-card-shadow-x: var(--paper-shadow-x);
    --paper-card-shadow-y: var(--paper-shadow-y);
    --paper-card-wobble: var(--paper-wobble);
    --paper-card-grain: var(--paper-grain-opacity);
}
.ui-paper {
    background-color: var(--clear);
    border-color: var(--clear);
    border-radius: var(--corner-md);
}
.ui-paper--gold { --paper-card-fill: var(--paper-gold); }
.ui-paper--chip { --paper-card-fill: var(--paper-dark); border-radius: var(--corner-sm); }
.ui-paper--button:active { translate: 0 3px; --paper-card-shadow-y: 0px; }
.ui-paper-button { min-width: var(--target-min); min-height: var(--target-min); color: var(--ink); }
.ui-paper__underlay { position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; }
.ui-paper-button--gold > .ui-paper { --paper-card-fill: var(--paper-gold); }
.ui-paper-button--urgent > .ui-paper { --paper-card-fill: var(--paper-urgent); }
.ui-paper-button__caption { -unity-text-align: middle-center; white-space: normal; flex-shrink: 1; }
.ui-paper-button:active { translate: 0 3px; }
.ui-paper__swatch {
    position: absolute; width: 0; height: 0; visibility: hidden;
    background-color: var(--paper-card-fill); color: var(--paper-card-ink);
    border-left-color: var(--paper-card-shadow);
    border-left-width: var(--paper-card-width); border-right-width: var(--paper-card-shadow-x);
    border-bottom-width: var(--paper-card-shadow-y); border-top-width: var(--paper-card-wobble);
    opacity: var(--paper-card-grain);
}
/* Approved panel language. Shared mk components are lobby surfaces. */
.lb-root { -unity-font-definition: var(--font-body); -unity-text-outline-width: 0; }
.lb-root Label, .lb-root Button, .lb-root TextField { letter-spacing: var(--tracking); -unity-font-style: normal; -unity-text-outline-width: 0; }
.mk-card, .mk-strip, .mk-panel { border-width: 2px; border-bottom-width: var(--edge-panel-bottom); border-color: var(--line-outer); border-radius: var(--radius-panel); padding: 12px; background-color: var(--mk-card); color: var(--mk-ink); }
.mk-row, .mk-spread { flex-direction: row; align-items: center; }
.mk-row > *, .mk-spread > * { margin-right: 8px; }
.mk-spread { justify-content: space-between; }
.mk-h2, .mk-h3, .mk-number, .mk-trophy, .mk-namelink, .mk-purse, .mk-battle, .mk-cbadge, .mk-tab-label, .mk-friend__name, .mk-friend__avatar, .mk-avatar { -unity-font-definition: var(--font-display); }
.mk-h2 { font-size: 24px; min-height: 32px; margin-bottom: 4px; }
.mk-h3 { font-size: 17px; min-height: 24px; }
.mk-number { font-size: 22px; min-height: 28px; }
.mk-body, .mk-label { font-size: 16px; min-height: 20px; }
.mk-secondary { font-size: 15px; min-height: 20px; }
.mk-caption, .mk-cap, .mk-muted, .mk-eyebrow, .mk-friend__status { font-size: 13px; min-height: 16px; -unity-font-definition: var(--font-body); color: var(--mk-muted); }
.mk-eyebrow { letter-spacing: var(--tracking); }
.mk-ellipsis, .mk-friend__name, .mk-namelink Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex-shrink: 1; }
.mk-btn, .mk-tile, .mk-crate, .mk-skin { border-width: 2px; border-bottom-width: var(--edge-press-bottom); border-color: var(--line-inner); border-radius: var(--radius-button); background-color: var(--mk-sheet); color: var(--mk-ink); padding: 8px 12px; min-height: 44px; min-width: 44px; -unity-font-definition: var(--font-display); font-size: 15px; }
.mk-btn:active, .mk-tile:active, .mk-skin:active, .mk-crate:active { border-bottom-width: 2px; }
.mk-btn--primary, .mk-btn--gold { background-color: var(--mk-action); }
.mk-btn--urgent { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.mk-btn--big { font-size: 24px; padding: 16px; width: 100%; }
.mk-btn--sm { padding: 4px 8px; font-size: 15px; }
.mk-btn:disabled, .mk-btn--disabled, .mk-chip:disabled, .mk-chip--disabled, .mk-seg2__btn:disabled, .mk-seg2__btn--disabled, .mk-friend--disabled { opacity: 0.45; }
.mk-chip { border-width: 0; border-radius: 8px; background-color: var(--mk-pressed); color: var(--mk-ink); padding: 4px 12px; min-height: 44px; min-width: 44px; font-size: 15px; -unity-font-definition: var(--font-display); }
.mk-chip--on, .mk-chip--tap.mk-chip--on { background-color: var(--mk-action); color: var(--mk-ink); }
.mk-seg2 { flex-direction: row; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-outer); border-radius: 12px; padding: 4px; background-color: var(--mk-sheet); }
.mk-seg2__track { flex-direction: row; flex-grow: 1; padding: 4px; border-radius: 8px; background-color: var(--mk-pressed); }
.mk-seg2__btn { flex-grow: 1; flex-basis: 0; margin: 0; border-width: 0; border-bottom-width: 3px; border-bottom-color: var(--clear); border-radius: 8px; background-color: var(--clear); color: var(--mk-muted); min-height: 44px; padding: 4px 8px; font-size: 15px; -unity-font-definition: var(--font-display); }
.mk-seg2__btn--on { background-color: var(--mk-sheet); border-bottom-color: var(--line-light); color: var(--mk-ink); }
.mk-page-title { -unity-font-definition: var(--font-display); font-size: 34px; min-height: 44px; color: var(--mk-sheet); -unity-text-outline-width: 2px; -unity-text-outline-color: var(--line-outer); -unity-text-align: middle-center; }
.mk-ledger { padding: 0; overflow: hidden; }
.mk-ledger__header { flex-direction: row; justify-content: space-between; align-items: center; padding: 8px 12px; background-color: var(--mk-pressed); border-bottom-width: 2px; border-bottom-color: var(--line-inner); font-size: 17px; -unity-font-definition: var(--font-display); min-height: 40px; }
.mk-ledger__meta { font-size: 13px; -unity-font-definition: var(--font-body); color: var(--mk-muted); }
.mk-ledger__row, .mk-friend { flex-direction: row; align-items: center; height: 56px; min-height: 56px; padding: 8px 12px; margin: 0; border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--mk-hairline); border-radius: 0; background-color: var(--clear); color: var(--mk-ink); }
.mk-friend > * { margin-right: 8px; }
.mk-friend__avatar, .mk-avatar { width: 40px; height: 40px; min-height: 40px; flex-shrink: 0; border-radius: 10px; background-color: var(--mk-pressed); font-size: 18px; -unity-text-align: middle-center; }
.mk-friend__body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mk-friend__name { font-size: 17px; min-height: 20px; }
.mk-friend__status, .mk-friend__trailing { flex-direction: row; align-items: center; }
.mk-friend__dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--mk-tap); margin-right: 4px; }
.mk-grid { flex-direction: row; flex-wrap: wrap; }
.mk-tile { position: relative; border-radius: 10px; padding: 8px; align-items: center; -unity-text-align: middle-center; }
.mk-tile > * { margin-bottom: 4px; }
.mk-tile--locked .mk-art { opacity: 0.4; }
.mk-tile--selected { border-color: var(--mk-tap); }
.mk-mark { position: absolute; top: 4px; right: 4px; background-color: var(--mk-ink); color: var(--mk-sheet); font-size: 13px; padding: 0 4px; border-radius: 8px; }
.mk-mark--era { background-color: var(--era-3); }
.mk-banner { background-color: var(--mk-pressed); border-radius: 12px; padding: 12px; margin-top: 12px; }
.mk-toolbar, .mk-roles { flex-direction: row; align-items: center; }
.mk-toolbar > *, .mk-roles > * { margin-right: 8px; }
.mk-roles > * { flex-shrink: 0; }
.mk-sheet, .mk-bigsheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 80%; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px 14px 0 0; background-color: var(--mk-card); color: var(--mk-ink); padding: 16px 12px; }
.mk-bigsheet { height: 78%; max-height: 78%; padding: 12px; }
.mk-bigsheet .mk-h2 { -unity-text-align: middle-center; }
.mk-handle { width: 44px; height: 5px; background-color: var(--line-light); border-radius: 3px; align-self: center; margin-top: 8px; }
.mk-handle-hit { height: 44px; flex-shrink: 0; margin-top: -16px; }
.mk-bigsheet > .mk-handle-hit { margin-top: -12px; }
.mk-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--mk-scrim); }
.mk-arr { position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 44px; border-width: 2px; border-color: var(--line-inner); border-radius: 22px; background-color: var(--mk-dark); color: var(--mk-sheet); padding: 0; font-size: 24px; }
.mk-arr:disabled, .mk-arr--disabled { opacity: 0.45; }
.mk-dots { flex-direction: row; justify-content: center; }
.mk-dots > * { margin-right: 8px; }
.mk-dot2 { width: 8px; height: 8px; min-width: 8px; min-height: 8px; border-radius: 4px; border-width: 0; background-color: var(--mk-disabled); padding: 0; margin-top: 0; margin-bottom: 0; }
.mk-dot2--on, .mk-dot2--f { width: 20px; background-color: var(--mk-ink); }
.mk-dot2--locked { opacity: 0.5; }
.mk-skins { flex-direction: row; align-items: center; flex-shrink: 0; }
.mk-skins > * { margin-right: 8px; }
.mk-skin { width: 52px; height: 52px; flex-shrink: 0; border-radius: 10px; padding: 4px; align-items: center; justify-content: center; }
.mk-skin--on { border-color: var(--mk-tap); }
.mk-skin--locked { background-color: var(--mk-pressed); opacity: 0.7; }
.mk-hist { flex-shrink: 0; }
.mk-hist > * { margin-bottom: 8px; }
.mk-hrow { flex-direction: row; align-items: center; font-size: 13px; }
.mk-cells { flex-direction: row; flex-grow: 1; }
.mk-cell { flex-grow: 1; flex-basis: 0; min-width: 0; height: 16px; margin-right: 4px; border-width: 2px; border-color: var(--line-light); border-radius: 3px; background-color: var(--mk-pressed); }
.mk-cell--f { background-color: var(--line-inner); border-color: var(--line-inner); }
.mk-cell--g { background-color: var(--confirm); border-color: var(--confirm); }
.mk-cell--t { background-color: var(--clear); border-color: var(--mk-urgent); }
.mk-crate { width: 76px; height: 76px; border-color: var(--line-outer); border-radius: 14px; padding: 4px 4px 12px; align-items: center; justify-content: center; }
.mk-crate--dim { opacity: 0.6; }
.mk-cbadge { position: absolute; top: -8px; right: -8px; min-width: 32px; height: 32px; padding: 0 4px; border-radius: 16px; background-color: var(--mk-urgent); color: var(--mk-sheet); border-width: 2px; border-color: var(--line-outer); font-size: 22px; -unity-text-align: middle-center; }
.mk-battle { width: 100%; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 12px; background-color: var(--mk-action); color: var(--mk-ink); font-size: 32px; padding: 12px; min-height: 44px; }
.mk-battle--off { opacity: 0.5; }
.mk-battle:active { border-bottom-width: 2px; }
.mk-topbar { flex-direction: row; align-items: center; padding: 8px 12px; flex-shrink: 0; min-height: 52px; }
.mk-topbar > * { margin-right: 8px; }
.mk-purse { flex-direction: row; align-items: center; padding: 8px 12px; border-width: 2px; border-color: var(--line-outer); border-radius: 22px; min-height: 44px; min-width: 44px; flex-shrink: 1; background-color: var(--mk-dark); color: var(--mk-sheet); font-size: 16px; }
.mk-purse > * { margin-right: 8px; color: var(--mk-sheet); }
.mk-purse > .mk-number { min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 16px; }
.mk-purse__dot--coin, .mk-purse__dot--leaf { width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: var(--mk-sheet); background-color: var(--mk-coin); }
.mk-purse__dot--leaf { border-radius: 2px 12px 2px 12px; background-color: var(--mk-leaf); }
.mk-rbtn { width: 44px; height: 44px; min-width: 44px; flex-shrink: 0; border-radius: 22px; border-width: 2px; border-color: var(--line-outer); background-color: var(--mk-dark); color: var(--mk-sheet); padding: 0; align-items: center; justify-content: center; }
.mk-rbtn .lb-icon { width: 24px; height: 24px; -unity-background-image-tint-color: var(--mk-sheet); }
.mk-strip { margin: 0 12px 8px; flex-shrink: 0; }
.mk-namelink { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 44px; align-items: center; background-color: var(--clear); border-width: 0; padding: 0; font-size: 22px; color: var(--mk-ink); }
.mk-namelink > * { margin-right: 4px; }
.mk-trophy { flex-direction: row; color: var(--mk-trophy); font-size: 22px; }
.mk-meter { height: 8px; border-width: 2px; border-color: var(--line-inner); border-radius: 4px; overflow: hidden; background-color: var(--mk-track); }
.mk-meter > * { height: 100%; background-color: var(--mk-ink); }
.mk-meter--thin { height: 8px; margin: 4px 0; }
.mk-tabs { flex-direction: row; margin: 4px 12px 8px; border-width: 2px; border-color: var(--line-outer); border-radius: 32px; padding: 4px; background-color: var(--mk-dark); }
.mk-tab { position: relative; flex-grow: 1; flex-basis: 0; min-width: 44px; min-height: 64px; border-width: 2px; border-color: var(--clear); border-radius: 26px; padding: 4px; margin-right: 8px; align-items: center; background-color: var(--clear); color: var(--mk-pressed); font-size: 13px; }
.mk-tab--last { margin-right: 0; }
.mk-tab .lb-icon { width: 22px; height: 22px; margin-bottom: 4px; -unity-background-image-tint-color: var(--mk-pressed); }
.mk-tab--on { background-color: var(--mk-action); border-color: var(--line-outer); color: var(--mk-ink); }
.mk-tab--on .lb-icon { -unity-background-image-tint-color: var(--mk-ink); }
.mk-tab-label { font-size: 13px; }
.mk-tab__badge { position: absolute; top: 4px; right: 8px; width: 12px; height: 12px; border-radius: 6px; background-color: var(--mk-urgent); border-width: 2px; border-color: var(--line-outer); }
.mk-panel-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 12px; align-items: center; justify-content: center; }
.mk-panel { width: 340px; max-width: 100%; max-height: 80%; flex-shrink: 1; overflow: hidden; }
.mk-panel__header { flex-direction: row; align-items: center; height: 44px; flex-shrink: 0; margin-bottom: 12px; }
.mk-panel__header > .mk-h2 { flex-grow: 1; margin-right: 8px; margin-bottom: 0; }
.mk-panel__close { width: 44px; height: 44px; flex-shrink: 0; padding: 0; }
.mk-panel__body { min-height: 0; flex-shrink: 1; overflow: hidden; }
.mk-panel__body > Button { margin-top: 8px; }
.mk-panel-list { flex-shrink: 1; min-height: 0; }
.mk-panel-list Button { margin-bottom: 8px; }
.mk-sheet > ScrollView > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > .mk-btn { margin-bottom: 8px; }

/* Page geometry, consolidated from the earlier lobby passes. */
#page-workshop { flex-grow: 1; min-height: 0; }
#page-workshop > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-workshop { flex-grow: 1; min-height: 0; }
.ws-scroll { flex-grow: 1; min-height: 0; }
.ws-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: var(--space-3); }
.ws-stage-spacer { height: 220px; flex-shrink: 0; }
.ws-panel1-space { height: 136px; flex-shrink: 0; }
.ws-panel1 { position: absolute; left: 16px; right: 16px; flex-shrink: 0; }
.ws-panel2 { position: absolute; left: 0; right: 0; margin: var(--space-3) var(--space-4) 0; flex-shrink: 0; }
.ws-panel2-space { flex-shrink: 0; }
.ws-panel2-clip { position: absolute; left: 0; right: 0; overflow: hidden; }
.ws-presets { margin-bottom: var(--space-3); }
.ws-presets .ws-preset-tabs { flex-shrink: 0; }
.ws-preset { width: 44px; height: 44px; padding: 0; align-items: center; justify-content: center; }
.ws-preset-face { width: 32px; height: 32px; min-width: 32px; min-height: 32px; padding: 0; -unity-text-align: middle-center; }
.ws-eyebrow { flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-text-align: middle-right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ws-browser-title { flex-grow: 1; }
.ws-roles-scroll { flex-shrink: 0; }
.ws-actionbar { margin-top: var(--space-3); }
#page-workshop .ws-cards { margin-right: 0; margin-bottom: 0; }
.ws-art-clip { height: 64px; align-items: stretch; justify-content: center; }
.ws-art { flex-grow: 1; align-items: center; justify-content: center; }
.ws-empty { width: 100%; padding: var(--space-3); }
.ws-item-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ws-item-content > * { margin-bottom: var(--space-3); }
.ws-item-art { height: 152px; flex-shrink: 0; align-items: center; justify-content: center; }
.ws-artbox { width: 180px; height: 152px; flex-shrink: 0; }
.ws-artbox .ws-art-clip { width: 100%; height: 100%; }
.ws-arr-prev { left: 0; }
.ws-arr-next { right: 0; }
.ws-stat-label { white-space: normal; }
.ws-description { white-space: normal; }
.ws-item-status { white-space: normal; }
.ws-sheet-actions { flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.ws-sheet-actions > Button { width: 45%; }
.ui-root #page-workshop Button { min-height: 44px; min-width: 44px; padding: var(--space-2) var(--space-3); }
.ui-root .ws-item-sheet Button { min-height: 44px; min-width: 44px; padding: var(--space-2) var(--space-3); }
.ui-root #page-workshop .ws-mark { top: 4px; right: 4px; padding: 0 var(--space-1); }
.ui-root #page-workshop .ws-preset { padding: 0; }
.ui-root #page-workshop #workshop-tab-suits { margin-right: 0; }
.ui-root #page-workshop .mk-toolbar { margin: var(--space-3) 0 var(--space-2); }
.ui-root #page-workshop .mk-toolbar > * { margin-right: var(--space-2); }
.ui-root #page-workshop .mk-roles > * { margin-right: var(--space-2); }
.ui-root #page-workshop .ws-browser-title { width: 100%; margin-bottom: var(--space-2); }
.ui-root #page-workshop .mk-roles { padding: var(--space-1) 0 var(--space-2); }
.ui-root #page-workshop .mk-banner { padding: var(--space-3); }
.ui-root .ws-item-sheet { padding: var(--space-3); }
.ui-root .ws-item-sheet > * { margin-bottom: var(--space-3); }
.ui-root .ws-item-sheet .ws-sheet-actions { margin-bottom: 0; }
.ui-root .ws-item-sheet .ws-sheet-actions > Button { width: 48%; }
.ui-root .ws-item-sheet .mk-skins > * { margin-right: var(--space-2); }
.ui-root .ws-item-sheet .mk-skin { width: 80px; min-height: 80px; padding: var(--space-1); }
.ui-root .ws-item-sheet .ws-stat-label { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: var(--space-2); white-space: normal; }
.ui-root .ws-item-sheet .ws-stat-row { flex-direction: column; align-items: stretch; margin-bottom: var(--space-3); }
.ws-stat-heading { flex-direction: row; align-items: center; margin-bottom: var(--space-1); }
.ui-root .ws-item-sheet .ws-stat-value { flex-shrink: 0; -unity-text-align: middle-right; }
.ui-root .ws-item-sheet .mk-arr { padding: 0; }
.g2-social-scroll { flex-grow: 1; min-height: 0; padding: var(--space-3); }
.ui-root .g2-social-card { margin-bottom: var(--space-3); }
.g2-live-row { flex-direction: row; align-items: center; margin-bottom: var(--space-2); }
.g2-online-dot { width: 10px; height: 10px; }
.g2-history-row { flex-direction: row; align-items: center; margin-top: var(--space-2); }
.ui-root .g2-result-badge { width: 24px; height: 24px; margin-right: var(--space-1); -unity-text-align: middle-center; }
.ui-root .g2-history-name { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 0; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.g2-rr-delta { flex-shrink: 0; -unity-text-align: middle-right; }
#page-guild { flex-grow: 1; min-height: 0; padding: 0; }
#page-guild > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-guild-state { flex-grow: 1; min-height: 0; }
.lb-guild-membership { flex-grow: 1; min-height: 0; }
.lb-guild-membership-content { flex-grow: 1; min-height: 0; }
.lb-guild-visitor { flex-grow: 1; min-height: 0; }
.lb-guild-search-anchor { margin-top: var(--space-2); margin-left: var(--space-3); margin-right: var(--space-3); }
.lb-guild-visitor--searched .lb-guild-search-anchor { margin-top: var(--space-2); }
.lb-guild-search { flex-direction: row; align-items: center; }
.lb-guild-search TextField { flex-grow: 1; min-width: 0; margin-right: var(--space-2); }
.lb-guild-search .unity-base-field__label { display: none; }
.lb-guild-searchbtn { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.lb-guild-filterbtn { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; margin-left: var(--space-2); }
.lb-guild-browse-toggle { width: 44px; min-height: 44px; align-self: center; margin-top: var(--space-2); }
.lb-guild-results { flex-grow: 1; min-height: 0; padding: var(--space-3); }
.lb-guild-card { margin-bottom: var(--space-3); }
.lb-guild-line { flex-direction: row; align-items: center; min-height: 44px; }
.lb-guild-row-text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: var(--space-2); margin-right: var(--space-2); }
.lb-guild-emblem { width: 40px; height: 40px; flex-shrink: 0; }
.lb-guild-header { margin-bottom: var(--space-2); }
.lb-guild-header .mk-meter { margin-top: var(--space-2); margin-bottom: var(--space-1); }
.lb-guild-header .mk-meter__fill { height: 100%; }
.lb-guild-home { flex-grow: 1; min-height: 0; padding: var(--space-3); }
.lb-guild-home-scroll { flex-grow: 1; min-height: 0; padding-bottom: var(--space-6); }
.lb-guild-post { padding-top: var(--space-2); padding-bottom: var(--space-2); }
.lb-guild-sort { min-height: 44px; }
.lb-guild-chat-button { position: absolute; right: 16px; bottom: 16px; min-width: 96px; min-height: 56px; flex-direction: row; align-items: center; justify-content: center; }
.lb-guild-sheet { flex-grow: 1; min-height: 0; padding: 0; }
.lb-guild-sheet .unity-base-field { margin-bottom: var(--space-3); min-height: 44px; }
.lb-guild-panel-members { max-height: 320px; min-height: 64px; flex-shrink: 1; margin-top: var(--space-3); margin-bottom: var(--space-3); }
.lb-guild-chat { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-guild-report { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-guild-chat > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-guild-chat-safe { flex-grow: 1; padding: var(--space-4); min-height: 0; }
.lb-guild-report-safe { flex-grow: 1; padding: var(--space-4); min-height: 0; }
.lb-guild-chat-list { flex-grow: 1; min-height: 0; }
.lb-guild-message { margin-bottom: var(--space-2); }
.lb-guild-compose { flex-direction: row; align-items: center; }
.lb-guild-compose TextField { flex-grow: 1; min-width: 0; margin-right: var(--space-2); }
.lb-guild-report-reasons { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--space-3); }
.lb-guild-reason { min-height: 44px; margin-right: var(--space-2); margin-bottom: var(--space-2); }
.lb-guild-report-details { min-height: 120px; margin-bottom: var(--space-3); }
.lb-guild-report-actions { flex-direction: row; justify-content: space-between; margin-top: var(--space-4); }
.lb-guild-row-text Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mk-fixed-sheet { min-height: 0; flex-shrink: 1; overflow: hidden; }
.mk-fixed-sheet .lb-guild-preview { min-height: 0; flex-shrink: 1; overflow: hidden; }
.mk-fixed-sheet .lb-guild-preview > VisualElement { min-height: 0; flex-shrink: 1; overflow: hidden; }
.mk-fixed-sheet .lb-guild-header { flex-shrink: 0; }
.mk-fixed-sheet .mk-h2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lb-guild-sheet > .mk-h2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 0; }
.ui-root #page-workshop .ui-browser-title { margin-bottom: var(--space-2); }
.ui-root #page-workshop .ui-filter-row { flex-direction: row; align-items: center; margin-bottom: var(--space-2); justify-content: space-between; }
.ui-root #page-workshop .ui-filter-hit { min-height: 44px; height: 44px; min-width: 44px; padding: 0; margin: 0; align-items: stretch; justify-content: center; flex-shrink: 0; }
.ui-root #page-workshop .ui-filter-all { margin-left: var(--space-2); }
.ui-root #page-workshop .ui-filter-sort { margin-left: var(--space-2); }
.ui-root #page-workshop .ws-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: var(--space-6); }
.ui-root #page-social .g2-social-scroll { padding: var(--lobby-edge-inset) var(--lobby-edge-inset) var(--space-6); }
.ui-root #page-social .g2-live-row { height: 64px; min-height: 64px; flex-shrink: 0; }
.ui-root #page-social .g2-history-row { height: 64px; min-height: 64px; flex-shrink: 0; }
.ui-root #page-social .ui-match-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ui-root #page-social .g2-history-row .mk-number { min-height: 24px; }
.ui-root #page-social .g2-history-name { min-height: 44px; }
.ui-root #page-guild .lb-guild-search-anchor { position: relative; margin: var(--space-4) var(--lobby-edge-inset) 0; flex-shrink: 0; }
.ui-root #page-guild .lb-guild-search TextField { min-height: 44px; padding: var(--space-2); }
.ui-root #page-guild .lb-guild-searchbtn { padding: var(--space-2); }
.ui-root #page-guild .lb-guild-filterbtn { padding: var(--space-2); }
.ui-root #page-guild .lb-guild-results { opacity: 0; padding: var(--space-4) var(--lobby-edge-inset) var(--space-6); }
.ui-root #page-guild .ui-filter-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ui-root #page-guild .ui-filter-bubble { position: absolute; width: 280px; max-width: 90%; padding: var(--lobby-panel-padding); }
.ui-root #page-guild .ui-filter-tail { position: absolute; right: 16px; top: -8px; width: 12px; height: 12px; rotate: 45deg; }
.ui-root #page-guild .ui-filter-bubble .unity-base-field { min-height: 44px; margin: 0 0 var(--space-2); }
.ui-root #page-guild .ui-filter-bubble .unity-base-field__label { min-width: 0; }
.ui-root #page-guild .ui-filter-actions { flex-direction: row; justify-content: space-between; margin-top: var(--space-2); }
.ui-root #page-guild .ui-filter-actions Button { min-height: 44px; padding: var(--space-2) var(--space-3); }
.ui-lobby-list-end { height: 64px; flex-shrink: 0; }
.ui-root #page-guild .ui-filter-content { min-height: 0; flex-shrink: 1; }
