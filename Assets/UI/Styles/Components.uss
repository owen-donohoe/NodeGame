.lb-root .mk-arr { position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 44px; border-width: 2px; border-color: var(--line-inner); border-radius: 22px; background-color: var(--mk-dark); color: var(--mk-sheet); padding: 0; font-size: 24px; }
