.lb-root .ws-skin-scroll { flex-shrink: 0; height: 56px; min-height: 56px; }
.lb-root .ws-skin-art { width: 40px; height: 36px; min-height: 0; }
.lb-root .ws-skin-lock { width: 24px; height: 24px; }
.lb-root .ws-stat-cells { width: 100%; flex-grow: 0; margin-right: 0; }
.lb-root .ws-item-sheet .ws-stat-row { flex-direction: row; align-items: center; margin-bottom: var(--space-3); }
.lb-root .ws-stat-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lb-root .ws-stat-delta { width: 40px; flex-shrink: 0; margin-left: var(--space-2); font-size: 15px; -unity-font-definition: var(--font-display); -unity-text-align: middle-right; color: var(--mk-muted); }
.lb-root .ws-stat-delta--up { color: var(--confirm); }
.lb-root .ws-stat-delta--down { color: var(--mk-urgent); }
.lb-root .ws-legend { flex-direction: row; margin-bottom: var(--space-2); }
.lb-root .ws-legend-item { flex-direction: row; align-items: center; margin-right: var(--space-3); }
.lb-root .ws-legend-swatch { width: 12px; height: 12px; margin-right: var(--space-1); border-width: 2px; border-radius: 3px; }
.lb-root .ws-legend-label { font-size: 13px; }
.lb-root .ws-stat-label { font-size: 13px; }
.lb-root .ws-description { font-size: 15px; max-height: 40px; overflow: hidden; white-space: normal; }
.lb-root .ui-filter-segments { flex-direction: row; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); border-radius: 12px; padding: 4px; background-color: var(--mk-sheet); }
.lb-root .ui-filter-track { flex-direction: row; padding: 4px; border-radius: 8px; background-color: var(--mk-pressed); }
.lb-root .ui-filter-face { min-height: 32px; padding: 4px 8px; border-width: 0; border-bottom-width: 3px; border-bottom-color: var(--clear); border-radius: 8px; background-color: var(--clear); font-size: 15px; -unity-font-definition: var(--font-display); -unity-text-align: middle-center; }
.lb-root .ui-filter-chip--on .ui-filter-face { background-color: var(--mk-sheet); border-bottom-color: var(--line-light); }
.lb-root .ui-filter-sort .ui-filter-face { border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); background-color: var(--mk-sheet); }
.lb-root .g2-live-row { flex-direction: row; align-items: center; min-height: 76px; padding: 8px 12px; border-bottom-width: 1px; border-bottom-color: var(--mk-hairline); }
.lb-root .g2-live-player { flex-grow: 1; flex-basis: 0; min-width: 0; height: 48px; min-height: 48px; padding: 4px 8px; margin: 0; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); border-radius: 10px; background-color: var(--mk-sheet); justify-content: center; overflow: hidden; }
.lb-root .g2-player--p0 { border-left-width: 6px; border-left-color: var(--p0); }
.lb-root .g2-player--p1 { border-right-width: 6px; border-right-color: var(--p1); }
.lb-root .g2-live-name { font-size: 15px; min-height: 18px; -unity-font-definition: var(--font-display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lb-root .g2-live-rr { font-size: 12px; min-height: 15px; -unity-font-definition: var(--font-display); color: var(--mk-trophy); }
.lb-root .g2-player--p1 Label { -unity-text-align: middle-right; }
.lb-root .g2-vs { width: 46px; height: 58px; min-width: 46px; min-height: 58px; flex-shrink: 0; padding: 0; margin: 0 8px; border-width: 2px; border-bottom-width: 6px; border-color: var(--line-inner); border-radius: 8px; background-color: var(--mk-urgent); color: var(--mk-sheet); align-items: center; justify-content: center; }
.lb-root .g2-vs:active { border-bottom-width: 2px; }
.lb-root .ui-versus-face { font-size: 19px; -unity-font-definition: var(--font-display); color: var(--mk-sheet); }
.lb-root .g2-history-row { flex-direction: row; align-items: center; min-height: 56px; padding: 4px 12px; margin: 0; border-bottom-width: 1px; border-bottom-color: var(--mk-hairline); }
.lb-root .g2-history-row .g2-vs { width: 44px; height: 44px; min-width: 44px; min-height: 44px; }
.lb-root .g2-gain { background-color: var(--mk-tap); color: var(--mk-sheet); }
.lb-root .g2-loss { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.lb-root .g2-positive { color: var(--mk-tap); }
.lb-root .g2-negative { color: var(--mk-urgent); }
.lb-root .g2-urgent { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.lb-root .g2-online-dot { width: 12px; height: 12px; border-radius: 6px; background-color: var(--mk-tap); }
.lb-root .g2-offline .g2-online-dot { background-color: var(--mk-disabled); }
.lb-root .lb-guild-title { align-self: center; margin-bottom: 12px; }
.lb-root .lb-guild-query { height: 48px; min-height: 48px; padding: 0; margin: 0 8px 0 0; border-width: 0; }
.lb-root .lb-guild-query .unity-text-field__input { height: 48px; min-height: 48px; padding: 8px 12px; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-outer); border-radius: 12px; background-color: var(--mk-sheet); color: var(--mk-ink); font-size: 16px; }
.lb-root .lb-guild-row { flex-direction: row; align-items: center; height: 56px; min-height: 56px; padding: 8px 12px; margin: 0; border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--mk-hairline); background-color: var(--clear); }
.lb-root .lb-guild-member { flex-direction: row; align-items: center; }
.lb-root .lb-guild-row .lb-icon { width: 40px; height: 40px; border-radius: 10px; background-color: var(--mk-pressed); }
.lb-root .lb-guild-post { min-height: 56px; padding: 8px 12px; border-bottom-width: 1px; border-bottom-color: var(--mk-hairline); }
.lb-root .lb-guild-post Label { white-space: normal; }
.lb-root #page-guild .ui-filter-bubble { position: absolute; width: 280px; max-width: 90%; padding: 16px; border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px; background-color: var(--mk-card); }
.lb-root #page-guild .ui-filter-tail { position: absolute; right: 16px; top: -8px; width: 12px; height: 12px; rotate: 45deg; background-color: var(--mk-card); border-left-width: 2px; border-top-width: 2px; border-color: var(--line-outer); }
.lb-root .ui-filter-bubble .unity-base-slider__tracker { height: 10px; border-width: 2px; border-color: var(--line-inner); border-radius: 6px; background-color: var(--mk-track); }
.lb-root .ui-filter-bubble .unity-base-slider__dragger { width: 24px; height: 24px; border-width: 2px; border-bottom-width: 4px; border-color: var(--line-inner); border-radius: 12px; background-color: var(--mk-sheet); }
.lb-root .lb-guild-browse-toggle { width: 44px; min-height: 44px; align-self: center; margin-top: 8px; background-image: url("project://database/Assets/UI/Resources/Lobby/Icons/Phosphor/caret-down-bold.svg"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mk-ink); }
.lb-root .mk-card, .lb-root .mk-strip, .lb-root .mk-sheet, .lb-root .mk-bigsheet, .lb-root .mk-panel { background-image: url("project://database/Assets/UI/Resources/Lobby/paper-grain.png"); }
.lb-root PaperButton.mk-btn { border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); background-color: var(--mk-sheet); border-radius: 8px; }
.lb-root PaperButton.mk-btn > .ui-paper__underlay { display: none; }
.lb-root .ui-paper-button__caption { -unity-font-definition: var(--font-display); font-size: 15px; }
#page-shop Label, #page-shop Button { letter-spacing: 0; }
.lb-root .ui-filter-layer { background-color: var(--mk-scrim); }
.lb-root .ui-filter-bubble .unity-min-max-slider__tracker { height: 10px; border-width: 2px; border-color: var(--line-inner); border-radius: 6px; background-color: var(--mk-track); }
.lb-root .ui-filter-bubble .unity-min-max-slider__min-thumb, .lb-root .ui-filter-bubble .unity-min-max-slider__max-thumb { width: 24px; height: 24px; border-width: 2px; border-bottom-width: 4px; border-color: var(--line-inner); border-radius: 12px; background-color: var(--mk-sheet); }
.lb-root .g2-history-name { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 44px; padding: 0; margin: 0; border-width: 0; background-color: var(--clear); font-size: 15px; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }

.lb-root #page-workshop .ui-filter-sort { flex-direction: row; align-items: center; padding: 4px 8px; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); border-radius: 8px; background-color: var(--mk-sheet); background-image: none; }
.lb-root .ui-filter-sort .ui-filter-face { min-height: 20px; padding: 0; border-width: 0; background-image: none; background-color: var(--clear); }
.lb-root .ws-sort-caret { background-image: url("project://database/Assets/UI/Resources/Lobby/Icons/Phosphor/caret-down-bold.svg"); -unity-background-scale-mode: scale-to-fit; width: 16px; height: 16px; margin-left: 4px; -unity-background-image-tint-color: var(--mk-ink); }

.lb-root .lb-guild-browse-toggle { background-size: 24px 24px; background-position: center; background-repeat: no-repeat; }

.lb-root .mk-field { border-width: 0; padding: 0; background-color: var(--clear); min-height: 48px; }
.lb-root .mk-field .unity-text-field__input { flex-grow: 1; min-height: 48px; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); border-radius: 12px; padding: 8px 12px; background-color: var(--mk-sheet); color: var(--mk-ink); font-size: 16px; -unity-font-definition: var(--font-body); }

/* Remove runtime-theme button artwork; USS edges are the only lip. */
.lb-root .mk-tab, .lb-root .mk-seg2__btn { background-image: none; translate: 0 0; scale: 1 1; }
.lb-root .mk-tab, .lb-root .mk-tab:active { border-width: 2px; }
.lb-root .mk-tabs--sliding .mk-tab--on { border-color: var(--clear); }
.lb-root .lb-pill-progress { border-width: 2px; background-image: none; }

.lb-root .ws-card { overflow: hidden; }
.lb-root .ws-tile-meta { min-height: 16px; }
.lb-root .ws-monogram { font-size: 24px; margin-bottom: 0; }

/* Search icon belongs to the field; the only adjacent action is Filter. */
.lb-root .lb-guild-query-wrap { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; position: relative; }
.lb-root .lb-guild-query-wrap .lb-guild-query { margin-right: 0; }
.lb-root .lb-guild-query-wrap .unity-text-field__input { padding-left: 40px; }
.lb-root .lb-guild-query-icon { position: absolute; left: 12px; top: 12px; width: 24px; height: 24px; -unity-background-image-tint-color: var(--mk-ink); }
.lb-root .lb-guild-query .unity-base-text-field__input--placeholder { color: var(--mk-muted); }
.lb-root #page-guild .lb-guild-filterbtn { width: 48px; height: 48px; min-width: 48px; min-height: 48px; background-image: none; }
.lb-root .lb-guild-filterbtn .lb-icon { width: 24px; height: 24px; -unity-background-image-tint-color: var(--mk-ink); }
.lb-root .lb-guild-browse-toggle, .lb-root .lb-guild-browse-toggle:active { height: 44px; padding: 0; border-width: 0; background-color: var(--clear); background-image: none; align-items: center; justify-content: center; }
.lb-root .lb-guild-expand-ink, .lb-root .lb-guild-expand-face { position: absolute; width: 24px; height: 24px; background-image: url("project://database/Assets/UI/Resources/Lobby/Icons/Phosphor/caret-down-bold.svg"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mk-ink); }
.lb-root .lb-guild-expand-face { -unity-background-image-tint-color: var(--mk-sheet); }

.lb-root .g2-live-empty { padding: 8px 12px; }

.lb-root .mk-purse, .lb-root .mk-namelink, .lb-root .g2-home-mode, .lb-root .ws-card { background-image: none; }

.lb-root #social-tv .lb-async > VisualElement > Label { color: var(--mk-muted); font-size: 13px; padding: 8px 12px; }

/* SegmentedSwitch owns a single face; option buttons paint only their text. */
.lb-root .lb-segmented { height: 52px; flex-shrink: 0; border-width: 2px; border-bottom-width: 5px; border-color: var(--line-inner); border-radius: 12px; padding: 4px; background-color: var(--mk-sheet); }
.lb-root .lb-segmented__track { position: relative; flex-direction: row; flex-grow: 1; padding: 4px; border-radius: 8px; background-color: var(--mk-pressed); }
.lb-root .lb-segmented__thumb { position: absolute; left: 0; top: 4px; height: 32px; border-width: 0; border-bottom-width: 3px; border-bottom-color: var(--line-light); border-radius: 6px; background-color: var(--mk-sheet); }
.lb-root .lb-segmented__face, .lb-root .lb-segmented__face:hover, .lb-root .lb-segmented__face:active, .lb-root .lb-segmented__face:focus { flex-grow: 1; flex-basis: 0; min-width: 0; height: 29px; min-height: 0; margin: 0; padding: 6px 10px; border-width: 0; border-radius: 6px; background-image: none; background-color: var(--clear); color: var(--mk-muted); -unity-font-definition: var(--font-display); font-size: 14px; -unity-text-align: middle-center; translate: 0 0; scale: 1 1; transition-property: color; transition-duration: 0.25s; }
.lb-root .lb-segmented__face--on, .lb-root .lb-segmented__face--on:hover, .lb-root .lb-segmented__face--on:active, .lb-root .lb-segmented__face--on:focus { color: var(--mk-ink); }
.lb-root #page-workshop .ui-filter-row { align-items: stretch; margin-bottom: 12px; }
.lb-root #page-workshop .ws-ownership { flex-grow: 1; flex-basis: 0; min-width: 0; }
.lb-root #page-workshop .ws-panel2 { padding: 12px; }
.lb-root #page-workshop .ui-filter-sort { height: auto; min-height: 0; margin: 0 0 0 8px; padding: 0 14px; border-radius: 8px; }
.lb-root .lb-guild-member-filter { margin: 12px; }

/* Phone 2: four compact rows, with custom paper controls over native slider input. */
.lb-root #page-guild .ui-filter-content .unity-scroll-view__content-container { padding: 0; }
.lb-root #page-guild .ui-filter-slider-row { margin-bottom: 14px; }
.lb-root #page-guild .ui-filter-labels { flex-direction: row; justify-content: space-between; height: 18px; }
.lb-root #page-guild .ui-filter-labels Label, .lb-root #page-guild .ui-filter-toggle Label { font-size: 15px; -unity-font-definition: var(--font-body); color: var(--mk-ink); }
.lb-root #page-guild .ui-filter-labels .ui-filter-value { -unity-font-definition: var(--font-display); }
.lb-root #page-guild .ui-filter-bubble .unity-base-field { height: 24px; min-height: 24px; margin: 3px 0 0; padding: 0; }
.lb-root #page-guild .ui-filter-bubble .unity-base-field__input { margin: 0; background-color: var(--clear); }
.lb-root .ui-filter-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background-color: var(--mk-tap); }
.lb-root #page-guild .unity-min-max-slider__dragger { height: 6px; background-color: var(--mk-tap); border-width: 0; }
.lb-root #page-guild .unity-base-slider__dragger-border { display: none; }
.lb-root #page-guild .ui-filter-toggle, .lb-root #page-guild .ui-filter-toggle:hover, .lb-root #page-guild .ui-filter-toggle:active, .lb-root #page-guild .ui-filter-toggle:focus { flex-direction: row; align-items: center; justify-content: space-between; height: 28px; min-height: 28px; padding: 0; margin: 0; border-width: 0; background-image: none; background-color: var(--clear); translate: 0 0; }
.lb-root #page-guild .ui-filter-actions { margin-top: 14px; }
.lb-root #page-guild .ui-filter-actions Button { height: 40px; min-height: 40px; padding: 0 14px; }

/* Shared toggle (LobbyToggle): 48x28 track, 2 px border, 20 px knob with a 2 px inset. The knob sits at left 0
   and LobbyToggleMath supplies the translate, so on = 22 px and off = 2 px inside the border. */
.lb-root .lb-toggle { position: relative; width: 48px; height: 28px; flex-shrink: 0; border-width: 2px; border-color: var(--line-inner); border-radius: 14px; background-color: var(--mk-track); }
.lb-root .lb-toggle--on { background-color: var(--mk-tap); }
.lb-root .lb-toggle__knob { position: absolute; left: 0; top: 2px; width: 20px; height: 20px; border-width: 2px; border-color: var(--line-inner); border-radius: 10px; background-color: var(--mk-sheet); }
/* Side-variant arrows: a 36px circle holding a flatter caret (arms squashed to 70% toward the tip), nudged to the optical centre. */
.lb-root .ws-arr-prev, .lb-root .ws-arr-next { width: 36px; height: 36px; min-width: 36px; min-height: 36px; border-radius: 18px; background-image: none; align-items: center; justify-content: center; }
.lb-root .ws-arr-prev { left: 0; }
.lb-root .ws-arr-next { right: 0; }
.lb-root .ws-arr-glyph { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mk-sheet); scale: 0.7 1; }
.lb-root .ws-arr-glyph--prev { background-image: url("project://database/Assets/UI/Resources/Lobby/Icons/Phosphor/caret-left-bold.svg"); transform-origin: 28% 50%; translate: 2px 0; }
.lb-root .ws-arr-glyph--next { background-image: url("project://database/Assets/UI/Resources/Lobby/Icons/Phosphor/caret-right-bold.svg"); transform-origin: 72% 50%; translate: -2px 0; }

/* Workshop tiles: two equal columns by percentage with an exact 8px gutter, so the grid needs no measuring. */
.lb-root #page-workshop .ws-cards { margin-left: -4px; margin-right: -4px; }
.lb-root .ws-cell { width: 50%; height: 160px; padding: 0 4px 8px 4px; flex-shrink: 0; }
.lb-root .ws-cell > .ws-card { flex-grow: 1; margin: 0; min-width: 0; min-height: 0; }
.lb-root .ws-cell > .ws-card .ws-art-clip { height: 78px; }
.lb-root .ws-empty-cell { width: 100%; }
.lb-root .ws-presets { height: 59px; flex-shrink: 0; }
.lb-root .ws-panel1 { height: 119px; }
.lb-root .ws-panel1-space { height: 119px; }
.lb-root .ws-art { -unity-background-scale-mode: scale-to-fit; }

.lb-root #page-workshop .ws-starter-tag { position: absolute; top: 4px; left: 4px; flex-direction: row; align-items: center; padding: 0 4px; border-radius: 8px; background-color: var(--mk-ink); color: var(--mk-sheet); }
.lb-root #page-workshop .ws-starter-tag .lb-icon { width: 14px; height: 14px; margin-right: 4px; -unity-background-image-tint-color: var(--mk-sheet); }
.lb-root #page-workshop .ws-starter-text { font-size: 13px; margin: 0; padding: 0; flex-shrink: 0; }
.lb-root .ws-starter-note { font-size: 13px; color: var(--mk-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0; }
