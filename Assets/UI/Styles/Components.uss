/*
    Node War - shared components.

    The pieces both scenes draw the same way: type, buttons, the bottom
    sheet, bars, chips, the toast, player marks and monogram tiles. Loaded
    through UnityDefaultRuntimeTheme.tss after Tokens.uss, so every panel has
    them and a page stylesheet only adds what is particular to it.

    Classes are prefixed ui-. Page stylesheets keep their own prefixes (lb-
    in the lobby shell, hud__ in the match), so a shared rule and a page rule
    never share a name.

    Rules here read meaning tokens only, never --pal-*.

    PRECEDENCE. These rules arrive through the panel theme, and a theme rule
    loses to ANY rule in a stylesheet a layout imports, whatever the
    specificity (measured in 6000.5.9f1). So a page overrides a component with
    a plain single-class rule - and the .ui-root Label reset below yields to
    any page rule that sets a label's margin or padding. Set those only where
    the spacing is meant.

    Measured against 6000.5.9f1, where the prototypes use CSS that USS lacks:
      box-shadow, drop-shadow        -> a sibling element behind (.ui-sticker__shadow)
      gradients                      -> flat fill, or vertex colours from C#
      gap, :last-child, :nth-child   -> margins on each child, a --last class
      @keyframes                     -> class ping-pong from C#
      picking-mode                   -> not USS; set it in UXML or C#
*/

/* ===================================================================
   Root and type
   =================================================================== */

/* On the root of every document. Transparent: the match draws over a
   board, and the lobby gives its own root a surface. */
.ui-root {
    flex-grow: 1;
    -unity-font-definition: var(--font-medium);
    color: var(--ink);
    font-size: var(--type-body);
}

.ui-root Label {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.ui-w500 { -unity-font-definition: var(--font-medium); -unity-font-style: normal; }
.ui-w600 { -unity-font-definition: var(--font-semibold); -unity-font-style: normal; }
.ui-w700 { -unity-font-definition: var(--font-bold); -unity-font-style: normal; }

/* A Button with every runtime-theme default removed, so its class alone
   decides how it looks. */
.ui-reset-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: var(--clear);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ===================================================================
   Shadows. A shadow is an absolutely placed sibling drawn first.
   =================================================================== */

.ui-sticker {
    position: relative;
}

.ui-sticker__shadow {
    position: absolute;
    left: 3px;
    top: 4px;
    right: -3px;
    bottom: -4px;
    background-color: var(--shadow);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-soft-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: -8px;
    background-color: var(--shadow-deep);
    filter: blur(11px);
}

/* ===================================================================
   Buttons. The big button sits on a solid lip - the prototype's
   0 5px 0 box-shadow - which is a block behind it, not a border.
   =================================================================== */

.ui-lip {
    position: relative;
}

.ui-lip__block {
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    bottom: -5px;
}

.ui-lip__block--gold { background-color: var(--action-edge); }
.ui-lip__block--green { background-color: var(--confirm-edge); }

.ui-button-wrap {
    margin-bottom: var(--space-3);
}

.ui-button-wrap > .ui-lip__block {
    top: 4px;
    bottom: -4px;
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.ui-button {
    height: 60px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    font-size: 21px;
    transition-property: translate;
    transition-duration: var(--motion-press);
}

.ui-button:active {
    translate: 0 3px;
}

.ui-button--gold {
    background-color: var(--action);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
    color: var(--action-ink);
}

.ui-button--green {
    background-color: var(--confirm);
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    color: var(--confirm-ink);
}

.ui-button--quiet {
    background-color: var(--surface-sunk);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    color: var(--ink);
}

/* Disabled is dimmed, never recoloured grey: the label carries the reason,
   and the button must stay readable enough to say it. */
.ui-button:disabled {
    opacity: 0.55;
    translate: 0 0;
}

/* ===================================================================
   Bottom sheet. Pinned to the bottom edge by construction, so it cannot
   render off-screen. Never positioned with top: and a computed value.
   The scrim is the lobby's; the match sheet has none (settled 2026-09-02).
   =================================================================== */

.ui-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-sheet);
}

.ui-scrim--on {
    opacity: 1;
}

.ui-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: 0;
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-top-left-radius: var(--corner-sheet);
    border-top-right-radius: var(--corner-sheet);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    translate: 0 100%;
    transition-property: translate;
    transition-duration: var(--motion-sheet);
    transition-timing-function: ease-out;
}

.ui-sheet--open {
    translate: 0 0;
}

.ui-handle-hit {
    height: 33px;
    align-items: center;
}

.ui-handle {
    width: 44px;
    height: 5px;
    margin-top: var(--space-3);
    border-top-left-radius: 2.5px;
    border-top-right-radius: 2.5px;
    border-bottom-left-radius: 2.5px;
    border-bottom-right-radius: 2.5px;
    background-color: var(--ink-mute);
}

.ui-root .ui-sheet__title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-bottom: var(--space-4);
    white-space: normal;
}

.ui-root .ui-sheet__note {
    font-size: var(--type-body);
    color: var(--ink-mute);
    margin-bottom: 18px;
    white-space: normal;
}

.ui-root .ui-sheet__note--error {
    color: var(--badge);
}

/* ===================================================================
   Bar. A track and a fill; the fill's width is set from C#.
   =================================================================== */

.ui-bar {
    height: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    overflow: hidden;
}

.ui-bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
}

/* ===================================================================
   Chip. A small dark-glass pill for a readout over scenery or the board.
   Height 38, so the radius is exactly half.
   =================================================================== */

.ui-chip {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    background-color: var(--glass);
    color: var(--ink-inverse);
}

.ui-root .ui-chip__text {
    color: var(--ink-inverse);
    font-size: var(--type-body);
}

/* The chip that is also the main action of the moment. */
.ui-chip--action {
    background-color: var(--action);
    color: var(--action-ink);
}

.ui-root .ui-chip--action > .ui-chip__text {
    color: var(--action-ink);
}

/* ===================================================================
   Toast
   =================================================================== */

.ui-root .ui-toast {
    max-width: 300px;
    background-color: var(--glass-toast);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    color: var(--ink-inverse);
    font-size: var(--type-body);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 200ms;
}

.ui-root .ui-toast--on {
    opacity: 1;
    translate: 0 0;
}

/* ===================================================================
   Player mark - colour PLUS shape, always. Player 0 is a blue square
   marked 1, player 1 a red circle marked 2, nobody a grey square with a
   dash. Distinguishable in greyscale by shape alone.
   =================================================================== */

.ui-mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
}

.ui-root .ui-mark__label {
    font-size: var(--type-min);
    color: var(--mark-ink);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
}

.ui-mark--p0 {
    background-color: var(--p0);
    border-left-color: var(--p0-edge);
    border-right-color: var(--p0-edge);
    border-top-color: var(--p0-edge);
    border-bottom-color: var(--p0-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--p1 {
    background-color: var(--p1);
    border-left-color: var(--p1-edge);
    border-right-color: var(--p1-edge);
    border-top-color: var(--p1-edge);
    border-bottom-color: var(--p1-edge);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.ui-mark--unowned {
    background-color: var(--unowned);
    border-left-color: var(--unowned-edge);
    border-right-color: var(--unowned-edge);
    border-top-color: var(--unowned-edge);
    border-bottom-color: var(--unowned-edge);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-mark--small {
    width: 15px;
    height: 15px;
}

/* ===================================================================
   Monogram tile - the stand-in for art that does not exist. The letter
   carries the identity; the tint, hashed from the item's ID by ItemTint,
   only reinforces it. Sized by whatever contains it.
   =================================================================== */

.ui-tile {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--shadow-deep);
    border-right-color: var(--shadow-deep);
    border-top-color: var(--shadow-deep);
    border-bottom-color: var(--shadow-deep);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.ui-root .ui-tile__monogram {
    color: var(--ink-white);
    -unity-font-definition: var(--font-semibold);
    -unity-text-align: middle-center;
}

.ui-tile-tint--0 { background-color: var(--tile-tint-0); }
.ui-tile-tint--1 { background-color: var(--tile-tint-1); }
.ui-tile-tint--2 { background-color: var(--tile-tint-2); }
.ui-tile-tint--3 { background-color: var(--tile-tint-3); }
.ui-tile-tint--4 { background-color: var(--tile-tint-4); }
.ui-tile-tint--5 { background-color: var(--tile-tint-5); }
.ui-tile-tint--6 { background-color: var(--tile-tint-6); }
.ui-tile-tint--7 { background-color: var(--tile-tint-7); }

/* Shared by lobby and in-match settings. */
.lb-switch {
    width: 52px;
    height: 31px;
    flex-shrink: 0;
    border-top-left-radius: 15.5px;
    border-top-right-radius: 15.5px;
    border-bottom-left-radius: 15.5px;
    border-bottom-right-radius: 15.5px;
    background-color: var(--off);
    transition-property: background-color;
    transition-duration: var(--motion-release);
}

.lb-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 25px;
    height: 25px;
    border-top-left-radius: 12.5px;
    border-top-right-radius: 12.5px;
    border-bottom-left-radius: 12.5px;
    border-bottom-right-radius: 12.5px;
    background-color: var(--ink-white);
    transition-property: translate;
    transition-duration: var(--motion-release);
}

.lb-switch--on {
    background-color: var(--confirm);
}

.lb-switch--on > .lb-switch__knob {
    translate: 21px 0;
}


/* Paper geometry is retained by PaperCard; native fills must not cover its edge. */
.ui-root {
    --paper-card-fill: var(--paper-light);
    --paper-card-ink: var(--paper-ink);
    --paper-card-width: var(--paper-ink-width);
    --paper-card-shadow: var(--paper-shadow);
    --paper-card-shadow-x: var(--paper-shadow-x);
    --paper-card-shadow-y: var(--paper-shadow-y);
    --paper-card-wobble: var(--paper-wobble);
    --paper-card-grain: var(--paper-grain-opacity);
}
.ui-paper {
    background-color: var(--clear);
    border-color: var(--clear);
    border-radius: var(--corner-md);
}
.ui-paper--gold { --paper-card-fill: var(--paper-gold); }
.ui-paper--chip { --paper-card-fill: var(--paper-dark); border-radius: var(--corner-sm); }
.ui-paper--button:active { translate: 0 3px; --paper-card-shadow-y: 0px; }
.ui-paper-button { min-width: var(--target-min); min-height: var(--target-min); color: var(--ink); }
.ui-paper__underlay { position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; }
.ui-paper-button--gold > .ui-paper { --paper-card-fill: var(--paper-gold); }
.ui-paper-button--urgent > .ui-paper { --paper-card-fill: var(--paper-urgent); }
.ui-paper-button__caption { -unity-text-align: middle-center; white-space: normal; flex-shrink: 1; }
.ui-paper-button:active { translate: 0 3px; }
.ui-paper__swatch {
    position: absolute; width: 0; height: 0; visibility: hidden;
    background-color: var(--paper-card-fill); color: var(--paper-card-ink);
    border-left-color: var(--paper-card-shadow);
    border-left-width: var(--paper-card-width); border-right-width: var(--paper-card-shadow-x);
    border-bottom-width: var(--paper-card-shadow-y); border-top-width: var(--paper-card-wobble);
    opacity: var(--paper-card-grain);
}
/* Mockup base components. Flex child margins reproduce CSS gaps in USS. */
.ui-root .mk-card, .ui-root .mk-strip, .ui-root .mk-tile, .ui-root .mk-crate, .ui-root .mk-skin{ border-width: 2px; border-color: var(--mk-ink); background-color: var(--mk-card); color: var(--mk-ink); }
.ui-root .mk-card{ border-radius: 12px; padding: 12px; }
.ui-root .mk-eyebrow{ font-size: var(--type-caption); -unity-font-style: normal; letter-spacing: 1px; color: var(--mk-muted); }
.ui-root .mk-h2{ font-size: var(--type-title); -unity-font-style: normal; margin-bottom: 4px; }
.ui-root .mk-h3{ font-size: var(--type-heading); -unity-font-style: normal; }
.ui-root .mk-muted{ color: var(--mk-muted); }
.ui-root .mk-row, .ui-root .mk-spread{ flex-direction: row; align-items: center; }
.ui-root .mk-row > *, .ui-root .mk-spread > *{ margin-right: 8px; }
.ui-root .mk-spread{ justify-content: space-between; }
.ui-root .mk-btn{ border-width: 2px; border-color: var(--mk-ink); background-color: var(--mk-sheet); color: var(--mk-ink); border-radius: 10px; padding: 8px 12px; min-height: 44px; min-width: 44px; font-size: var(--type-body); -unity-font-style: normal; }
.ui-root .mk-btn--urgent { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.ui-root .mk-btn--primary, .ui-root .mk-btn--gold{ background-color: var(--mk-action); color: var(--mk-ink); }
.ui-root .mk-btn--big{ font-size: var(--type-title); padding: 16px; width: 100%; letter-spacing: 0.88px; }
.ui-root .mk-btn--sm{ padding: 4px 8px; font-size: var(--type-secondary); border-radius: 8px; }
.ui-root .mk-btn:disabled, .ui-root .mk-btn--disabled{ opacity: 0.45; }
.ui-root .mk-btn:active{ background-color: var(--mk-pressed); }
.ui-root .mk-chip{ border-width: 2px; border-color: var(--mk-disabled); background-color: var(--clear); color: var(--mk-ink); border-radius: 22px; padding: 4px 12px; min-height: 44px; min-width: 44px; font-size: var(--type-caption); -unity-font-style: normal; }
.ui-root .mk-chip--on{ background-color: var(--mk-ink); color: var(--mk-sheet); border-color: var(--mk-ink); }
.ui-root .mk-chip--tap{ border-color: var(--mk-tap); color: var(--mk-tap); }
.ui-root .mk-chip--tap.mk-chip--on{ background-color: var(--mk-tap); color: var(--mk-sheet); }
.ui-root .mk-seg2{ flex-direction: row; border-width: 2px; border-color: var(--mk-ink); border-radius: 26px; overflow: hidden; margin-bottom: 10px; padding: 3px; background-color: var(--mk-card); }
.ui-root .mk-seg2__btn{ flex-grow: 1; flex-basis: 0; border-width: 0; border-radius: 22px; background-color: var(--mk-card); padding: 9px; min-height: 44px; font-size: var(--type-number); -unity-font-style: normal; }
.ui-root .mk-seg2__btn--on{ background-color: var(--mk-tap); color: var(--mk-sheet); }
.ui-root .mk-grid{ flex-direction: row; flex-wrap: wrap; margin-right: -8px; margin-bottom: -8px; }
.ui-root .mk-grid > .mk-tile{ width: 30%; flex-grow: 1; margin-right: 8px; margin-bottom: 8px; }
.ui-root .mk-tile{ position: relative; border-radius: 10px; background-color: var(--mk-sheet); padding: 6px 4px 5px; align-items: center; font-size: var(--type-caption); -unity-text-align: middle-center; }
.ui-root .mk-tile > *{ margin-bottom: 1px; }
.ui-root .mk-tile .mk-art{ width: 72%; }
.ui-root .mk-tile--locked{ background-color: var(--clear); }
.ui-root .mk-tile--locked .mk-art{ opacity: 0.4; }
.ui-root .mk-mark{ position: absolute; top: -6px; right: -6px; background-color: var(--mk-ink); color: var(--mk-sheet); font-size: var(--type-caption); -unity-font-style: normal; letter-spacing: 0.45px; padding: 1px 6px; border-radius: 10px; }
.ui-root .mk-mark--era{ background-color: var(--era-3); }
.ui-root .mk-banner{ border-width: 2px; border-color: var(--mk-tap); background-color: var(--mk-tap-soft); border-radius: 12px; padding: 8px 12px; margin-top: 12px; }
.ui-root .mk-toolbar{ flex-direction: row; flex-wrap: wrap; align-items: center; margin: 14px 0 6px; }
.ui-root .mk-toolbar > *, .ui-root .mk-roles > *{ margin-right: 6px; }
.ui-root .mk-roles{ flex-direction: row; padding: 2px 0 8px; }
.ui-root .mk-roles > *{ flex-shrink: 0; }
.ui-root .mk-sheet, .ui-root .mk-bigsheet{ position: absolute; left: 0; right: 0; bottom: 0; max-height: 80%; background-color: var(--mk-sheet); color: var(--mk-ink); border-top-width: 3px; border-top-color: var(--mk-ink); border-top-left-radius: 18px; border-top-right-radius: 18px; padding: 16px 12px 16px; }
.ui-root .mk-bigsheet{ height: 78%; max-height: 78%; border-top-left-radius: 20px; border-top-right-radius: 20px; padding: 12px 12px 12px; }
.ui-root .mk-bigsheet > *{ margin-bottom: 8px; }
.ui-root .mk-bigsheet .mk-h2{ font-size: var(--type-title); -unity-text-align: middle-center; }
.ui-root .mk-handle{ width: 40px; height: 5px; background-color: var(--mk-disabled); border-radius: 3px; align-self: center; margin-top: 8px; }
.ui-root .mk-handle-hit{ height: 44px; flex-shrink: 0; margin-top: -16px; }
.ui-root .mk-scrim{ position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--mk-scrim); }
.ui-root .mk-arr{ position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 56px; border-width: 0; background-color: var(--clear); color: var(--mk-ink); padding: 0; font-size: var(--type-title); }
.ui-root .mk-arr:disabled, .ui-root .mk-arr--disabled{ opacity: 0.18; }
.ui-root .mk-dots{ flex-direction: row; justify-content: center; }
.ui-root .mk-dots > *{ margin-right: 10px; }
.ui-root .mk-dot2{ width: 14px; height: 14px; border-radius: 7px; border-width: 2px; border-color: var(--mk-ink); background-color: var(--clear); padding: 0; }
.ui-root .mk-dot2--on, .ui-root .mk-dot2--f{ background-color: var(--mk-ink); }
.ui-root .mk-dot2--locked{ border-color: var(--mk-disabled); }
.ui-root .mk-dot2--cur{ scale: 1.3; }
.ui-root .mk-skins{ flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.ui-root .mk-skins > *{ margin-right: 10px; }
.ui-root .mk-skin{ width: 82px; border-radius: 10px; padding: 3px 4px; align-items: center; font-size: var(--type-caption); -unity-font-style: normal; letter-spacing: 0.4px; }
.ui-root .mk-skin .mk-art{ width: 40px; }
.ui-root .mk-skin--on{ border-color: var(--mk-tap); border-width: 5px; }
.ui-root .mk-skin--locked{ opacity: 0.5; }
.ui-root .mk-hist{ flex-shrink: 0; }
.ui-root .mk-hist > *{ margin-bottom: 8px; }
.ui-root .mk-hrow{ flex-direction: row; align-items: center; font-size: var(--type-caption); -unity-font-style: normal; letter-spacing: 0.6px; }
.ui-root .mk-hrow > Label{ width: 52px; margin-right: 8px; }
.ui-root .mk-hrow > .mk-value{ width: 56px; -unity-text-align: middle-right; }
.ui-root .mk-cells{ flex-direction: row; flex-grow: 1; margin-right: 8px; }
.ui-root .mk-cell{ flex-grow: 1; flex-basis: 0; height: 12px; margin-right: 3px; border-width: 1.5px; border-color: var(--mk-ink); border-radius: 2px; background-color: var(--clear); font-size: var(--type-caption); color: var(--mk-disabled); -unity-text-align: middle-center; }
.ui-root .mk-cell--f{ background-color: var(--mk-ink); }
.ui-root .mk-cell--g{ background-color: var(--mk-tap); border-color: var(--mk-tap); }
.ui-root .mk-cell--t{ background-color: var(--mk-urgent); border-color: var(--mk-urgent); }
.ui-root .mk-crate{ width: 76px; height: 76px; border-radius: 14px; padding: 4px 4px 12px; align-items: center; justify-content: center; }
.ui-root .mk-cbadge{ position: absolute; top: -9px; right: -9px; min-width: 32px; height: 32px; padding: 0 4px; border-radius: 16px; background-color: var(--mk-urgent); color: var(--mk-sheet); border-width: 2px; border-color: var(--mk-ink); font-size: var(--type-number); -unity-font-style: normal; -unity-text-align: middle-center; }
.ui-root .mk-battle{ width: 100%; border-width: 2px; border-bottom-width: 8px; border-color: var(--mk-ink); border-radius: 16px; background-color: var(--mk-action); color: var(--mk-ink); font-size: var(--type-battle); -unity-font-style: normal; letter-spacing: 3px; padding: 12px; min-height: 44px; }
.ui-root .mk-battle--off{ opacity: 0.5; }
.ui-root .mk-battle:active{ translate: 0 4px; border-bottom-width: 4px; }
.ui-root .mk-friend{ flex-direction: row; align-items: center; padding: 8px 0; border-bottom-width: 1.5px; border-bottom-color: var(--mk-disabled); min-height: 44px; }
.ui-root .mk-friend > *{ margin-right: 8px; }
.ui-root .mk-friend__avatar{ width: 34px; height: 34px; border-radius: 8px; border-width: 2px; border-color: var(--mk-ink); background-color: var(--p0); font-size: var(--type-body); -unity-font-style: normal; -unity-text-align: middle-center; }
.ui-root .mk-friend__body{ flex-grow: 1; min-width: 0; }
.ui-root .mk-friend__name{ font-size: var(--type-body); -unity-font-style: normal; }
.ui-root .mk-friend__status{ flex-direction: row; align-items: center; color: var(--mk-muted); font-size: var(--type-secondary); }
.ui-root .mk-friend__dot{ width: 8px; height: 8px; border-radius: 4px; background-color: var(--mk-tap); margin-right: 4px; }
.ui-root .mk-friend__trailing{ flex-direction: row; align-items: center; }
.ui-root .mk-topbar{ flex-direction: row; align-items: center; padding: 8px 12px 8px; flex-shrink: 0; min-height: 52px; }
.ui-root .mk-topbar > *{ margin-right: 8px; }
.ui-root .mk-purse{ flex-direction: row; align-items: center; padding: 8px 12px; border-width: 0; border-radius: 22px; min-height: 44px; min-width: 44px; background-color: var(--mk-dark); color: var(--mk-sheet); font-size: var(--type-body); -unity-font-style: normal; }
.ui-root .mk-purse > *{ margin-right: 8px; color: var(--mk-sheet); }
.ui-root .mk-purse__dot--coin, .ui-root .mk-purse__dot--leaf{ width: 14px; height: 14px; border-radius: 7px; border-width: 2px; border-color: var(--mk-sheet); background-color: var(--mk-coin); }
.ui-root .mk-purse__dot--leaf{ width: 16px; height: 16px; border-radius: 2px 14px 2px 14px; rotate: -12deg; background-color: var(--mk-leaf); }
.ui-root .mk-rbtn{ width: 44px; height: 44px; min-width: 44px; flex-shrink: 0; border-radius: 22px; border-width: 0; background-color: var(--mk-dark); color: var(--mk-sheet); padding: 0; align-items: center; justify-content: center; font-size: var(--type-title); }
.ui-root .mk-rbtn .lb-icon{ width: 24px; height: 24px; -unity-background-image-tint-color: var(--mk-sheet); }
.ui-root .mk-strip{ margin: 0 12px 8px; padding: 8px 12px 8px; border-bottom-width: 5px; border-radius: 12px; flex-shrink: 0; }
.ui-root .mk-namelink{ flex-direction: row; flex-grow: 1; align-items: center; background-color: var(--clear); border-width: 0; padding: 0; font-size: var(--type-number); -unity-font-style: normal; color: var(--mk-ink); }
.ui-root .mk-namelink > *{ margin-right: 4px; }
.ui-root .mk-trophy{ flex-direction: row; color: var(--mk-trophy); font-size: var(--type-number); -unity-font-style: normal; }
.ui-root .mk-meter{ height: 6px; border-width: 2px; border-color: var(--mk-ink); border-radius: 4px; overflow: hidden; background-color: var(--mk-track); }
.ui-root .mk-meter > *{ height: 100%; background-color: var(--mk-ink); }
.ui-root .mk-meter--thin{ height: 8px; margin: 4px 0 4px; }
.ui-root .mk-cap{ font-size: var(--type-caption); color: var(--mk-muted); }
.ui-root .mk-tabs{ flex-direction: row; margin: 4px 12px 8px; border-width: 2px; border-color: var(--mk-ink); border-radius: 32px; padding: 4px; background-color: var(--mk-card); }
.ui-root .mk-tab{ position: relative; flex-grow: 1; flex-basis: 0; min-width: 44px; min-height: 44px; border-width: 0; border-radius: 26px; padding: 4px 4px 4px; margin-right: 4px; align-items: center; background-color: var(--clear); color: var(--mk-muted); font-size: var(--type-caption); -unity-font-style: normal; letter-spacing: 0.33px; }
.ui-root .mk-tab .lb-icon{ width: 22px; height: 22px; margin-bottom: 4px; -unity-background-image-tint-color: var(--mk-muted); }
.ui-root .mk-tab--on{ background-color: var(--mk-tap); color: var(--mk-sheet); }
.ui-root .mk-tab--on .lb-icon{ -unity-background-image-tint-color: var(--mk-sheet); }
.ui-root .mk-tab__badge{ position: absolute; top: 5px; right: 10px; width: 11px; height: 11px; border-radius: 6px; background-color: var(--mk-urgent); border-width: 2px; border-color: var(--mk-card); }

.ui-root .mk-sheet{ translate: 0 100%; transition-property: translate; transition-duration: 280ms; transition-timing-function: ease-out; }
.ui-root .mk-sheet--open{ translate: 0 0; }
.ui-root .mk-friend--disabled, .ui-root .mk-chip--disabled, .ui-root .mk-chip:disabled, .ui-root .mk-seg2__btn--disabled, .ui-root .mk-seg2__btn:disabled{ opacity: 0.45; }
.ui-root .mk-chip:active, .ui-root .mk-seg2__btn:active, .ui-root .mk-tile:active{ background-color: var(--mk-pressed); }
.ui-root .mk-crate--dim{ opacity: 0.6; }
.ui-root .mk-crate--dim .mk-cbadge{ background-color: var(--mk-pressed); color: var(--mk-muted); }
.ui-root .mk-dot2--locked{ color: var(--mk-disabled); }

.ui-root .mk-bigsheet > .mk-handle-hit{ margin-top: -12px; }

/* Font roles and line boxes are shared; page USS supplies geometry only. */
.lb-root { -unity-font-definition: var(--font-body); -unity-text-outline-width: var(--ink-outline); }
.lb-root Button, .lb-root .ui-paper-button__caption, .ui-root .mk-btn, .ui-root .mk-tab, .ui-root .mk-rbtn, .ui-root .mk-h2, .ui-root .mk-h3, .ui-root .mk-number, .ui-root .mk-trophy, .ui-root .mk-namelink, .ui-root .mk-purse, .ui-root .mk-battle, .ui-root .mk-cbadge, .ui-root .mk-tab-label { -unity-font-definition: var(--font-display); -unity-font-style: normal; -unity-text-outline-width: var(--ink-outline-strong); }
.ui-root .mk-body, .ui-root .mk-secondary, .ui-root .mk-caption, .ui-root .mk-muted, .ui-root .mk-cap, .ui-root .mk-friend__status { -unity-font-definition: var(--font-body); -unity-font-style: normal; }
.ui-root .mk-label, .ui-root .mk-eyebrow, .ui-root .mk-chip, .ui-root .mk-friend__name, .ui-root .mk-friend__avatar, .ui-root .mk-hrow, .ui-root .mk-mark { -unity-font-definition: var(--font-label); -unity-font-style: normal; }
.ui-root .mk-body, .ui-root .mk-label { font-size: var(--type-body); }
.ui-root .mk-secondary, .ui-root .mk-chip { font-size: var(--type-secondary); }
.ui-root .mk-caption { font-size: var(--type-caption); }
.ui-root .mk-number { font-size: var(--type-number); }
/* Kalam's font metrics need about 1.6 em of vertical room. */
.ui-root .mk-body, .ui-root .mk-label, .ui-root .mk-friend__name { min-height: 28px; }
.ui-root .mk-secondary, .ui-root .mk-friend__status { min-height: 24px; }
.ui-root .mk-caption, .ui-root .mk-cap, .ui-root .mk-eyebrow { min-height: 24px; }
.ui-root .mk-h2, .ui-root .mk-h3, .ui-root .mk-number { min-height: 32px; }
.ui-root .mk-ellipsis, .ui-root .mk-friend__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex-shrink: 1; }
.ui-root .mk-namelink { min-height: 44px; min-width: 0; flex-shrink: 1; }
.ui-root .mk-namelink Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }
.ui-root .mk-purse { flex-shrink: 1; min-width: 44px; }
.ui-root .mk-purse > .mk-number { min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ui-root .mk-tab { min-height: 64px; margin-right: 8px; }
.ui-root .mk-tab--last { margin-right: 0; }
.ui-root .mk-panel-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 12px; align-items: center; justify-content: center; }
.ui-root .mk-panel { width: 340px; max-width: 100%; max-height: 80%; flex-shrink: 1; padding: 12px; border-width: 2px; border-bottom-width: 5px; border-color: var(--mk-ink); border-radius: 16px; background-color: var(--mk-sheet); color: var(--paper-ink); overflow: hidden; }
.ui-root .mk-panel__header { flex-direction: row; align-items: center; height: 44px; flex-shrink: 0; margin-bottom: 12px; }
.ui-root .mk-panel__header > .mk-h2 { flex-grow: 1; margin-right: 8px; margin-bottom: 0; }
.ui-root .mk-panel__close { width: 44px; height: 44px; flex-shrink: 0; padding: 0; font-size: var(--type-title); }
.ui-root .mk-panel__body { min-height: 0; flex-shrink: 1; overflow: hidden; }
.ui-root .mk-panel__body > Button { margin-top: 8px; }

.ui-root .mk-panel-list { flex-shrink: 1; min-height: 0; }
.ui-root .mk-panel-list Button { margin-bottom: 8px; }

.ui-root .mk-sheet > ScrollView > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > .mk-btn { margin-bottom: 8px; }

.ui-root .mk-tab-label { font-size: var(--type-caption); }
/* Workshop layout and local readability; shared skin and font assets belong to G4a. */
#page-workshop, #page-workshop > TemplateContainer, .lb-workshop { flex-grow: 1; min-height: 0; }
.ws-scroll { flex-grow: 1; min-height: 0; }
.ws-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: var(--space-3); }
.ws-stage-spacer { height: 220px; flex-shrink: 0; }
.ws-panel1-space { height: 136px; flex-shrink: 0; }
.ws-panel1 { position: absolute; left: 16px; right: 16px; flex-shrink: 0; }
.ws-panel2 { position: absolute; left: 0; right: 0; margin: var(--space-3) var(--space-4) 0; flex-shrink: 0; }
.ws-panel2-space { flex-shrink: 0; }
.ws-panel2-clip { position: absolute; left: 0; right: 0; overflow: hidden; }
.ws-presets { margin-bottom: var(--space-3); }
.ws-presets .ws-preset-tabs { flex-shrink: 0; }
.ws-preset { width: 44px; height: 44px; padding: 0; align-items: center; justify-content: center; }
.ws-preset-face { width: 32px; height: 32px; min-width: 32px; min-height: 32px; padding: 0; border-radius: 16px; -unity-text-align: middle-center; }
.ws-eyebrow { flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-text-align: middle-right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ws-browser-title { flex-grow: 1; }
.ws-roles-scroll { flex-shrink: 0; }
.ws-actionbar { margin-top: var(--space-3); }
#page-workshop .ws-cards { margin-right: 0; margin-bottom: 0; }
#page-workshop .ws-cards > .mk-tile { flex-grow: 0; flex-shrink: 0; min-width: 0; min-height: 0; padding: var(--space-1); }
.ws-art-clip { height: 64px; align-items: stretch; justify-content: center; }
.ws-art { flex-grow: 1; align-items: center; justify-content: center; }
.ws-name { width: 100%; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }
.ws-empty { width: 100%; padding: var(--space-3); }
.ws-item-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ws-item-content > * { margin-bottom: var(--space-3); }
.ws-item-art { height: 152px; flex-shrink: 0; align-items: center; justify-content: center; }
.ws-artbox { width: 180px; height: 152px; flex-shrink: 0; }
.ws-artbox .ws-art-clip { width: 100%; height: 100%; }
.ws-arr-prev { left: 0; }
.ws-arr-next { right: 0; }
.ws-variant-dot { -unity-text-align: middle-center; }
.ws-stat-label { white-space: normal; }
.ws-description { white-space: normal; }
.ws-item-status { white-space: normal; }
.ws-skin-scroll { flex-shrink: 0; min-height: 80px; }
.ws-skin-name { width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }
.ws-sheet-actions { flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.ws-sheet-actions > Button { width: 45%; }

/* G4a supplies the semantic faces at merge; existing font tokens are placeholders. */
.ui-root #page-workshop Label, .ui-root .ws-item-sheet Label {
    -unity-font-definition: var(--font-medium); /* token: --font-body */
    -unity-font-style: normal;
    -unity-text-outline-width: 0;
    font-size: 16px; /* token: --type-body */
    color: var(--paper-ink);
}
.ui-root #page-workshop Button, .ui-root .ws-item-sheet Button {
    -unity-font-definition: var(--font-bold); /* token: --font-display */
    -unity-font-style: normal;
    -unity-text-outline-width: 0;
    font-size: 16px; /* token: --type-body */
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-2) var(--space-3);
}
.ui-root #page-workshop .mk-h3, .ui-root .ws-item-sheet .ws-item-title {
    -unity-font-definition: var(--font-bold); /* token: --font-display */
    font-size: 24px; /* token: --type-title */
}
.ui-root #page-workshop .ws-name {
    -unity-font-definition: var(--font-semibold); /* token: --font-label */
    font-size: 14px; /* token: --type-secondary */
    min-height: 20px;
}
.ui-root #page-workshop .ws-eyebrow, .ui-root #page-workshop .ws-mark {
    -unity-font-definition: var(--font-semibold); /* token: --font-label */
    font-size: 13px; /* token: --type-caption */
    letter-spacing: 0;
}
.ui-root #page-workshop .ws-mark { top: 4px; right: 4px; padding: 0 var(--space-1); color: var(--mk-sheet); background-color: var(--mk-ink); }
.ui-root #page-workshop .ws-preset { padding: 0; }
.ui-root #page-workshop .ws-preset-face {
    -unity-font-definition: var(--font-bold); /* token: --font-display */
    font-size: 22px; /* token: --type-number */
    color: var(--paper-ink);
}
.ui-root #page-workshop .mk-chip--on, .ui-root #page-workshop .mk-seg2__btn--on { color: var(--mk-sheet); }
.ui-root #page-workshop .mk-seg2 { padding: var(--space-1); margin-bottom: 0; }
.ui-root #page-workshop .mk-seg2__btn { margin-right: var(--space-2); }
.ui-root #page-workshop #workshop-tab-suits { margin-right: 0; }
.ui-root #page-workshop .mk-toolbar { margin: var(--space-3) 0 var(--space-2); }
.ui-root #page-workshop .mk-toolbar > *, .ui-root #page-workshop .mk-roles > * { margin-right: var(--space-2); }
.ui-root #page-workshop .ws-browser-title { width: 100%; margin-bottom: var(--space-2); }
.ui-root #page-workshop .mk-roles { padding: var(--space-1) 0 var(--space-2); }
.ui-root #page-workshop .mk-banner { padding: var(--space-3); }
.ui-root #page-workshop .mk-tile { padding: var(--space-1); }
.ui-root #page-workshop .mk-tile > * { margin-bottom: var(--space-1); }
.ui-root .ws-item-sheet { padding: var(--space-3); }
.ui-root .ws-item-sheet > * { margin-bottom: var(--space-3); }
.ui-root .ws-item-sheet .ws-sheet-actions { margin-bottom: 0; }
.ui-root .ws-item-sheet .ws-sheet-actions > Button { width: 48%; }
.ui-root .ws-item-sheet .mk-skins > * { margin-right: var(--space-2); }
.ui-root .ws-item-sheet .mk-skin { width: 80px; min-height: 80px; padding: var(--space-1); }
.ui-root .ws-item-sheet .ws-skin-name, .ui-root .ws-item-sheet .ws-stat-label {
    -unity-font-definition: var(--font-semibold); /* token: --font-label */
    font-size: 14px; /* token: --type-secondary */
    letter-spacing: 0;
}
.ui-root .ws-item-sheet .ws-stat-row { flex-direction: column; align-items: stretch; margin-bottom: var(--space-3); }
.ws-stat-heading { flex-direction: row; align-items: center; margin-bottom: var(--space-1); }
.ui-root .ws-item-sheet .ws-stat-label { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: var(--space-2); white-space: normal; }
.ui-root .ws-item-sheet .ws-stat-value {
    -unity-font-definition: var(--font-bold); /* token: --font-display */
    font-size: 16px; /* token: --type-body */
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
.ui-root .ws-item-sheet .ws-stat-cells { width: 100%; margin-right: 0; flex-grow: 0; }
.ui-root .ws-item-sheet .ws-stat-cell {
    min-width: 12px;
    height: 20px;
    margin-right: var(--space-1);
    padding: 0;
    border-width: 2px;
    border-color: var(--mk-ink);
    font-size: 16px; /* token: --type-body */
    color: var(--mk-sheet);
    -unity-font-definition: var(--font-bold); /* token: --font-display */
}
.ui-root .ws-item-sheet .mk-cell--f { background-color: var(--mk-ink); }
.ui-root .ws-item-sheet .mk-cell--g { background-color: var(--confirm); }
.ui-root .ws-item-sheet .mk-cell--t { background-color: var(--mk-urgent); }
.ui-root .ws-item-sheet .mk-arr {
    padding: 0;
    font-size: 24px; /* token: --type-title */
}
.ui-root .ws-item-sheet .ws-variant-dot {
    font-size: 13px; /* token: --type-caption */
}
.g2-social-scroll { flex-grow: 1; min-height: 0; background-color: var(--clear); padding: var(--space-3); }
.ui-root .g2-social-card { margin-bottom: var(--space-3); }
.ui-root .g2-social-card > .mk-eyebrow { margin-bottom: var(--space-2); }
.g2-live-row { flex-direction: row; align-items: center; margin-bottom: var(--space-2); }
.ui-root .g2-live-player { flex-grow: 1; flex-basis: 0; min-width: 0; height: 80px; min-height: 80px; padding: var(--space-3); }
.g2-live-player Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.g2-player--p0 { border-left-color: var(--p0); border-left-width: 4px; }
.g2-player--p1 { border-left-color: var(--p1); border-left-width: 4px; }
.ui-root .g2-vs { width: 44px; height: 44px; min-width: 44px; padding: 0; border-radius: 22px; margin: 0 var(--space-2); background-color: var(--mk-urgent); color: var(--mk-sheet); }
.g2-online-player { min-height: 72px; }
.g2-online-player .mk-friend__body { flex-shrink: 1; }
.g2-online-player .mk-friend__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.g2-online-dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--mk-tap); }
.g2-offline .g2-online-dot, .g2-offline .mk-friend__dot { background-color: var(--mk-disabled); }
.ui-root .g2-urgent { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.g2-history-row { flex-direction: row; align-items: center; margin-top: var(--space-2); }
.ui-root .g2-result-badge { width: 24px; height: 24px; margin-right: var(--space-1); border-radius: 6px; border-width: 1px; border-color: var(--mk-ink); -unity-text-align: middle-center; }
.g2-gain { background-color: var(--mk-tap); color: var(--mk-sheet); }
.g2-loss { background-color: var(--mk-urgent); color: var(--mk-sheet); }
.ui-root .g2-history-name { flex-grow: 1; flex-shrink: 1; min-width: 0; border-width: 0; padding: 0; background-color: var(--clear); -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.g2-rr-delta { flex-shrink: 0; -unity-text-align: middle-right; }
.g2-positive { color: var(--mk-tap); }
.g2-negative { color: var(--mk-urgent); }

#page-guild, #page-guild > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-guild-state, .lb-guild-membership, .lb-guild-membership-content { flex-grow: 1; min-height: 0; }
.lb-guild-visitor { flex-grow: 1; min-height: 0; }
.lb-guild-search-anchor { margin-top: var(--space-2); margin-left: var(--space-3); margin-right: var(--space-3); }
.lb-guild-visitor--searched .lb-guild-search-anchor { margin-top: var(--space-2); }
.lb-guild-title { align-self: center; margin-bottom: var(--space-3); }
.lb-guild-search { flex-direction: row; align-items: center; }
.lb-guild-search TextField { flex-grow: 1; min-width: 0; margin-right: var(--space-2); }
.lb-guild-search .unity-base-field__label { display: none; }
.lb-guild-searchbtn, .lb-guild-filterbtn { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.lb-guild-filterbtn { margin-left: var(--space-2); }
.lb-guild-browse-toggle { width: 44px; min-height: 44px; align-self: center; margin-top: var(--space-2); }
.lb-guild-results { flex-grow: 1; min-height: 0; padding: var(--space-3); }
.lb-guild-card { margin-bottom: var(--space-3); }
.lb-guild-line { flex-direction: row; align-items: center; min-height: 44px; }
.lb-guild-row, .lb-guild-member { flex-direction: row; align-items: center; min-height: 72px; margin-top: var(--space-2); }
.lb-guild-row-text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: var(--space-2); margin-right: var(--space-2); }
.lb-guild-emblem { width: 40px; height: 40px; flex-shrink: 0; }
.lb-guild-header { margin-bottom: var(--space-2); }
.lb-guild-header .mk-meter { margin-top: var(--space-2); margin-bottom: var(--space-1); }
.lb-guild-header .mk-meter__fill { height: 100%; }
.lb-guild-home { flex-grow: 1; min-height: 0; padding: var(--space-3); }
.lb-guild-home-scroll { flex-grow: 1; min-height: 0; padding-bottom: var(--space-6); }
.lb-guild-post { padding-top: var(--space-2); padding-bottom: var(--space-2); }
.lb-guild-sort { min-height: 44px; }
.lb-guild-chat-button { position: absolute; right: 16px; bottom: 16px; min-width: 96px; min-height: 56px; flex-direction: row; align-items: center; justify-content: center; }
.lb-guild-sheet { flex-grow: 1; min-height: 0; padding: 0; }
.lb-guild-sheet .unity-base-field { margin-bottom: var(--space-3); min-height: 44px; }
.lb-guild-panel-members { max-height: 320px; min-height: 64px; flex-shrink: 1; margin-top: var(--space-3); margin-bottom: var(--space-3); }
.lb-guild-chat, .lb-guild-report { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lb-guild-chat > TemplateContainer { flex-grow: 1; min-height: 0; }
.lb-guild-chat-safe, .lb-guild-report-safe { flex-grow: 1; padding: var(--space-4); min-height: 0; }
.lb-guild-chat-list { flex-grow: 1; min-height: 0; }
.lb-guild-message { margin-bottom: var(--space-2); }
.lb-guild-compose { flex-direction: row; align-items: center; }
.lb-guild-compose TextField { flex-grow: 1; min-width: 0; margin-right: var(--space-2); }
.lb-guild-report-reasons { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--space-3); }
.lb-guild-reason { min-height: 44px; margin-right: var(--space-2); margin-bottom: var(--space-2); }
.lb-guild-report-details { min-height: 120px; margin-bottom: var(--space-3); }
.lb-guild-report-actions { flex-direction: row; justify-content: space-between; margin-top: var(--space-4); }

.lb-guild-row-text Label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mk-fixed-sheet, .mk-fixed-sheet .lb-guild-preview, .mk-fixed-sheet .lb-guild-preview > VisualElement { min-height: 0; flex-shrink: 1; overflow: hidden; }
.mk-fixed-sheet .lb-guild-header { flex-shrink: 0; }
.mk-fixed-sheet .mk-h2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.lb-guild-sheet > .mk-h2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 0; }

.lb-guild-row { min-height: 88px; }

#page-guild { padding: 0; }

/* Compact lobby components: shared 4/8 scale, parchment and hand ink. */
.ui-root #page-workshop Label, .ui-root #page-workshop Button, .ui-root #page-social Label, .ui-root #page-social Button,
.ui-root #page-guild Label, .ui-root #page-guild Button, .ui-root #page-guild TextField, .ui-root .ws-item-sheet Label, .ui-root .ws-item-sheet Button {
    -unity-font-definition: var(--font-hand);
    -unity-font-style: normal;
    -unity-text-outline-width: var(--lobby-ink-outline);
    -unity-text-outline-color: var(--paper-ink);
    color: var(--paper-ink);
    font-size: 14px;
}
.ui-root #page-workshop .mk-h3, .ui-root #page-guild .mk-h3, .ui-root .ws-item-sheet .ws-item-title {
    font-size: 24px; -unity-text-outline-width: var(--lobby-ink-outline-strong);
}
.ui-root #page-workshop .ui-browser-title { margin-bottom: var(--space-2); }
.ui-root #page-workshop .ui-filter-row { flex-direction: row; align-items: center; margin-bottom: var(--space-2); }
.ui-root #page-workshop .ui-filter-segments { flex-direction: row; flex-shrink: 0; }
.ui-root #page-workshop .ui-filter-hit {
    min-height: 44px; height: 44px; min-width: 44px; padding: 0; margin: 0;
    align-items: stretch; justify-content: center; flex-shrink: 0;
}
.ui-root #page-workshop .ui-filter-all { margin-left: var(--space-2); }
.ui-root #page-workshop .ui-filter-sort { margin-left: var(--space-2); }
.ui-root #page-workshop .ui-filter-row { justify-content: space-between; }
.ui-root #page-workshop .ui-filter-face {
    height: 36px; min-height: 36px; padding: 0 var(--space-3); margin: 0;
    border-radius: 18px; border-width: 2px; border-color: var(--paper-ink);
    background-color: var(--paper-light); font-size: 14px; -unity-text-align: middle-center;
}
.ui-root #page-workshop .ui-filter-chip--on .ui-filter-face { background-color: var(--paper-dark); }
.ui-root #page-workshop .mk-seg2__btn--on { background-color: var(--paper-dark); color: var(--paper-ink); }
.ui-root #page-workshop .ws-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: var(--space-6); }
.ui-root #page-workshop .ws-cards > .mk-tile { padding: var(--space-3); }
.ui-root #page-workshop .ws-name { font-size: 14px; min-height: 24px; }
.ui-root .ws-item-sheet .ws-stat-cell { margin-right: var(--space-1); }
.ui-root #page-social .g2-social-scroll { padding: var(--lobby-edge-inset) var(--lobby-edge-inset) var(--space-6); }
.ui-root #page-social .g2-live-row, .ui-root #page-social .g2-history-row { height: 64px; min-height: 64px; flex-shrink: 0; }
.ui-root #page-social .g2-live-player {
    height: 64px; min-height: 64px; padding: var(--space-2) var(--space-1);
    flex-direction: row; align-items: center; overflow: hidden;
}
.ui-root #page-social .ui-match-avatar {
    width: 40px; height: 40px; min-height: 40px; flex-shrink: 0;
    border-radius: 8px; background-color: var(--paper-dark); -unity-text-align: middle-center;
    margin-right: var(--space-1); font-size: 22px;
}
.ui-root #page-social .ui-match-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ui-root #page-social .ui-match-body Label { min-height: 20px; font-size: 14px; }
.ui-root #page-social .g2-vs {
    width: 48px; height: 44px; min-height: 44px; min-width: 48px; flex-shrink: 0;
    border-width: 0; padding: 0; margin: 0 var(--lobby-card-gap);
    background-color: var(--clear); justify-content: center; align-items: stretch;
}
.ui-root #page-social .ui-versus-face {
    height: 36px; min-height: 36px; border-radius: 8px; margin: 0; padding: 0; -unity-text-align: middle-center;
    border-width: 2px; border-color: var(--paper-ink); background-color: var(--paper-urgent);
    color: var(--paper-light); -unity-text-outline-color: var(--paper-light);
}
.ui-root #page-social .g2-history-row .mk-number { font-size: 14px; min-height: 24px; }
.ui-root #page-social .g2-history-name { min-height: 44px; }
.ui-root #page-guild .lb-guild-search-anchor { position: relative; margin: var(--space-4) var(--lobby-edge-inset) 0; flex-shrink: 0; }
.ui-root #page-guild .lb-guild-search TextField { min-height: 44px; padding: var(--space-2); }
.ui-root #page-guild .lb-guild-searchbtn, .ui-root #page-guild .lb-guild-filterbtn { padding: var(--space-2); }
.ui-root #page-guild .lb-guild-results { opacity: 0; padding: var(--space-4) var(--lobby-edge-inset) var(--space-6); }
.ui-root #page-guild .ui-filter-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ui-root #page-guild .ui-filter-bubble {
    position: absolute; width: 280px; max-width: 90%; padding: var(--lobby-panel-padding);
    border-width: 2px; border-bottom-width: 4px; border-color: var(--paper-ink);
    border-radius: 8px; background-color: var(--paper-light);
}
.ui-root #page-guild .ui-filter-tail {
    position: absolute; right: 16px; top: -8px; width: 12px; height: 12px; rotate: 45deg;
    background-color: var(--paper-light); border-left-width: 2px; border-top-width: 2px; border-color: var(--paper-ink);
}
.ui-root #page-guild .ui-filter-bubble .unity-base-field { min-height: 44px; margin: 0 0 var(--space-2); }
.ui-root #page-guild .ui-filter-bubble .unity-base-field__label { min-width: 0; font-size: 14px; }
.ui-root #page-guild .ui-filter-actions { flex-direction: row; justify-content: space-between; margin-top: var(--space-2); }
.ui-root #page-guild .ui-filter-actions Button { min-height: 44px; padding: var(--space-2) var(--space-3); }
.ui-lobby-list-end { height: 64px; flex-shrink: 0; }


.ui-root #page-guild .ui-filter-content { min-height: 0; flex-shrink: 1; }
