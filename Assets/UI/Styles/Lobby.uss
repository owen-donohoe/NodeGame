/*
    Node War - lobby stylesheet.

    The lobby's look, translated from lobby-prototype.html (v3.2). That file is
    the spec: sizes, colours and timings below are its values, not new ones.

    Lobby only. Colour, spacing, shape, motion and type come from the shared
    theme (Tokens.uss, through the panel's UnityDefaultRuntimeTheme.tss); the
    :root block below holds only what the lobby shell alone draws. Classes
    here are prefixed lb-, so they never collide with the shared ui- ones.

    Where the prototype uses CSS that USS does not have, the substitute is
    noted where it happens. Measured against 6000.5.9f1:
      box-shadow, filter: drop-shadow   unknown  -> a sibling element behind
      linear-/radial-gradient           unknown  -> flat fill, or vertex
                                                    colours in LobbyBackdrop
      filter: blur                      works    -> soft shadows
      gap, :last-child, :nth-child      absent   -> margins on each child
      @keyframes                        absent   -> class ping-pong from C#
      picking-mode                      not USS  -> set in UXML or C#

    Player colours are not used here. The red on a count badge is a
    notification colour, not player ownership, so it is --badge rather than a
    player token (player 0 is blue, player 1 red).
*/

:root {
    /* ---- stand-in scenery (CSS fakery in the prototype too). LobbyBackdrop
       reads the sky and ground through customStyle, so these hold literals. ---- */
    --backdrop-sky-0: rgb(247, 238, 219);
    --backdrop-sky-1: rgb(231, 213, 182);
    --backdrop-sky-2: rgb(210, 187, 149);
    --backdrop-ground-top: rgb(207, 184, 143);
    --backdrop-ground-bottom: rgb(188, 161, 115);
    --backdrop-prop-a: rgb(198, 168, 111);
    --backdrop-prop-b: rgb(185, 156, 107);
    --backdrop-prop-c: rgb(203, 177, 131);
    --backdrop-prop-d: rgb(194, 166, 114);
    --backdrop-prop-shadow: rgba(90, 70, 40, 0.28);

    /* ---- the tab bar's resting icon ink ---- */
    --tab-ink: rgb(169, 151, 124);

    /* ---- placeholder screens ---- */
    --placeholder-ink: rgb(90, 50, 140);
    --placeholder-fill: rgba(90, 50, 140, 0.12);
}

/* ===================================================================
   Type. Fredoka at the root; weights are separate font assets because
   -unity-font-style: bold would synthesise rather than use the real cut.
   =================================================================== */

.lb-root {
    flex-grow: 1;
    background-color: var(--surface);
    -unity-font-definition: var(--font-medium);
    color: var(--ink);
    font-size: 17px;
}

.lb-w500 { -unity-font-definition: var(--font-medium); -unity-font-style: normal; }
.lb-w600 { -unity-font-definition: var(--font-semibold); -unity-font-style: normal; }
.lb-w700 { -unity-font-definition: var(--font-bold); -unity-font-style: normal; }

/* Labels and buttons carry default padding/margins in the runtime theme. */
.lb-root Label {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.lb-reset-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ===================================================================
   Shadows. USS has no box-shadow, so a shadow is an absolutely placed
   sibling drawn first, offset down and right. Hard shadows are flat; the
   soft ones under floating controls use filter: blur.
   =================================================================== */

.lb-sticker {
    position: relative;
}

.lb-sticker__shadow {
    position: absolute;
    left: 3px;
    top: 4px;
    right: -3px;
    bottom: -4px;
    background-color: var(--shadow);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.lb-soft-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    bottom: -8px;
    background-color: var(--shadow-deep);
    filter: blur(11px);
}

/* ===================================================================
   Backdrop - stands in for the 3D lobby scene, as it does in the prototype.
   =================================================================== */

.lb-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lb-ground-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 25%;
    height: 3px;
    background-color: var(--edge);
}

.lb-prop {
    position: absolute;
}

.lb-prop > .lb-sticker__shadow {
    background-color: var(--backdrop-prop-shadow);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    top: 5px;
    bottom: -5px;
}

.lb-prop__body {
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

#prop-a { left: 20px; bottom: 158px; }
#prop-a > .lb-prop__body { width: 62px; height: 44px; background-color: var(--backdrop-prop-a); }
#prop-b { right: 22px; bottom: 184px; }
#prop-b > .lb-prop__body { width: 50px; height: 58px; background-color: var(--backdrop-prop-b); }
#prop-c { left: 8px; bottom: 90px; }
#prop-c > .lb-prop__body { width: 84px; height: 36px; background-color: var(--backdrop-prop-c); }
#prop-d { right: 4px; bottom: 76px; }
#prop-d > .lb-prop__body { width: 72px; height: 42px; background-color: var(--backdrop-prop-d); }

/* ===================================================================
   Shell. Persistent chrome sits OUTSIDE the page host, so it never moves
   with a page and the trophy bar is one element bound once.
   =================================================================== */

.lb-safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

.lb-page-host {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

/* The pages sit side by side in one track, which slides to show a page -
   a tab press scrolls rather than cuts. NavigationController sets each
   page to the host width and the track translate. */
.lb-page-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    transition-property: translate;
    transition-duration: var(--motion-page);
    transition-timing-function: ease-out;
}

/* Every tab page. LobbyPage adds the class. */
.lb-page {
    flex-grow: 1;
    flex-direction: column;
    padding: var(--space-4);
}

.lb-page-track > .lb-page {
    flex-shrink: 0;
    flex-grow: 0;
}

/* A page that places its own content must still clear the floating tab
   bar, which sits over the bottom of the page. */
.lb-page-track > .lb-page {
    padding-bottom: 96px;
}

/* Rebuilt pages place their own content edge to edge. */
.lb-page-track > .lb-page-flush {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ---- top bar ---- */

.lb-topbar {
    flex-direction: row;
    align-items: center;
    padding-top: 18px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    flex-shrink: 0;
}

.lb-purse {
    flex-direction: row;
    align-items: center;
    background-color: var(--glass);
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 8px;
    padding-right: 14px;
    margin-right: var(--space-2);
    color: var(--ink-inverse);
    font-size: 19px;
}

.lb-root .lb-purse__value {
    margin-left: 6px;
    color: var(--ink-inverse);
    font-size: 19px;
}

.lb-coin {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--action);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

/* The coin's square hole - a ::before in the prototype. */
.lb-coin__hole {
    width: 7px;
    height: 7px;
    background-color: var(--action-edge);
}

.lb-leaf {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background-color: var(--leaf);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--leaf-edge);
    border-right-color: var(--leaf-edge);
    border-top-color: var(--leaf-edge);
    border-bottom-color: var(--leaf-edge);
    border-top-left-radius: 3px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 12px;
    rotate: -12deg;
}

.lb-spacer {
    flex-grow: 1;
}

.lb-gear {
    width: 44px;
    height: 44px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: var(--glass);
    align-items: center;
    justify-content: center;
}

.lb-gear--history {
    margin-right: var(--space-2);
}

.lb-gear > .lb-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--ink-inverse);
}

/* ---- trophy strip ---- */

.lb-strip-wrap {
    margin-top: var(--space-3);
    margin-left: var(--space-4);
    margin-right: var(--space-4);
    flex-shrink: 0;
}

.lb-strip {
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    padding-top: var(--space-2);
    padding-bottom: var(--space-3);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
}

.lb-strip__row {
    flex-direction: row;
    align-items: center;
}

/* Only the name is the link to Profile, not the whole strip. */
.lb-name-btn {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 8px;
    margin-left: -4px;
    margin-right: var(--space-2);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    transition-property: scale, background-color;
    transition-duration: var(--motion-press), var(--motion-release);
}

.lb-name-btn:active {
    scale: 0.97 0.97;
    background-color: var(--press-tint);
}

.lb-root .lb-name-btn__text {
    font-size: 21px;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.lb-root .lb-name-btn__chev {
    font-size: 19px;
    color: var(--ink-mute);
    margin-left: 5px;
    translate: 0 -1px;
}

.lb-trophy {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
}

.lb-root .lb-trophy__count {
    font-size: 26px;
    color: var(--trophy-ink);
}

.lb-root .lb-trophy__max {
    margin-left: 3px;
    font-size: 15px;
    color: var(--ink-mute);
    margin-bottom: 4px;
}

.lb-track {
    margin-top: 3px;
    height: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-mid);
    border-right-width: var(--stroke-mid);
    border-top-width: var(--stroke-mid);
    border-bottom-width: var(--stroke-mid);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    overflow: hidden;
}

/* Flat: the prototype's gold -> gold-dk gradient has no USS equivalent. */
.lb-track__fill {
    height: 100%;
    width: 0;
    background-color: var(--action);
}

.lb-root .lb-arena {
    margin-top: 5px;
    font-size: 15px;
    color: var(--ink-mute);
}

/* ---- tab bar: thin floating capsule, icons only ---- */

.lb-tabbar-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    align-items: center;
}

.lb-tabbar-wrap {
    position: relative;
}

.lb-tabbar-wrap > .lb-soft-shadow {
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
}

.lb-tabbar {
    flex-direction: row;
    background-color: var(--glass-strong);
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.lb-tab {
    width: 44px;
    height: 44px;
    margin-right: 4px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale;
    transition-duration: var(--motion-release);
}

.lb-tab--last {
    margin-right: 0;
}

.lb-tab > .lb-icon {
    width: 19px;
    height: 19px;
    -unity-background-image-tint-color: var(--tab-ink);
    transition-property: -unity-background-image-tint-color;
    transition-duration: var(--motion-release);
}

.lb-tab--on {
    background-color: var(--action);
    scale: 1.06 1.06;
}

.lb-tab--on > .lb-icon {
    -unity-background-image-tint-color: var(--action-ink);
}

/* ===================================================================
   Icons. Vector images drawn by LobbyIcon; colour is the tint, so it
   transitions like any other style property.
   =================================================================== */

.lb-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
/* ===================================================================
   Lips. The prototype's 0 5px 0 box-shadow is a solid block behind.
   =================================================================== */

.lb-lip {
    position: relative;
}

.lb-lip__block {
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    bottom: -5px;
}


/* ===================================================================
   SHEET. Pinned to the bottom edge by construction, so it cannot render
   off-screen. Never positioned with top: and a computed value.
   =================================================================== */

.lb-sheet-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lb-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-sheet);
}

.lb-scrim--on {
    opacity: 1;
}

/*
    The sheet runs 48px past the bottom edge, with that much extra padding.
    Its slide overshoots (ease-out-back), and without the extension the
    overshoot lifted the sheet's bottom edge into view as a gap.
*/
.lb-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -48px;
    min-height: 46%;
    max-height: 88%;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: 0;
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-top-left-radius: var(--corner-sheet);
    border-top-right-radius: var(--corner-sheet);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-bottom: 72px;
    translate: 0 100%;
    transition-property: translate, min-height;
    transition-duration: var(--motion-sheet);
    transition-timing-function: ease-out-back;
}

.lb-sheet--open {
    translate: 0 0;
}

.lb-sheet--large {
    min-height: 88%;
}

.lb-handle-hit {
    height: 33px;
    align-items: center;
}

.lb-handle {
    width: 44px;
    height: 5px;
    margin-top: var(--space-3);
    border-top-left-radius: 2.5px;
    border-top-right-radius: 2.5px;
    border-bottom-left-radius: 2.5px;
    border-bottom-right-radius: 2.5px;
    background-color: var(--ink-mute);
}

.lb-root .lb-sheet__title {
    font-size: 27px;
    color: var(--ink);
    margin-bottom: var(--space-4);
    white-space: normal;
}

.lb-root .lb-sheet__note {
    font-size: 17px;
    color: var(--ink-mute);
    margin-bottom: 18px;
    white-space: normal;
}

.lb-view--hidden {
    display: none;
}

/* ---- segmented control ---- */

.lb-seg {
    flex-direction: row;
    background-color: var(--surface-sunk);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-left-radius: 29px;
    border-bottom-right-radius: 29px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 14px;
}

.lb-seg__btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 44px;
    margin-right: 4px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    font-size: 15px;
    color: var(--ink-mute);
    transition-property: background-color, color;
    transition-duration: var(--motion-release);
}

.lb-seg__btn--last {
    margin-right: 0;
}

/* The prototype's 0 2px 0 lift, as a bottom border. */
.lb-seg__btn--on {
    background-color: var(--surface-raised);
    color: var(--ink);
    border-bottom-width: var(--stroke-thin);
    border-bottom-color: var(--shadow-soft);
}

/* Looks disabled but still answers a tap, so it can say why. */
.lb-seg__btn--off {
    opacity: 0.45;
}

/* ---- big buttons ---- */

.lb-bigbtn-wrap {
    margin-bottom: var(--space-3);
}

.lb-bigbtn-wrap > .lb-lip__block {
    top: 4px;
    bottom: -4px;
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.lb-bigbtn {
    height: 60px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    font-size: 21px;
    transition-property: translate;
    transition-duration: var(--motion-press);
}

.lb-bigbtn:active {
    translate: 0 3px;
}

.lb-bigbtn--gold {
    background-color: var(--action);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
    color: var(--action-ink);
}

.lb-lip__block--gold {
    background-color: var(--action-edge);
}

.lb-bigbtn--green {
    background-color: var(--confirm);
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    color: var(--confirm-ink);
}

.lb-lip__block--green {
    background-color: var(--confirm-edge);
}

.lb-bigbtn--quiet {
    background-color: var(--surface-sunk);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    color: var(--ink);
}

/* ---- code box ---- */

.lb-codebox {
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-3);
    align-items: center;
}

.lb-root .lb-codebox__label {
    font-size: 15px;
    color: var(--ink-mute);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lb-root .lb-codebox__code {
    font-size: 38px;
    letter-spacing: 5px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* The prototype's .field. The editable region is the inner child. */
.lb-field {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: var(--space-3);
}

.lb-field > .unity-base-text-field__input {
    height: 60px;
    background-color: var(--surface-raised);
    background-image: none;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    -unity-font-definition: var(--font-semibold);
    font-size: 23px;
    color: var(--ink);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    --unity-selection-color: var(--action);
    -unity-text-align: middle-center;
}

.lb-field > .unity-label {
    display: none;
}

/* ===================================================================
   TOAST
   =================================================================== */

.lb-toast-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 196px;
    align-items: center;
}

.lb-root .lb-toast {
    max-width: 300px;
    background-color: var(--glass-toast);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    color: var(--ink-inverse);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 200ms;
}

.lb-root .lb-toast--on {
    opacity: 1;
    translate: 0 0;
}

/* ===================================================================
   PUSH PAGES (Settings, Match history). Full-screen, sliding in from the
   right over everything, including the chrome. Same mechanism as the
   sheet on the X axis: pinned by construction, never display-toggled, so
   the slide always runs.
   =================================================================== */

.lb-push {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--surface);
    translate: 100% 0;
    transition-property: translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.lb-push--open {
    translate: 0 0;
}

.lb-push__scroll {
    flex-grow: 1;
}

.lb-push__header {
    flex-direction: row;
    align-items: center;
    padding-top: var(--space-4);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.lb-root .lb-push__title {
    font-size: 30px;
    color: var(--ink);
    margin-left: var(--space-3);
}

/* The round back button shared by push pages and the Profile header. */
.lb-back {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.lb-back > .lb-icon {
    width: 19px;
    height: 19px;
    -unity-background-image-tint-color: var(--ink);
}

/* ===================================================================
   PLACEHOLDER - a screen standing in for a system nobody has designed,
   so a screenshot never quietly implies a feature. Purple on purpose:
   it is not a colour the lobby uses for anything real.
   =================================================================== */

.lb-placeholder {
    background-color: var(--placeholder-fill);
    border-width: 1px;
    border-color: var(--placeholder-ink);
    border-radius: var(--corner-sm);
    align-items: center;
    justify-content: center;
}

.lb-placeholder__label {
    font-size: 13px;
    color: var(--placeholder-ink);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ===================================================================
   EMPTY STATE - a system that has nothing to show yet.
   =================================================================== */

.lb-stub {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    padding-bottom: 130px;
}

.lb-stub__icon {
    width: 96px;
    height: 96px;
    background-color: var(--surface-sunk);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-lg);
    border-top-right-radius: var(--corner-lg);
    border-bottom-left-radius: var(--corner-lg);
    border-bottom-right-radius: var(--corner-lg);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
}

.lb-stub__icon > .lb-icon {
    width: 40px;
    height: 40px;
    -unity-background-image-tint-color: var(--ink-mute);
}

.lb-root .lb-stub__title {
    font-size: 26px;
    color: var(--ink);
    margin-bottom: var(--space-2);
    -unity-text-align: middle-center;
}

.lb-root .lb-stub__body {
    font-size: 17px;
    color: var(--ink-mute);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ===================================================================
   CONTEXT MENU. USS has no backdrop-filter, so no blur: dim with a scrim
   and lift the pressed element. The lift is what sells it.
   =================================================================== */

.lb-menu-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lb-menu {
    position: absolute;
    min-width: 200px;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    overflow: hidden;
    opacity: 0;
    scale: 0.9 0.9;
    transform-origin: top;
    transition-property: opacity, scale;
    transition-duration: 140ms, 180ms;
    transition-timing-function: ease-out, ease-out-back;
}

.lb-menu--on {
    opacity: 1;
    scale: 1 1;
}

.lb-menu__row {
    height: 52px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    font-size: 18px;
    color: var(--ink);
    -unity-text-align: middle-left;
    border-bottom-width: var(--stroke-thin);
    border-bottom-color: var(--rule);
}

.lb-menu__row--last {
    border-bottom-width: 0;
}

.lb-menu__row:active {
    background-color: var(--surface-sunk);
}

/* Applied to the long-pressed element while its menu is open. */
.lb-lifted {
    scale: 1.1 1.1;
}

/* ===================================================================
   SWITCH and SLIDER - the prototype's settings controls.
   =================================================================== */

.lb-switch {
    width: 52px;
    height: 31px;
    flex-shrink: 0;
    border-top-left-radius: 15.5px;
    border-top-right-radius: 15.5px;
    border-bottom-left-radius: 15.5px;
    border-bottom-right-radius: 15.5px;
    background-color: var(--off);
    transition-property: background-color;
    transition-duration: var(--motion-release);
}

.lb-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 25px;
    height: 25px;
    border-top-left-radius: 12.5px;
    border-top-right-radius: 12.5px;
    border-bottom-left-radius: 12.5px;
    border-bottom-right-radius: 12.5px;
    background-color: var(--ink-white);
    transition-property: translate;
    transition-duration: var(--motion-release);
}

.lb-switch--on {
    background-color: var(--confirm);
}

.lb-switch--on > .lb-switch__knob {
    translate: 21px 0;
}

/* UI Toolkit's Slider, restyled. The tracker and dragger are its children. */
.lb-slider {
    flex-grow: 1.4;
    flex-basis: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.lb-slider .unity-base-slider__drag-container {
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
}

.lb-slider .unity-base-slider__tracker {
    top: 6px;
    height: 10px;
    margin-top: 0;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.lb-slider .unity-base-slider__dragger {
    top: 0;
    width: 22px;
    height: 22px;
    margin-top: 0;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.lb-slider .unity-base-slider__dragger-border {
    display: none;
}

/* A sheet note that is reporting a problem, e.g. a name that will not save. */
.lb-root .lb-sheet__note--error {
    color: var(--badge);
}

/* A field whose text is prose rather than a code. */
.lb-field--left > .unity-base-text-field__input {
    -unity-text-align: middle-left;
}

/* The battle sheet's loadout line. Each part is a label, so the side that is
   short - fillable but not filled - can take the same orange as Home's
   loadout preview without colouring the whole sentence. */
.lb-loadout-line {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.lb-root .lb-loadout-line__part {
    font-size: 17px;
    color: var(--ink-mute);
    margin-right: 5px;
}

.lb-root .lb-loadout-line__part--short {
    color: var(--status-short-ink);
}
