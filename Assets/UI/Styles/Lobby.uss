/*
    Node War - lobby stylesheet.

    Lobby shell geometry. Visual roles follow docs/style-guide.md.

    Lobby only. Colour, spacing, shape, motion and type come from the shared
    theme (Tokens.uss, through the panel's UnityDefaultRuntimeTheme.tss); the
    :root block below holds only what the lobby shell alone draws. Classes
    here are prefixed lb-, so they never collide with the shared ui- ones.

    Where the prototype uses CSS that USS does not have, the substitute is
    noted where it happens. Measured against 6000.5.9f1:
      box-shadow, filter: drop-shadow   unknown  -> a sibling element behind
      linear-/radial-gradient           unknown  -> flat fill, or vertex
                                                    colours in LobbyBackdrop
      filter: blur                      works    -> soft shadows
      gap, :last-child, :nth-child      absent   -> margins on each child
      @keyframes                        absent   -> class ping-pong from C#
      picking-mode                      not USS  -> set in UXML or C#

    Player colours are not used here. The red on a count badge is a
    notification colour, not player ownership, so it is --badge rather than a
    player token (player 0 is blue, player 1 red).
*/

:root {
    /* ---- stand-in scenery (CSS fakery in the prototype too). LobbyBackdrop
       uses these roles when the runtime stage is unavailable. ---- */
    --backdrop-sky-0: var(--paper-light);
    --backdrop-sky-1: var(--paper-light);
    --backdrop-sky-2: var(--paper-light);
    --backdrop-ground-top: var(--paper-dark);
    --backdrop-ground-bottom: var(--paper-dark);
    --backdrop-prop-a: var(--paper-dark);
    --backdrop-prop-b: var(--paper-dark);
    --backdrop-prop-c: var(--paper-dark);
    --backdrop-prop-d: var(--paper-dark);
    --backdrop-prop-shadow: var(--scrim);

    /* ---- the tab bar's resting icon ink ---- */
    --tab-ink: var(--ink);

    /* ---- placeholder screens ---- */
    --placeholder-ink: var(--ink);
    --placeholder-fill: var(--paper-dark);
}

/* ===================================================================
   Root. Font roles, the label reset, the weights (.ui-w500/600/700), the
   reset button, shadows (.ui-sticker__shadow, .ui-soft-shadow), lip
   buttons (.ui-button), the sheet, the bar and the toast are shared
   components in Components.uss. The lobby adds only its own ground.
   =================================================================== */

.lb-root {
    background-color: var(--surface);
}

/* ===================================================================
   Backdrop - stands in for the 3D lobby scene, as it does in the prototype.
   =================================================================== */

.lb-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lb-ground-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 25%;
    height: 3px;
    background-color: var(--edge);
}

.lb-prop {
    position: absolute;
}

.lb-prop > .ui-sticker__shadow {
    background-color: var(--backdrop-prop-shadow);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    top: 5px;
    bottom: -5px;
}

.lb-prop__body {
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

#prop-a { left: 20px; bottom: 158px; }
#prop-a > .lb-prop__body { width: 62px; height: 44px; background-color: var(--backdrop-prop-a); }
#prop-b { right: 22px; bottom: 184px; }
#prop-b > .lb-prop__body { width: 50px; height: 58px; background-color: var(--backdrop-prop-b); }
#prop-c { left: 8px; bottom: 90px; }
#prop-c > .lb-prop__body { width: 84px; height: 36px; background-color: var(--backdrop-prop-c); }
#prop-d { right: 4px; bottom: 76px; }
#prop-d > .lb-prop__body { width: 72px; height: 42px; background-color: var(--backdrop-prop-d); }

/* ===================================================================
   Shell. Persistent chrome sits OUTSIDE the page host, so it never moves
   with a page and the trophy bar is one element bound once.
   =================================================================== */

.lb-safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

.lb-page-host {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

/* NavigationController translates edge-attached pages with LobbyMotion. */
.lb-page-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
}

/* Every tab page. LobbyPage adds the class. */
.lb-page {
    flex-grow: 1;
    flex-direction: column;
    padding: var(--space-4);
}

.lb-page-track > .lb-page {
    flex-shrink: 0;
    flex-grow: 0;
}

/* A page that places its own content must still clear the floating tab
   bar, which sits over the bottom of the page. */
.lb-page-track > .lb-page {
    padding-bottom: 96px;
}

/* Rebuilt pages place their own content edge to edge. */
.lb-page-track > .lb-page-flush {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.lb-tabbar-dock { position: absolute; left: 0; right: 0; bottom: 0; }
.ui-root .lb-pill-progress { background-color: var(--mk-action); border-width: 2px; border-color: var(--line-outer); border-radius: 26px; }
.ui-root .mk-tabs--sliding .mk-tab--on { background-color: var(--clear); }
/* ===================================================================
   Icons. Vector images drawn by LobbyIcon; colour is the tint, so it
   transitions like any other style property.
   =================================================================== */

.lb-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
/* ===================================================================
   SHEET. Pinned to the bottom edge by construction, so it cannot render
   off-screen. Never positioned with top: and a computed value.
   =================================================================== */

.lb-sheet-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ===================================================================
   TOAST
   =================================================================== */

.lb-toast-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 196px;
    align-items: center;
}

/* ===================================================================
   PUSH PAGES (Settings, Match history). Full-screen, sliding in from the
   right over everything, including the chrome. Same mechanism as the
   sheet on the X axis: pinned by construction, never display-toggled, so
   the slide always runs.
   =================================================================== */

.lb-push {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--mk-card);
    border-width: 2px; border-bottom-width: 7px; border-color: var(--line-outer); border-radius: 14px;
}

.lb-push__scroll {
    flex-grow: 1;
}

/* PlayPopup and MatchHistoryPage hide their inactive views with this. */
.lb-view--hidden {
    display: none;
}

.lb-push__header {
    flex-direction: row;
    align-items: center;
    padding-top: var(--space-4);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.lb-root .lb-push__title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-left: var(--space-3);
}

/* The round back button shared by push pages and the Profile header. */
.lb-back {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background-color: var(--surface);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.lb-back > .lb-icon {
    width: 19px;
    height: 19px;
    -unity-background-image-tint-color: var(--ink);
}

/* ===================================================================
   PLACEHOLDER - a screen standing in for a system nobody has designed,
   so a screenshot never quietly implies a feature. Purple on purpose:
   it is not a colour the lobby uses for anything real.
   =================================================================== */

.lb-placeholder {
    background-color: var(--placeholder-fill);
    border-width: 1px;
    border-color: var(--placeholder-ink);
    border-radius: var(--corner-sm);
    align-items: center;
    justify-content: center;
}

.lb-placeholder__label {
    font-size: var(--type-caption);
    color: var(--placeholder-ink);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ===================================================================
   EMPTY STATE - a system that has nothing to show yet.
   =================================================================== */

.lb-stub {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    padding-bottom: 96px;
}

.lb-stub__icon {
    width: 96px;
    height: 96px;
    background-color: var(--surface-sunk);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-lg);
    border-top-right-radius: var(--corner-lg);
    border-bottom-left-radius: var(--corner-lg);
    border-bottom-right-radius: var(--corner-lg);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
}

.lb-stub__icon > .lb-icon {
    width: 40px;
    height: 40px;
    -unity-background-image-tint-color: var(--ink);
}

.lb-root .lb-stub__title {
    font-size: var(--type-title);
    color: var(--ink);
    margin-bottom: var(--space-2);
    -unity-text-align: middle-center;
}

.lb-root .lb-stub__body {
    font-size: var(--type-body);
    color: var(--ink-mute);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ===================================================================
   CONTEXT MENU. USS has no backdrop-filter, so no blur: dim with a scrim
   and lift the pressed element. The lift is what sells it.
   =================================================================== */

.lb-menu-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Applied to the long-pressed element while its menu is open. */
.lb-lifted {
    scale: 1.1 1.1;
}

/* ===================================================================
   SWITCH and SLIDER - the prototype's settings controls.
   =================================================================== */

/* UI Toolkit's Slider, restyled. The tracker and dragger are its children. */
.lb-slider {
    flex-grow: 1.4;
    flex-basis: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.lb-slider .unity-base-slider__drag-container {
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
}

.lb-slider .unity-base-slider__tracker {
    top: 6px;
    height: 10px;
    margin-top: 0;
    background-color: var(--surface-track);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.lb-slider .unity-base-slider__dragger {
    top: 0;
    width: 22px;
    height: 22px;
    margin-top: 0;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.lb-slider .unity-base-slider__dragger-border {
    display: none;
}

/* A field whose text is prose rather than a code. */
.lb-field--left > .unity-base-text-field__input {
    -unity-text-align: middle-left;
}

/* The battle sheet's loadout line. Each part is a label, so the side that is
   short - fillable but not filled - can take the same orange as Home's
   loadout preview without colouring the whole sentence. */
.lb-loadout-line {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.lb-root .lb-loadout-line__part {
    font-size: var(--type-body);
    color: var(--ink-mute);
    margin-right: 8px;
}

.lb-root .lb-loadout-line__part--short {
    color: var(--status-short-ink);
}

/* ===================================================================
   Reduced motion - Settings > Accessibility.

   SettingsPage stores the preference and LobbyUIController puts this class
   on #lobby-root. Zeroing the motion tokens covers everything that animates
   through them, which is most of the lobby. The two durations written as
   literals - the push page above and the toast in Components.uss - are not
   reached that way, so they are named here explicitly. A transition added
   later with a literal duration will not be covered; use a token.

   Durations go to 0s rather than the transitions being dropped, so the end
   state is still the one the open/close classes describe. The element
   arrives; it just does not travel to get there.
   =================================================================== */

.lb-reduced-motion {
    --motion-press: 0s;
    --motion-release: 0s;
    --motion-page: 0s;
    --motion-sheet: 0s;
}

.lb-reduced-motion .lb-push {
    transition-duration: 0s;
}

/* #lobby-root carries ui-root as well, so this outranks .ui-root .ui-toast
   whichever order the two sheets happen to load in. */
.lb-reduced-motion.ui-root .ui-toast {
    transition-duration: 0s;
}
.lb-account-dialog__choice {
    flex-direction: column;
    height: auto;
    min-height: 60px;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    white-space: normal;
    align-items: center;
    justify-content: center;
}

.lb-root .lb-account-dialog__choice > Label {
    align-self: stretch;
    white-space: normal;
    -unity-text-align: middle-center;
}

.lb-root .lb-account-dialog__subtitle {
    margin-top: var(--space-2);
    font-size: var(--type-body);
    -unity-font-definition: var(--font-medium);
}
