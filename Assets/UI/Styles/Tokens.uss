/*
    Node War - design tokens.

    The single source of colour, spacing, shape, motion and type for every
    UI Toolkit panel in the game: the lobby and the match. It reaches both
    through UnityDefaultRuntimeTheme.tss, which both PanelSettings use, so no
    layout imports it and no page can forget to.

    TWO LAYERS, AND ONLY THE SECOND IS FOR USE.

    1. PALETTE (--pal-*). The raw colours, named for what they are. Nothing
       outside this file reads a palette token. Restyling the game is editing
       this block.
    2. MEANING (everything else). Named for the job - a surface, an ink, the
       main action, player 0. Stylesheets read these. Two jobs that happen to
       share a colour today get two tokens, so they can part later without a
       search through every page.

    Layout sizes (a card's width, a page's padding) are not tokens. They
    belong to the page that owns them. A token is for a value that must agree
    across screens.

    Tokens used by one page only live in that page's own :root block (the
    arena eras in Profile.uss, the stall in Shop.uss), not here.

    Custom properties may alias one another: --x: var(--y) resolves, for
    colours and lengths alike (probed in 6000.5.9f1). C# reading a token
    through customStyle should read a token holding a literal, not an alias.

    Two things are decisions rather than taste:

    PLAYER COLOURS copy the board. --pal-player-0 and --pal-player-1 are
    HUDManager.p0Color / p1Color as serialised on UI_Manager.prefab
    (0.4, 0.6, 1.0) and (1.0, 0.4, 0.4). The board is the source; change it
    there first, then here. Player 0 is blue, player 1 is red.

    OWNERSHIP IS NEVER COLOUR ALONE. A player colour travels with a shape or a
    label (.ui-mark in Components.uss). And red is not a warning colour on the
    match surface, because there red means player 1 - the notification red is
    --badge, not a player token.
*/

:root {
    /* ================= PALETTE ================= */
    --pal-tap: #1f7a6d;
    --pal-coin: #d9a441;
    --pal-tap-soft: rgba(31,122,109,0.14);
    --pal-umber-70: rgba(45,35,25,0.70);
    --pal-umber-45: rgba(45,35,25,0.45);
    --pal-umber-15: rgba(45,35,25,0.15);
    --pal-umber-50: rgba(45,35,25,0.50);
    --pal-era-1: #8aa06a;
    --pal-era-2: #7d8fa3;
    --pal-era-3: #b8734a;
    --pal-era-4: #8a6bb0;
    --pal-era-5: #c25b9a;

    /* paper, lightest to darkest */
    --pal-paper-50: #f4e9d5;
    --pal-paper-100: #ebdcc3;
    --pal-paper-200: #d7c3a5;
    --pal-paper-300: rgb(195, 170, 133);
    --pal-paper-500: rgb(150, 128, 95);
    --pal-paper-500-a22: rgba(150, 128, 95, 0.22);
    --pal-paper-500-a30: rgba(150, 128, 95, 0.3);

    /* umber: the ink, and the dark glass drawn over scenery */
    --pal-umber-900: #2d2319;
    --pal-umber-900-a55: rgba(30, 22, 15, 0.55);
    --pal-umber-900-a82: rgba(45, 35, 25, 0.82);
    --pal-umber-900-a92: rgba(45, 35, 25, 0.92);
    --pal-umber-900-a94: rgba(45, 35, 25, 0.94);
    --pal-umber-500: #2d2319;
    --pal-shadow-a25: rgba(90, 70, 40, 0.25);
    --pal-shadow-a30: rgba(90, 70, 40, 0.3);
    --pal-black-a35: rgba(0, 0, 0, 0.35);

    --pal-cream: rgb(250, 245, 235);
    --pal-white: rgb(255, 255, 255);
    --pal-clear: rgba(0, 0, 0, 0);

    /* gold */
    --pal-gold-400: #e0a526;
    --pal-gold-500: #e0a526;
    --pal-gold-700: rgb(168, 128, 28);
    --pal-gold-800: #8a6a14;
    --pal-gold-950: rgb(58, 42, 8);

    /* green */
    --pal-green-400: rgb(128, 147, 91);
    --pal-green-500: rgb(96, 117, 66);
    --pal-green-950: rgb(18, 51, 18);

    /* leaf - the second currency */
    --pal-leaf-500: rgb(201, 162, 39);
    --pal-leaf-800: rgb(126, 100, 19);

    /* signal red and its edge */
    --pal-red-500: #d2452f;
    --pal-red-800: rgb(125, 33, 26);

    /* stone - off and disabled */
    --pal-stone-400: rgb(160, 150, 135);
    --pal-stone-600: rgb(110, 101, 87);

    /* navy and orange - loadout state */
    --pal-navy-600: rgb(111, 128, 77);
    --pal-navy-50: #f4e9d5;
    --pal-orange-500: rgb(179, 124, 66);
    --pal-orange-700: rgb(178, 84, 32);

    /* players - copied from the board, see the header */
    --pal-player-0: rgb(102, 153, 255);
    --pal-player-0-edge: rgb(40, 72, 140);
    --pal-player-1: rgb(255, 102, 102);
    --pal-player-1-edge: rgb(140, 40, 40);
    --pal-neutral: rgb(154, 146, 133);
    --pal-neutral-edge: rgb(107, 100, 89);

    /* the match's dark glass over a lit board */
    --pal-night-a55: rgba(12, 11, 7, 0.55);
    --pal-night-a72: rgba(12, 11, 7, 0.72);
    --pal-cream-a28: rgba(247, 242, 231, 0.28);
    --pal-cream-a40: rgba(247, 242, 231, 0.4);
    --pal-cream-a60: rgba(247, 242, 231, 0.6);
    --pal-white-a30: rgba(255, 255, 255, 0.3);
    --pal-white-a60: rgba(255, 255, 255, 0.6);
    --pal-night-a60: rgba(18, 17, 10, 0.6);

    /* resource ring stops - a fixed urgency gradient (low to rich), unlike
       the player/tile palettes which name an identity */
    --pal-ring-critical: rgb(120, 24, 20);
    --pal-ring-low: rgb(196, 58, 48);
    --pal-ring-warn: rgb(226, 188, 42);
    --pal-ring-ok: rgb(178, 196, 64);
    --pal-ring-good: rgb(42, 122, 58);
    --pal-ring-rich: rgb(28, 110, 112);

    /* monogram tiles - ItemTint picks one by hashing the item's ID */
    --pal-tile-0: rgb(129, 147, 103);
    --pal-tile-1: rgb(167, 115, 77);
    --pal-tile-2: rgb(181, 155, 113);
    --pal-tile-3: rgb(127, 136, 81);
    --pal-tile-4: rgb(153, 114, 94);
    --pal-tile-5: rgb(147, 132, 110);
    --pal-tile-6: rgb(175, 140, 72);
    --pal-tile-7: rgb(156, 100, 76);

    /* ================= MEANING ================= */

    /* ---- paper drawing roles, shared by Painter2D and USS ---- */
    --paper-light: var(--pal-paper-50);
    --paper: var(--pal-paper-100);
    --paper-dark: var(--pal-paper-200);
    --paper-ink: var(--pal-umber-900);
    --paper-ink-width: 3px;
    --paper-shadow: var(--pal-shadow-a25);
    --paper-shadow-x: 2px;
    --paper-shadow-y: 4px;
    --paper-gold: var(--pal-gold-400);
    --paper-urgent: var(--pal-red-500);
    --paper-grain-opacity: 0.045;
    --paper-wobble: 0.8px;

    /* ---- surfaces ---- */
    --surface: var(--pal-paper-100);
    --surface-raised: var(--pal-paper-50);
    --surface-sunk: var(--pal-paper-200);
    --surface-track: var(--pal-paper-300);
    --edge: var(--pal-umber-900);
    --rule: var(--pal-paper-500-a30);
    --press-tint: var(--pal-paper-500-a22);
    --scrim: var(--pal-umber-50);
    --glass: var(--pal-umber-900-a82);
    --glass-strong: var(--pal-umber-900-a92);
    --glass-toast: var(--pal-umber-900-a94);
    --shadow: var(--pal-shadow-a30);
    --shadow-soft: var(--pal-shadow-a25);
    --shadow-deep: var(--pal-black-a35);

    /* ---- ink ---- */
    --ink: var(--pal-umber-900);
    --ink-mute: var(--pal-umber-70);
    --ink-inverse: var(--pal-cream);
    --ink-white: var(--pal-white);
    --clear: var(--pal-clear);

    /* ---- actions ---- */
    --action: var(--pal-gold-400);
    --action-press: var(--pal-gold-500);
    --action-edge: var(--pal-umber-900);
    --action-ink: var(--pal-umber-900);
    --confirm: var(--pal-tap);
    --confirm-edge: var(--pal-umber-900);
    --confirm-ink: var(--pal-umber-900);
    --off: var(--pal-stone-400);
    --off-edge: var(--pal-umber-900);

    /* ---- currency and progress ---- */
    --trophy-ink: var(--pal-umber-900);
    --leaf: var(--pal-leaf-500);
    --leaf-edge: var(--pal-umber-900);

    /* ---- notification. NOT a player colour. ---- */
    --badge: var(--pal-red-500);
    --badge-edge: var(--pal-umber-900);

    /* ---- status: a filled loadout slot, and one that could be filled but is not ---- */
    --status-ready: var(--pal-navy-600);
    --status-ready-ink: var(--pal-navy-50);
    --status-short: var(--pal-orange-500);
    --status-short-ink: var(--pal-umber-900);

    /* ---- players ---- */
    --p0: var(--pal-player-0);
    --p0-edge: var(--pal-player-0-edge);
    --p1: var(--pal-player-1);
    --p1-edge: var(--pal-player-1-edge);
    --unowned: var(--pal-neutral);
    --unowned-edge: var(--pal-neutral-edge);
    --mark-ink: var(--pal-umber-900);

    /* ---- the match: readouts floating over the board ---- */
    --hud-glass: var(--pal-night-a55);
    --hud-glass-strong: var(--pal-night-a72);
    --hud-edge: var(--pal-cream-a28);
    --hud-ink: var(--pal-cream);
    --hud-ink-mute: var(--pal-cream-a60);
    --hud-bar-past: var(--pal-cream-a40);
    --hud-ghost: var(--pal-white-a60);
    --hud-flash: var(--pal-white);
    --hud-dim: var(--pal-night-a60);

    /* ---- resource rings: colour follows the value, see ResourceRingMath. The
         ghost is the breach wall's, because a spend and a breach are the same
         gesture - the real value lands at once and white lags behind it. Same
         colour as --hud-ghost and pointed at the palette rather than at it,
         so the two can part later; C# reads this one. The pending white, what
         is on its way rather than what just left, is dimmer on purpose:
         leaving should read heavier than arriving. ---- */
    --resource-ring-critical: var(--pal-ring-critical);
    --resource-ring-low: var(--pal-ring-low);
    --resource-ring-warn: var(--pal-ring-warn);
    --resource-ring-ok: var(--pal-ring-ok);
    --resource-ring-good: var(--pal-ring-good);
    --resource-ring-rich: var(--pal-ring-rich);
    --resource-ring-ghost: var(--pal-white-a60);
    --resource-ring-pending: var(--pal-white-a30);

    /* ---- monogram tiles ---- */
    --tile-tint-0: var(--pal-tile-0);
    --tile-tint-1: var(--pal-tile-1);
    --tile-tint-2: var(--pal-tile-2);
    --tile-tint-3: var(--pal-tile-3);
    --tile-tint-4: var(--pal-tile-4);
    --tile-tint-5: var(--pal-tile-5);
    --tile-tint-6: var(--pal-tile-6);
    --tile-tint-7: var(--pal-tile-7);

    /* ---- spacing, 4pt base ---- */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --lobby-edge-inset: var(--space-4);
    --lobby-card-gap: var(--space-2);
    --lobby-panel-padding: var(--space-3);
    --font-hand: url("project://database/Assets/UI/Fonts/PatrickHand-Regular-SDF.asset");
    --lobby-ink-outline: 0px;
    --lobby-ink-outline-strong: 0px;

    /* ---- corners. No pill token: USS turns an oversized radius into an
       ellipse, so a pill is given exactly half its height where it is used. ---- */
    --corner-sm: 10px;
    --corner-md: 16px;
    --corner-lg: 24px;
    --corner-sheet: 28px;

    /* ---- strokes ---- */
    --stroke: 3px;
    --stroke-mid: 2.5px;
    --stroke-thin: 2px;

    /* ---- motion ---- */
    --motion-press: 60ms;
    --motion-release: 120ms;
    --motion-page: 250ms;
    --motion-sheet: 320ms;
    --motion-bob: 1700ms;

    /* ---- type. Display, handwritten labels and readable body copy. ---- */
    --font-display: url("project://database/Assets/UI/Fonts/LilitaOne-Regular-SDF.asset");
    --font-label: url("project://database/Assets/UI/Fonts/Kalam-Bold-SDF.asset");
    --font-body: url("project://database/Assets/UI/Fonts/Kalam-Regular-SDF.asset");
    --font-medium: var(--font-body);
    --font-semibold: var(--font-label);
    --font-bold: var(--font-label);

    /* Nothing is set smaller than --type-min. The prototypes go to 7px, which
       at a 390-wide reference is unreadable on a phone. */
    --type-min: 13px;
    --type-caption: 13px;
    --type-secondary: 14px;
    --type-body: 16px;
    --type-number: 22px;
    --type-heading: 22px;
    --type-title: 24px;
    --type-battle: 32px;
    /* Real font weights replace the synthetic text outlines. */
    --ink-outline: 0px;
    --ink-outline-strong: 0px;

    /* Minimum touch target. The panels scale to a 390-wide reference, so a
       unit is about one point on a phone. */
    --target-min: 44px;
    --mk-sheet: var(--pal-paper-50);
    --mk-card: var(--pal-paper-100);
    --mk-pressed: var(--pal-paper-200);
    --mk-track: var(--pal-paper-300);
    --mk-ink: var(--pal-umber-900);
    --mk-muted: var(--pal-umber-70);
    --mk-disabled: var(--pal-umber-45);
    --mk-hairline: var(--pal-umber-15);
    --mk-dark: var(--pal-umber-900-a92);
    --mk-scrim: var(--pal-umber-50);
    --mk-tap: var(--pal-tap);
    --mk-tap-soft: var(--pal-tap-soft);
    --mk-action: var(--pal-gold-500);
    --mk-urgent: var(--pal-red-500);
    --mk-trophy: var(--pal-gold-800);
    --mk-coin: var(--pal-coin);
    --mk-leaf: var(--pal-leaf-500);
    --era-1: var(--pal-era-1);
    --era-2: var(--pal-era-2);
    --era-3: var(--pal-era-3);
    --era-4: var(--pal-era-4);
    --era-5: var(--pal-era-5);
}

/* Approved panel language. Lobby scope preserves the shared match faces. */
.lb-root {
    --line-outer: #2d2319;
    --line-inner: #4d3d2d;
    --line-light: #c3aa85;
    --lip-panel: 5px;
    --lip-press: 3px;
    --edge-panel-bottom: 7px;
    --edge-press-bottom: 5px;
    --corner-sm: 10px;
    --corner-md: 12px;
    --corner-lg: 14px;
    --corner-sheet: 14px;
    --stroke: 2px;
    --stroke-mid: 2px;
    --paper-ink-width: 2px;
    --radius-panel: 14px;
    --radius-field: 12px;
    --radius-tile: 10px;
    --radius-button: 8px;
    --tracking: 0.6px;
    --font-body: url("project://database/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    --font-label: var(--font-display);
    --font-medium: var(--font-body);
    --font-semibold: var(--font-display);
    --font-hand: var(--font-body);
    --font-bold: var(--font-display);
    --lobby-edge-inset: 12px;
    --mk-scrim: rgba(30,22,15,0.25);
    --scrim: rgba(30,22,15,0.25);
    letter-spacing: var(--tracking);
}
/* Shop keeps its established faces and tracking while sharing lobby chrome. */
#page-shop {
    --corner-sm: 10px;
    --corner-md: 16px;
    --corner-lg: 24px;
    --corner-sheet: 28px;
    --stroke: 3px;
    --stroke-mid: 2.5px;
    --paper-ink-width: 3px;
    --font-body: url("project://database/Assets/UI/Fonts/Kalam-Regular-SDF.asset");
    --font-label: url("project://database/Assets/UI/Fonts/Kalam-Bold-SDF.asset");
    --font-bold: var(--font-label);
    --font-medium: var(--font-body);
    --font-semibold: var(--font-label);
    letter-spacing: 0;
}