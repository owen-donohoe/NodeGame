/*
    Workshop - the loadout picker.

    Colour, spacing and type come from Theme.uss custom properties; the tile
    tints and the .tile base come from there too. Numbers below are layout
    proportions and tile sizes, not design tokens.

    Slots and rows are Buttons, so they get :hover / :active / :disabled for
    free. They do not wear .btn - that class is for actions with a label, and
    these are surfaces with content inside them - so each resets the runtime
    theme's own button look explicitly.
*/

.workshop {
    flex-grow: 1;
    flex-direction: column;
}

/* ===================================================================
   Loadout card - fixed, always on screen while the list scrolls
   =================================================================== */

.workshop__loadout {
    flex-shrink: 0;
}

/*
    Suits granted to every player regardless of loadout. Above the slots and
    visually separated from them, because the point is that these cost no slot.
*/
.workshop__granted {
    flex-direction: row;
    align-items: center;
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-sm);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-ink);
}

.workshop__granted--hidden {
    display: none;
}

.workshop__granted-tiles {
    flex-direction: row;
    flex-shrink: 0;
}

.workshop__granted-text {
    flex-direction: column;
    flex-grow: 1;
    margin-left: var(--space-sm);
}

.workshop__group {
    margin-top: var(--space-sm);
}

.workshop__slots {
    flex-direction: row;
    margin-top: var(--space-xs);
}

/* ===================================================================
   Slots
   =================================================================== */

.workshop__slot {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    margin: 0;
    margin-right: var(--space-sm);
    padding: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    transition-property: scale;
    transition-duration: 0.12s;
}

.workshop__slot:active {
    scale: 0.94;
}

.workshop__slot-name {
    max-width: 72px;
    margin-top: var(--space-xs);
    -unity-text-align: middle-center;
    overflow: hidden;
}

.tile--slot {
    width: 60px;
    height: 60px;
}

.tile--slot .tile__monogram {
    font-size: var(--text-xl);
}

.tile--granted {
    width: 36px;
    height: 36px;
}

.tile--granted .tile__monogram {
    font-size: var(--text-md);
}

/* ===================================================================
   Tabs
   =================================================================== */

.workshop__tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: var(--space-md);
}

.workshop__tab {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-sm);
    font-size: var(--text-sm);
}

.workshop__tab--active {
    background-color: var(--primary);
    border-color: var(--border-ink);
    color: var(--ink-dark);
}

/*
    Only visible when the active tab's slots are all taken. Replaces the tap
    that GroupSelectionPanel silently ignores.
*/
.workshop__hint {
    flex-shrink: 0;
    margin-top: var(--space-sm);
    -unity-text-align: middle-center;
    color: var(--accent);
    -unity-font-style: bold;
}

.workshop__hint--hidden {
    display: none;
}

/* ===================================================================
   Item list
   =================================================================== */

.workshop__list {
    flex-grow: 1;
    margin-top: var(--space-sm);
}

.workshop__list--hidden {
    display: none;
}

.workshop__row {
    flex-direction: row;
    align-items: center;
    min-height: var(--touch-min);
    margin: 0;
    margin-bottom: var(--space-sm);
    padding: var(--space-sm);
    background-image: none;
    background-color: var(--card);
    border-width: var(--border-width);
    border-color: var(--border-ink);
    border-radius: var(--radius-md);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.workshop__row:hover {
    background-color: var(--card-raised);
}

.workshop__row:active {
    scale: 0.98;
}

/* Equipped items leave the list - they are visible in their slot instead. */
.workshop__row--hidden {
    display: none;
}

.workshop__row:disabled {
    opacity: 0.55;
    scale: 1;
}

.workshop__row--locked {
    background-color: rgba(72, 56, 40, 0.10);
}

.tile--row {
    width: 44px;
    height: 44px;
}

.tile--row .tile__monogram {
    font-size: var(--text-lg);
}

.workshop__row-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
}

.workshop__row-name {
    -unity-font-style: bold;
}

.workshop__row-subtitle {
    margin-top: 1px;
}

.workshop__row-status {
    flex-shrink: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--ink-muted);
}

/* Shown in place of the list when no definition assets are assigned. */
.workshop__empty {
    padding: var(--space-lg);
}
