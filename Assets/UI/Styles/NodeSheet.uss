/*
    Node sheet, after ingame-prototype.html.

    The sheet is the shared .ui-sheet - pinned to the bottom edge, sliding up
    when open - with the match's own look on top: no scrim, a hairline top
    edge, fixed heights so the board keeps the top of the screen, and a body
    that scrolls when a roster runs long.

    Colour and type come from the theme's tokens. No text below --type-min.
*/

.sheet {
    height: 262px;
    padding-left: 0;
    padding-right: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: var(--stroke-thin);
    border-top-color: var(--rule);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    translate: 0 101%;
    transition-property: translate, height;
    transition-duration: 300ms, 260ms;
    transition-timing-function: ease-out;
}

/* Written as a compound because a layout stylesheet outranks the theme:
   plain .ui-sheet--open would lose to the translate above. */
.sheet.ui-sheet--open {
    translate: 0 0;
}

.sheet--tall { height: 320px; }
.sheet--claim { height: 306px; }
.sheet--tall.sheet--claim { height: 364px; }

/* A reading, not a panel: an owned farm, mine or market. The claim strip
   adds the same 44px here as at the other two sizes. */
.sheet--compact { height: 224px; }
.sheet--compact.sheet--claim { height: 268px; }

/* ===================================================================
   Head
   =================================================================== */

.sheet__grab {
    height: 22px;
    flex-shrink: 0;
}

.sheet__handle {
    width: 36px;
    height: 4px;
    margin-top: 7px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.sheet__head {
    flex-direction: row;
    align-items: center;
    padding-left: var(--space-4);
    padding-right: var(--space-3);
    padding-bottom: var(--space-2);
    flex-shrink: 0;
}

.sheet__thumb {
    width: 42px;
    height: 42px;
    margin-right: var(--space-3);
}

.ui-root .sheet__thumb-letter {
    font-size: 18px;
}

.sheet__name {
    flex-grow: 1;
    flex-shrink: 1;
}

.ui-root .sheet__title {
    font-size: var(--type-heading);
    color: var(--ink);
}

.sheet__owner-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.ui-root .sheet__owner {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--ink-mute);
    margin-right: 5px;
}

.ui-root .sheet__mark-label {
    font-size: var(--type-min);
}

/* 44 for the thumb; the ring inside is drawn smaller. */
.sheet__close {
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.sheet__close-ring {
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
}

.sheet__close-ring > .lb-icon {
    width: 14px;
    height: 14px;
    -unity-background-image-tint-color: var(--ink-mute);
}

.sheet__close:active > .sheet__close-ring {
    background-color: var(--press-tint);
}

/* ===================================================================
   Claim tug of war
   =================================================================== */

.sheet__claim {
    display: none;
    margin-left: var(--space-4);
    margin-right: var(--space-4);
    margin-bottom: var(--space-2);
    flex-shrink: 0;
}

.sheet__claim--on {
    display: flex;
}

.sheet__claimbar {
    height: 12px;
    flex-direction: row;
    overflow: hidden;
    background-color: var(--surface-sunk);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--rule);
    border-right-color: var(--rule);
    border-top-color: var(--rule);
    border-bottom-color: var(--rule);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.sheet__claim-half {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
}

/* Player 1's half grows leftward from the centre. */
.sheet__claim-half--p1 {
    justify-content: flex-end;
}

.sheet__claim-fill {
    height: 100%;
    width: 0;
}

.sheet__claim-fill--p0 { background-color: var(--p0); }
.sheet__claim-fill--p1 { background-color: var(--p1); }

.sheet__claim-mid {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    translate: -1px 0;
    background-color: var(--ink);
    opacity: 0.35;
}

.sheet__claim-labels {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.ui-root .sheet__claim-label {
    flex-grow: 1;
    font-size: 12px;
    color: var(--ink-mute);
    -unity-text-align: middle-center;
}

/* ===================================================================
   Body and action bar
   =================================================================== */

.sheet__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.sheet__content {
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-bottom: var(--space-2);
}

.sheet__actions {
    flex-shrink: 0;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-top-width: 1px;
    border-top-color: var(--rule);
    background-color: var(--surface);
}

.sheet__actions--empty {
    display: none;
}

/* SafeAreaBinder writes the bottom inset here. */
.sheet__safe-bottom {
    flex-shrink: 0;
    background-color: var(--surface);
}

.sheet__hidden {
    display: none;
}

/* ===================================================================
   Resource text

   A resource-naming line, e.g. "Respawn costs 20 [food icon]": a
   wrapping flex row of plain Labels and inline LobbyIcons rather than
   a single Label, which cannot hold a VisualElement mid-text. Font
   size, colour and white-space all come from whichever text class the
   row itself carries (sheet__caption, sheet__microcap, ...) and
   inherit down to the Labels inside it. See NodeSheetContent.
   =================================================================== */

.sheet__resource-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.sheet__resource-icon {
    width: 15px;
    height: 15px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-background-image-tint-color: var(--ink-mute);
}

/* Inside the gold primary button the text is --action-ink, not --ink-mute. */
.sheet__resource-row--on-button .sheet__resource-icon {
    -unity-background-image-tint-color: var(--action-ink);
}

/* A short suit card's price turns the short-ink colour; its icons follow. */
.equip__card-sub--short .sheet__resource-icon {
    -unity-background-image-tint-color: var(--status-short-ink);
}

/* ===================================================================
   Shared text
   =================================================================== */

.ui-root .sheet__caption {
    font-size: 13px;
    color: var(--ink-mute);
    white-space: normal;
}

.ui-root .sheet__microcap {
    font-size: var(--type-min);
    color: var(--ink-mute);
    white-space: normal;
    margin-top: 4px;
}

.ui-root .sheet__label {
    font-size: var(--type-min);
    letter-spacing: 1px;
    color: var(--ink-mute);
    margin-bottom: 5px;
}

/* The one main control of a sheet. Shorter than the lobby's big button. */
.ui-root .sheet__primary {
    height: 50px;
    font-size: 16px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* ===================================================================
   Core
   =================================================================== */

.core__cols {
    flex-direction: row;
}

.core__left {
    width: 96px;
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.core__right {
    flex-grow: 1;
    flex-shrink: 1;
}

.core__stat {
    align-items: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: var(--surface-raised);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--rule);
    border-right-color: var(--rule);
    border-top-color: var(--rule);
    border-bottom-color: var(--rule);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.ui-root .core__stat-value {
    font-size: 27px;
    color: var(--ink);
}

.ui-root .core__stat-label {
    font-size: var(--type-min);
    letter-spacing: 1px;
    color: var(--ink-mute);
    margin-top: 3px;
}

.core__row {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
}

.core__row-text {
    flex-grow: 1;
}

.ui-root .core__row-name {
    font-size: 13px;
    color: var(--ink);
}

.ui-root .core__row-time {
    font-size: var(--type-min);
    color: var(--ink-mute);
}

/* The villager a single Respawn brings back. Marked in words, not colour. */
.ui-root .core__row-next {
    font-size: var(--type-min);
    color: var(--action-edge);
    margin-right: var(--space-2);
}

.core__track {
    width: 44px;
    height: 4px;
    overflow: hidden;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: var(--surface-sunk);
}

.core__track-fill {
    height: 100%;
    width: 0;
    background-color: var(--confirm);
}

/* ===================================================================
   Forge
   =================================================================== */

.forge__gauges {
    flex-direction: row;
    justify-content: center;
    padding-top: var(--space-1);
}

.forge__gauge {
    align-items: center;
    margin-left: 6px;
    margin-right: 6px;
}

/* The dial draws its arcs from these: color is the fill, the tint the track. */
.forge__dial {
    width: 66px;
    height: 66px;
    align-items: center;
    justify-content: center;
    color: var(--confirm);
    -unity-background-image-tint-color: var(--surface-sunk);
}

.ui-root .forge__dial-text {
    font-size: 15px;
    color: var(--ink);
}

.ui-root .forge__gauge-label {
    font-size: 12px;
    color: var(--ink-mute);
    margin-top: 4px;
}

.forge__stepper {
    flex-direction: row;
    align-items: center;
}

.ui-root .forge__step {
    width: 54px;
    height: 50px;
    font-size: 22px;
    color: var(--ink);
    background-color: var(--surface-raised);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--rule);
    border-right-color: var(--rule);
    border-top-color: var(--rule);
    border-bottom-color: var(--rule);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.forge__step:disabled {
    opacity: 0.33;
}

.forge__step-value {
    flex-grow: 1;
    align-items: center;
}

.ui-root .forge__step-number {
    font-size: 26px;
    color: var(--ink);
}

.ui-root .forge__step-label {
    font-size: var(--type-min);
    letter-spacing: 1px;
    color: var(--ink-mute);
}

/* ===================================================================
   Production (Farm, Mine, Market)
   =================================================================== */

.production__gauges {
    flex-direction: row;
    justify-content: center;
    padding-top: var(--space-1);
}

.production__gauge {
    align-items: center;
    margin-left: 6px;
    margin-right: 6px;
}

/* The dial draws its arcs from these: color is the fill, the tint the track. */
.production__dial {
    width: 66px;
    height: 66px;
    align-items: center;
    justify-content: center;
    color: var(--confirm);
    -unity-background-image-tint-color: var(--surface-sunk);
}

.ui-root .production__dial-text {
    font-size: 15px;
    color: var(--ink);
}

.ui-root .production__gauge-label {
    font-size: 12px;
    color: var(--ink-mute);
    margin-top: 4px;
}

/* ===================================================================
   Equip
   =================================================================== */

.equip__rail {
    flex-direction: row;
    padding-bottom: 3px;
}

.ui-root .equip__card {
    width: 80px;
    margin-right: var(--space-2);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--rule);
    border-right-color: var(--rule);
    border-top-color: var(--rule);
    border-bottom-color: var(--rule);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
    transition-property: scale;
    transition-duration: var(--motion-press);
}

.equip__card:active {
    scale: 0.95 0.95;
}

.equip__card--dim {
    opacity: 0.45;
}

.ui-root .equip__card--picked {
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--action-edge);
    border-right-color: var(--action-edge);
    border-top-color: var(--action-edge);
    border-bottom-color: var(--action-edge);
}

.equip__card-tile {
    height: 28px;
    margin-bottom: 4px;
}

.ui-root .equip__card-letter {
    font-size: 13px;
}

.ui-root .equip__card-name {
    font-size: 12px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.ui-root .equip__card-sub {
    font-size: var(--type-min);
    color: var(--ink-mute);
    -unity-text-align: middle-center;
}

.ui-root .equip__card-sub--short {
    color: var(--status-short-ink);
}

.equip__units {
    flex-direction: row;
    flex-wrap: wrap;
}

.ui-root .equip__unit {
    min-height: 44px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke-thin);
    border-right-width: var(--stroke-thin);
    border-top-width: var(--stroke-thin);
    border-bottom-width: var(--stroke-thin);
    border-left-color: var(--rule);
    border-right-color: var(--rule);
    border-top-color: var(--rule);
    border-bottom-color: var(--rule);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.ui-root .equip__unit--picked {
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
}

.ui-root .equip__unit-name {
    font-size: 12px;
    color: var(--ink);
}

.ui-root .equip__unit-state {
    font-size: var(--type-min);
    color: var(--ink-mute);
}

.equip__gap {
    height: var(--space-3);
}
