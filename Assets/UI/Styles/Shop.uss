/*
    Shop, after lobby-prototype.html.

    Label rules that set margin or padding are written .lb-root .lb-x, so they
    outrank the label reset in Lobby.uss.

    Differences from the prototype, all USS limits: the stall's drop-shadow is
    a sibling block under the awning and the counter rather than one shadow
    of the whole silhouette, and the list pills' 0 3px 0 lip is a bottom
    border.
*/

:root {
    --shop-awning-red: rgb(200, 106, 92);
    --shop-awning-cream: rgb(242, 230, 210);
    --shop-stall-wood: rgb(156, 108, 60);
    --shop-stall-counter: rgb(181, 129, 74);
}

.lb-shop {
    flex-grow: 1;
}

/* Clears the floating tab bar at the bottom of the scroll. */
.lb-shop .unity-scroll-view__content-container {
    padding-bottom: 150px;
}

/* ---- the stall ---- */

.lb-stallzone {
    height: 322px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.lb-stall {
    width: 180px;
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.lb-stall__awning-wrap > .lb-sticker__shadow {
    left: 4px;
    top: 7px;
    right: -4px;
    bottom: -7px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.lb-stall__awning {
    flex-direction: row;
    width: 180px;
    height: 36px;
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    overflow: hidden;
}

.lb-stripe {
    flex-grow: 1;
    flex-basis: 0;
}

.lb-stripe--red { background-color: var(--shop-awning-red); }
.lb-stripe--cream { background-color: var(--shop-awning-cream); }

.lb-stall__post {
    position: absolute;
    top: 36px;
    width: 10px;
    height: 56px;
    background-color: var(--shop-stall-wood);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
}

.lb-stall__post--left { left: 4px; }
.lb-stall__post--right { right: 4px; }

.lb-stall__keeper {
    position: absolute;
    left: 70px;
    top: 44px;
    width: 38px;
    height: 50px;
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.lb-stall__counter-wrap {
    margin-top: 56px;
}

.lb-stall__counter-wrap > .lb-sticker__shadow {
    left: 4px;
    top: 7px;
    right: -4px;
    bottom: -7px;
}

.lb-stall__counter {
    width: 180px;
    height: 52px;
    background-color: var(--shop-stall-counter);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ---- wares ---- */

.lb-wares {
    flex-grow: 1;
}

.lb-ware-wrap {
    margin-bottom: var(--space-3);
}

.lb-ware-wrap--last {
    margin-bottom: 0;
}

.lb-ware-wrap > .lb-sticker__shadow {
    background-color: rgba(90, 70, 40, 0.28);
}

.lb-ware {
    height: 74px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
    transition-property: scale, translate;
    transition-duration: var(--motion-press);
    transition-timing-function: ease-in;
}

.lb-ware:active {
    scale: 0.96 0.96;
    translate: 0 2px;
}

.lb-ware > .lb-icon {
    width: 26px;
    height: 26px;
    margin-right: var(--space-3);
    -unity-background-image-tint-color: var(--ink);
}

.lb-root .lb-ware__name {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.lb-root .lb-ware__cost {
    font-size: 14px;
    color: var(--ink-mute);
    -unity-text-align: middle-left;
}

/* ---- the quiet list ---- */

.lb-shop-tail {
    min-height: 520px;
    background-color: var(--surface);
    border-top-width: var(--stroke);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-color: var(--edge);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-left-radius: var(--corner-sheet);
    border-top-right-radius: var(--corner-sheet);
    padding-top: var(--space-5);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.lb-root .lb-sechead {
    font-size: 23px;
    color: var(--ink);
    margin-bottom: var(--space-3);
}

.lb-root .lb-sechead--spaced {
    margin-top: var(--space-5);
}

.lb-row-wrap {
    margin-bottom: var(--space-3);
}

.lb-row-wrap > .lb-sticker__shadow {
    background-color: var(--shadow-soft);
}

.lb-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    background-color: var(--surface-raised);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-md);
    border-top-right-radius: var(--corner-md);
    border-bottom-left-radius: var(--corner-md);
    border-bottom-right-radius: var(--corner-md);
}

.lb-rowthumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: var(--space-3);
    align-items: center;
    justify-content: center;
    background-color: var(--surface-sunk);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: var(--stroke);
    border-left-color: var(--edge);
    border-right-color: var(--edge);
    border-top-color: var(--edge);
    border-bottom-color: var(--edge);
    border-top-left-radius: var(--corner-sm);
    border-top-right-radius: var(--corner-sm);
    border-bottom-left-radius: var(--corner-sm);
    border-bottom-right-radius: var(--corner-sm);
}

.lb-rowthumb > .lb-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--ink);
}

.lb-rowthumb--large {
    width: 84px;
    height: 84px;
    margin-right: var(--space-4);
}

.lb-rowthumb--large > .lb-icon {
    width: 34px;
    height: 34px;
}

.lb-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--space-3);
}

.lb-root .lb-row__title {
    font-size: 19px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.lb-root .lb-row__sub {
    font-size: 15px;
    color: var(--ink-mute);
    white-space: normal;
    -unity-text-align: middle-left;
}

.lb-pill {
    flex-shrink: 0;
    height: 44px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    background-color: var(--confirm);
    border-left-width: var(--stroke);
    border-right-width: var(--stroke);
    border-top-width: var(--stroke);
    border-bottom-width: 6px;
    border-left-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-top-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    font-size: 17px;
    color: var(--confirm-ink);
}

.lb-pill:active {
    translate: 0 2px;
}

/* ---- purchase sheet ---- */

.lb-shop-item__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.lb-root .lb-shop-item__note {
    flex-shrink: 1;
    margin-bottom: 0;
}
