<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The match log library, built as a plain .NET library from the exact same
    files Unity compiles through Assets/Scripts/MatchLog/NodeWar.MatchLog.asmdef.

    The source does not live here and must not be copied here. There is one
    copy of the truth, in Assets/, and two toolchains compiling it.
  -->

  <PropertyGroup>
    <!--
      Match Unity's API Compatibility Level so a net8.0-only API fails here,
      before Unity ever sees the commit. C# 9 is pinned by Directory.Build.props.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NodeWar.MatchLog</AssemblyName>
    <RootNamespace>NodeWar.MatchLog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Recursive glob, so a new file added to MatchLog/ is picked up by both
      build systems automatically. There is no second file list to keep in sync.
    -->
    <Compile Include="../../Assets/Scripts/MatchLog/**/*.cs"
             Link="MatchLog/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NodeWar.Simulation/NodeWar.Simulation.csproj" />
  </ItemGroup>

</Project>
