<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The camera POV and sprite-order maths, run without Unity.

    ViewSide is the UnityEngine-free half of the four-way POV system: side/yaw
    conversion, the sort axis, ResolveViewer and the height/depth sort keys.
    Everything that needs a Camera or a SpriteRenderer (CameraController,
    SpriteDepthSorter) stays in Unity and is only type-checked here.

    Like NodeWar.Lobby.Tests, the tests live in this folder and the source is
    linked from Assets/, because Unity has no way to run these against
    Assembly-CSharp.

    Run it directly:
      dotnet test dotnet/NodeWar.View.Tests
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NodeWar.View.Tests</AssemblyName>
    <RootNamespace>NodeWar.View.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ViewSideTests.cs" />
    <Compile Include="EmoteRateLimiterTests.cs" />
    <Compile Include="../../Assets/Scripts/Game/Core/EmoteRateLimiter.cs"
             Link="Core/EmoteRateLimiter.cs" />
    <Compile Include="../../Assets/Scripts/Game/View/ViewSide.cs"
             Link="View/ViewSide.cs" />

    <!-- Indicator zones, edge clamping and clustering: the maths half of the
         in-match indicators, with the camera and UI Toolkit left in Unity. -->
    <Compile Include="IndicatorPlacementTests.cs" />
    <Compile Include="../../Assets/Scripts/Game/View/IndicatorPlacement.cs"
             Link="View/IndicatorPlacement.cs" />

    <Compile Include="RouteRevealTests.cs" />
    <Compile Include="../../Assets/Scripts/Game/View/RouteReveal.cs"
             Link="View/RouteReveal.cs" />

    <!-- The resource ring's value -> segments/colour maths; the UI Toolkit
         drawing that reads it stays in Unity. -->
    <Compile Include="ResourceRingMathTests.cs" />
    <Compile Include="../../Assets/UI/Scripts/Gameplay/ResourceRingMath.cs"
             Link="Gameplay/ResourceRingMath.cs" />

    <!-- Which production jobs a player has in flight for one resource, read
         back off the simulation's own timers. Needs the simulation itself,
         which is UnityEngine-free too, so it comes in as a project reference
         rather than more linked files. -->
    <Compile Include="ResourceProductionTests.cs" />
    <Compile Include="../../Assets/UI/Scripts/Gameplay/ResourceProduction.cs"
             Link="Gameplay/ResourceProduction.cs" />
    <Compile Include="../../Assets/UI/Scripts/Gameplay/ResourceKind.cs"
             Link="Gameplay/ResourceKind.cs" />

    <!-- The card-to-board cross-fade's two opacity curves. The drag that
         reads them needs a Camera and a panel and stays in Unity. -->
    <Compile Include="DraftHandoverTests.cs" />
    <Compile Include="../../Assets/UI/Scripts/Gameplay/DraftHandover.cs"
             Link="Gameplay/DraftHandover.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NodeWar.Simulation/NodeWar.Simulation.csproj" />

    <!-- Same NUnit 3.x pin as the other test projects, for the same reason. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>
