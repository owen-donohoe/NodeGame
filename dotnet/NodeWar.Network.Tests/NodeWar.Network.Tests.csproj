<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LockstepCore under a simulated network.

    LockstepRunner is a MonoBehaviour, so Unity's test runner cannot drive it
    against a bad link and nothing could until its logic was lifted into
    LockstepCore, which takes its clocks and transport from the caller. This
    project links that core and runs two of them against an in-memory link that
    can lose, burst-lose, duplicate, reorder, delay and cut packets, then holds
    the result to a reference run on a perfect link.

    The sources are linked from Assets/, not copied, like the other projects.
    The tests themselves live here: Unity can never run them.

    In NodeWar.sln but never in the determinism receipt; see
    NodeWar.Lobby.Tests for why.

    Run it directly:
      dotnet test dotnet/NodeWar.Network.Tests
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NodeWar.Network.Tests</AssemblyName>
    <RootNamespace>NodeWar.Network.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SimLink.cs" />
    <Compile Include="HarnessPeer.cs" />
    <Compile Include="LockstepScenario.cs" />
    <Compile Include="CleanLinkTests.cs" />
    <Compile Include="LossTests.cs" />
    <Compile Include="OutageTests.cs" />
    <Compile Include="LatencyTests.cs" />
    <Compile Include="LostTickTests.cs" />

    <Compile Include="../../Assets/Scripts/Game/Network/LockstepCore.cs"
             Link="Network/LockstepCore.cs" />
    <Compile Include="../../Assets/Scripts/Game/Network/InputSerializer.cs"
             Link="Network/InputSerializer.cs" />
    <Compile Include="../../Assets/Scripts/Game/Input/InputBuffer.cs"
             Link="Input/InputBuffer.cs" />
    <Compile Include="../../Assets/Scripts/Game/Core/EmoteType.cs"
             Link="Core/EmoteType.cs" />
    <Compile Include="../../Assets/Scripts/Backend/Shared/ProtocolVersion.cs"
             Link="Backend/ProtocolVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NunitXml.TestLogger" Version="3.1.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NodeWar.Simulation/NodeWar.Simulation.csproj" />
  </ItemGroup>

</Project>
